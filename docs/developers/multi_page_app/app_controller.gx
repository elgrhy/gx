helper "app_controller" {
  can_do: ["app_management", "navigation_control", "mvvm_coordination", "async_operations"]
  
  remember {
    status = "initializing"
    current_page = "home"
    page_stack = []
    navigation_history = []
    
    // MVVM Architecture State
    models = {
      user_model: null,
      analytics_model: null,
      settings_model: null
    }
    
    viewmodels = {
      home_viewmodel: null,
      profile_viewmodel: null,
      analytics_viewmodel: null,
      settings_viewmodel: null
    }
    
    pages = {
      home: null,
      user_profile: null,
      data_analytics: null,
      settings: null
    }
    
    // Async Operations
    async_operations = {}
    pending_operations = []
    
    // Performance Metrics
    performance_metrics = {
      page_load_times: {},
      memory_usage: 0,
      brain_cycles: 0,
      async_operations_completed: 0
    }
  }

  receive {
    from "navigation_request" as "nav_request" {
      type: "page_navigation"
      bind: memory.navigation_request
      on_receive: brain.handle_navigation
    }
    
    from "async_operation_complete" as "async_result" {
      type: "operation_result"
      bind: memory.async_result
      on_receive: brain.handle_async_completion
    }
    
    from "model_update" as "model_data" {
      type: "data_update"
      bind: memory.model_update
      on_receive: brain.update_viewmodels
    }
    
    from "ui_interaction" as "user_action" {
      type: "user_input"
      bind: memory.user_action
      on_receive: brain.handle_user_interaction
    }
  }

  brain {
    plan {
      if memory.status == "initializing" {
        plan = { action: "initialize_app" }
      } else if memory.navigation_request {
        plan = { action: "handle_navigation_request" }
      } else if memory.async_result {
        plan = { action: "process_async_result" }
      } else if memory.model_update {
        plan = { action: "update_viewmodels" }
      } else if memory.user_action {
        plan = { action: "handle_user_interaction" }
      } else {
        plan = { action: "monitor_app_state" }
      }
    }

    execute {
      if plan.action == "initialize_app" {
        // Initialize MVVM Architecture
        initialize_models()
        initialize_viewmodels()
        initialize_pages()
        
        // Start async initialization
        start_async_initialization()
        
        memory.status = "ready"
        memory.current_page = "home"
        
        log("🧠 Multi-Page App Controller initialized with MVVM architecture")
      } else if plan.action == "handle_navigation_request" {
        request = memory.navigation_request
        target_page = request.page
        navigation_data = request.data || {}
        
        // Preserve current page state
        preserve_page_state(memory.current_page)
        
        // Navigate to new page
        navigate_to_page(target_page, navigation_data)
        
        // Update navigation history
        memory.navigation_history.push({
          from: memory.current_page,
          to: target_page,
          timestamp: get_timestamp(),
          data: navigation_data
        })
        
        memory.current_page = target_page
        memory.navigation_request = null
        
      } else if plan.action == "process_async_result" {
        result = memory.async_result
        
        // Update performance metrics
        memory.performance_metrics.async_operations_completed += 1
        
        // Route result to appropriate viewmodel
        route_async_result_to_viewmodel(result)
        
        // Update UI if needed
        update_current_page_ui()
        
        memory.async_result = null
        
      } else if plan.action == "update_viewmodels" {
        update = memory.model_update
        
        // Update all viewmodels with new model data
        for each viewmodel_name in Object.keys(memory.viewmodels) {
          viewmodel = memory.viewmodels[viewmodel_name]
          if viewmodel && viewmodel.update_from_model {
            viewmodel.update_from_model(update)
          }
        }
        
        // Trigger UI updates
        trigger_ui_updates()
        
        memory.model_update = null
        
      } else if plan.action == "handle_user_interaction" {
        action = memory.user_action
        
        // Route user interaction to current page viewmodel
        current_viewmodel = memory.viewmodels[get_current_viewmodel_name()]
        if current_viewmodel && current_viewmodel.handle_user_interaction {
          current_viewmodel.handle_user_interaction(action)
        }
        
        memory.user_action = null
        
      } else if plan.action == "monitor_app_state" {
        // Monitor application performance
        monitor_performance()
        
        // Check for pending async operations
        check_pending_operations()
        
        // Update performance metrics
        memory.performance_metrics.brain_cycles += 1
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      // Emit app state updates
      emit "app_state_update" {
        current_page: memory.current_page,
        status: memory.status,
        performance: memory.performance_metrics
      }
      
      // Emit navigation events
      if memory.navigation_history.length > 0 {
        last_navigation = memory.navigation_history[memory.navigation_history.length - 1]
        emit "navigation_complete" {
          from: last_navigation.from,
          to: last_navigation.to,
          timestamp: last_navigation.timestamp
        }
      }
    }
  }

  // MVVM Architecture Methods
  recipe "initialize_models" {
    needs: none
    gives: models_initialized
    
    brain {
      plan { action: "create_models" }
      execute {
        // Initialize data models
        memory.models.user_model = create_user_model()
        memory.models.analytics_model = create_analytics_model()
        memory.models.settings_model = create_settings_model()
        
        models_initialized = true
      }
    }
  }

  recipe "initialize_viewmodels" {
    needs: models
    gives: viewmodels_initialized
    
    brain {
      plan { action: "create_viewmodels" }
      execute {
        // Initialize view models with data binding
        memory.viewmodels.home_viewmodel = create_home_viewmodel(memory.models)
        memory.viewmodels.profile_viewmodel = create_profile_viewmodel(memory.models.user_model)
        memory.viewmodels.analytics_viewmodel = create_analytics_viewmodel(memory.models.analytics_model)
        memory.viewmodels.settings_viewmodel = create_settings_viewmodel(memory.models.settings_model)
        
        viewmodels_initialized = true
      }
    }
  }

  recipe "initialize_pages" {
    needs: viewmodels
    gives: pages_initialized
    
    brain {
      plan { action: "create_pages" }
      execute {
        // Initialize UI pages with viewmodels
        memory.pages.home = create_home_page(memory.viewmodels.home_viewmodel)
        memory.pages.user_profile = create_profile_page(memory.viewmodels.profile_viewmodel)
        memory.pages.data_analytics = create_analytics_page(memory.viewmodels.analytics_viewmodel)
        memory.pages.settings = create_settings_page(memory.viewmodels.settings_viewmodel)
        
        pages_initialized = true
      }
    }
  }

  // Async Operations
  recipe "start_async_initialization" {
    needs: none
    gives: initialization_complete
    
    brain {
      plan { action: "start_async_init" }
      execute {
        // Start parallel async operations
        operations = [
          async_load_initial_data(),
          async_initialize_ui_components(),
          async_setup_network_connections()
        ]
        
        // Wait for all operations to complete
        await_all_operations(operations)
        
        initialization_complete = true
      }
    }
  }

  recipe "async_load_initial_data" {
    needs: none
    gives: data_loaded
    
    brain {
      plan { action: "load_data_async" }
      execute {
        // Simulate async data loading
        await sleep(500)
        
        // Load user data
        user_data = fetch_user_data()
        memory.models.user_model.update_data(user_data)
        
        // Load analytics data
        analytics_data = fetch_analytics_data()
        memory.models.analytics_model.update_data(analytics_data)
        
        // Load settings
        settings_data = fetch_settings_data()
        memory.models.settings_model.update_data(settings_data)
        
        data_loaded = true
      }
    }
  }

  // Navigation Methods
  recipe "navigate_to_page" {
    needs: page_name, navigation_data
    gives: navigation_complete
    
    brain {
      plan { action: "perform_navigation" }
      execute {
        // Validate page exists
        if !memory.pages[page_name] {
          throw "Page not found: " + page_name
        }
        
        // Update current page
        memory.current_page = page_name
        
        // Initialize page with data
        page = memory.pages[page_name]
        page.initialize(navigation_data)
        
        // Update viewmodel
        viewmodel_name = get_viewmodel_for_page(page_name)
        viewmodel = memory.viewmodels[viewmodel_name]
        if viewmodel {
          viewmodel.on_page_activated(navigation_data)
        }
        
        navigation_complete = true
      }
    }
  }

  recipe "preserve_page_state" {
    needs: page_name
    gives: state_preserved
    
    brain {
      plan { action: "save_page_state" }
      execute {
        if memory.pages[page_name] {
          page = memory.pages[page_name]
          state = page.get_current_state()
          
          // Store state in navigation stack
          memory.page_stack.push({
            page: page_name,
            state: state,
            timestamp: get_timestamp()
          })
        }
        
        state_preserved = true
      }
    }
  }

  // Performance Monitoring
  recipe "monitor_performance" {
    needs: none
    gives: performance_updated
    
    brain {
      plan { action: "update_performance" }
      execute {
        // Update memory usage
        memory.performance_metrics.memory_usage = get_memory_usage()
        
        // Update page load times
        current_page = memory.current_page
        if !memory.performance_metrics.page_load_times[current_page] {
          memory.performance_metrics.page_load_times[current_page] = get_timestamp()
        }
        
        performance_updated = true
      }
    }
  }

  // Utility Methods
  recipe "get_current_viewmodel_name" {
    needs: none
    gives: viewmodel_name
    
    brain {
      plan { action: "get_viewmodel" }
      execute {
        page_to_viewmodel = {
          "home": "home_viewmodel",
          "user_profile": "profile_viewmodel",
          "data_analytics": "analytics_viewmodel",
          "settings": "settings_viewmodel"
        }
        
        viewmodel_name = page_to_viewmodel[memory.current_page] || "home_viewmodel"
      }
    }
  }

  recipe "trigger_ui_updates" {
    needs: none
    gives: ui_updated
    
    brain {
      plan { action: "update_ui" }
      execute {
        // Trigger UI updates for current page
        current_page = memory.pages[memory.current_page]
        if current_page && current_page.update_ui {
          current_page.update_ui()
        }
        
        ui_updated = true
      }
    }
  }
} 