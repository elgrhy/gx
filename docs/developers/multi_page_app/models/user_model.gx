helper "user_model" {
  can_do: ["user_management", "data_persistence", "user_validation"]
  
  remember {
    users = {}
    current_user = null
    user_preferences = {}
    user_sessions = {}
    
    // Data validation rules
    validation_rules = {
      username: { min_length: 3, max_length: 50, pattern: "^[a-zA-Z0-9_]+$" },
      email: { pattern: "^[^@]+@[^@]+\\.[^@]+$" },
      password: { min_length: 8, require_special: true }
    }
    
    // Statistics
    model_stats = {
      total_users: 0,
      active_users: 0,
      last_updated: null
    }
  }

  receive {
    from "user_creation" as "new_user" {
      type: "create_user"
      bind: memory.new_user_data
      on_receive: brain.create_user
    }
    
    from "user_update" as "user_changes" {
      type: "update_user"
      bind: memory.user_update_data
      on_receive: brain.update_user
    }
    
    from "user_deletion" as "delete_request" {
      type: "delete_user"
      bind: memory.delete_request
      on_receive: brain.delete_user
    }
    
    from "user_query" as "query_request" {
      type: "query_user"
      bind: memory.query_request
      on_receive: brain.query_user
    }
  }

  brain {
    plan {
      if memory.new_user_data {
        plan = { action: "create_new_user" }
      } else if memory.user_update_data {
        plan = { action: "update_existing_user" }
      } else if memory.delete_request {
        plan = { action: "delete_user_record" }
      } else if memory.query_request {
        plan = { action: "query_user_data" }
      } else {
        plan = { action: "maintain_user_data" }
      }
    }

    execute {
      if plan.action == "create_new_user" {
        user_data = memory.new_user_data
        
        // Validate user data
        if validate_user_data(user_data) {
          // Generate unique user ID
          user_id = generate_user_id()
          
          // Create user record
          user_record = {
            id: user_id,
            username: user_data.username,
            email: user_data.email,
            created_at: get_timestamp(),
            updated_at: get_timestamp(),
            status: "active",
            preferences: user_data.preferences || {}
          }
          
          // Store user
          memory.users[user_id] = user_record
          memory.model_stats.total_users += 1
          memory.model_stats.last_updated = get_timestamp()
          
          // Emit user created event
          emit "user_created" { user: user_record }
        } else {
          emit "user_creation_failed" { 
            reason: "validation_failed",
            errors: get_validation_errors(user_data)
          }
        }
        
        memory.new_user_data = null
        
      } else if plan.action == "update_existing_user" {
        update_data = memory.user_update_data
        user_id = update_data.user_id
        
        if memory.users[user_id] {
          // Update user record
          user_record = memory.users[user_id]
          
          // Apply updates
          for each field in Object.keys(update_data.changes) {
            if field != "id" && field != "created_at" {
              user_record[field] = update_data.changes[field]
            }
          }
          
          user_record.updated_at = get_timestamp()
          memory.users[user_id] = user_record
          memory.model_stats.last_updated = get_timestamp()
          
          // Emit user updated event
          emit "user_updated" { user: user_record }
        } else {
          emit "user_update_failed" { 
            reason: "user_not_found",
            user_id: user_id
          }
        }
        
        memory.user_update_data = null
        
      } else if plan.action == "delete_user_record" {
        user_id = memory.delete_request.user_id
        
        if memory.users[user_id] {
          // Soft delete - mark as inactive
          user_record = memory.users[user_id]
          user_record.status = "inactive"
          user_record.updated_at = get_timestamp()
          
          memory.users[user_id] = user_record
          memory.model_stats.total_users -= 1
          memory.model_stats.last_updated = get_timestamp()
          
          // Emit user deleted event
          emit "user_deleted" { user_id: user_id }
        } else {
          emit "user_deletion_failed" { 
            reason: "user_not_found",
            user_id: user_id
          }
        }
        
        memory.delete_request = null
        
      } else if plan.action == "query_user_data" {
        query = memory.query_request
        
        if query.user_id {
          // Query by ID
          user_record = memory.users[query.user_id]
          if user_record {
            emit "user_query_result" { user: user_record }
          } else {
            emit "user_query_failed" { 
              reason: "user_not_found",
              user_id: query.user_id
            }
          }
        } else if query.username {
          // Query by username
          found_user = null
          for each user_id in Object.keys(memory.users) {
            user = memory.users[user_id]
            if user.username == query.username {
              found_user = user
              break
            }
          }
          
          if found_user {
            emit "user_query_result" { user: found_user }
          } else {
            emit "user_query_failed" { 
              reason: "user_not_found",
              username: query.username
            }
          }
        }
        
        memory.query_request = null
        
      } else if plan.action == "maintain_user_data" {
        // Update statistics
        active_count = 0
        for each user_id in Object.keys(memory.users) {
          user = memory.users[user_id]
          if user.status == "active" {
            active_count += 1
          }
        }
        
        memory.model_stats.active_users = active_count
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      // Emit model statistics
      emit "user_model_stats" {
        total_users: memory.model_stats.total_users,
        active_users: memory.model_stats.active_users,
        last_updated: memory.model_stats.last_updated
      }
    }
  }

  // Data validation methods
  recipe "validate_user_data" {
    needs: user_data
    gives: is_valid
    
    brain {
      plan { action: "validate_user" }
      execute {
        is_valid = true
        errors = []
        
        // Validate username
        if user_data.username {
          username_rule = memory.validation_rules.username
          if user_data.username.length < username_rule.min_length {
            errors.push("Username too short")
            is_valid = false
          }
          if user_data.username.length > username_rule.max_length {
            errors.push("Username too long")
            is_valid = false
          }
          if !user_data.username.match(username_rule.pattern) {
            errors.push("Username contains invalid characters")
            is_valid = false
          }
        } else {
          errors.push("Username is required")
          is_valid = false
        }
        
        // Validate email
        if user_data.email {
          email_rule = memory.validation_rules.email
          if !user_data.email.match(email_rule.pattern) {
            errors.push("Invalid email format")
            is_valid = false
          }
        } else {
          errors.push("Email is required")
          is_valid = false
        }
        
        // Validate password
        if user_data.password {
          password_rule = memory.validation_rules.password
          if user_data.password.length < password_rule.min_length {
            errors.push("Password too short")
            is_valid = false
          }
          if password_rule.require_special && !user_data.password.match(/[!@#$%^&*]/) {
            errors.push("Password must contain special characters")
            is_valid = false
          }
        }
        
        memory.validation_errors = errors
      }
    }
  }

  recipe "generate_user_id" {
    needs: none
    gives: user_id
    
    brain {
      plan { action: "generate_id" }
      execute {
        // Generate unique user ID
        timestamp = get_timestamp()
        random_part = Math.random().toString(36).substring(2, 8)
        user_id = "user_" + timestamp + "_" + random_part
      }
    }
  }

  recipe "get_validation_errors" {
    needs: user_data
    gives: errors
    
    brain {
      plan { action: "get_errors" }
      execute {
        // Return validation errors for the given user data
        errors = memory.validation_errors || []
      }
    }
  }
} 