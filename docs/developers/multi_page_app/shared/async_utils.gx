helper "async_utils" {
  can_do: ["async_operations", "promise_management", "parallel_processing", "concurrency_control"]
  
  remember {
    // Active async operations
    active_operations = {}
    operation_counter = 0
    
    // Promise management
    pending_promises = {}
    promise_results = {}
    
    // Parallel processing
    parallel_tasks = {}
    task_results = {}
    
    // Concurrency control
    max_concurrent_operations = 10
    operation_queue = []
    
    // Performance tracking
    async_stats = {
      total_operations: 0,
      completed_operations: 0,
      failed_operations: 0,
      average_completion_time: 0
    }
  }

  receive {
    from "async_operation_request" as "operation_req" {
      type: "start_operation"
      bind: memory.operation_request
      on_receive: brain.start_async_operation
    }
    
    from "promise_request" as "promise_req" {
      type: "create_promise"
      bind: memory.promise_request
      on_receive: brain.create_promise
    }
    
    from "parallel_task_request" as "task_req" {
      type: "start_parallel_tasks"
      bind: memory.task_request
      on_receive: brain.start_parallel_tasks
    }
    
    from "operation_complete" as "completion" {
      type: "operation_finished"
      bind: memory.operation_completion
      on_receive: brain.handle_operation_completion
    }
  }

  brain {
    plan {
      if memory.operation_request {
        plan = { action: "start_async_operation" }
      } else if memory.promise_request {
        plan = { action: "create_promise" }
      } else if memory.task_request {
        plan = { action: "start_parallel_tasks" }
      } else if memory.operation_completion {
        plan = { action: "handle_completion" }
      } else {
        plan = { action: "maintain_async_utils" }
      }
    }

    execute {
      if plan.action == "start_async_operation" {
        request = memory.operation_request
        operation_type = request.type
        operation_data = request.data || {}
        
        // Generate operation ID
        operation_id = generate_operation_id()
        
        // Check concurrency limits
        if Object.keys(memory.active_operations).length >= memory.max_concurrent_operations {
          // Queue operation
          memory.operation_queue.push({
            id: operation_id,
            type: operation_type,
            data: operation_data,
            timestamp: get_timestamp()
          })
        } else {
          // Start operation immediately
          start_operation(operation_id, operation_type, operation_data)
        }
        
        memory.async_stats.total_operations += 1
        memory.operation_request = null
        
      } else if plan.action == "create_promise" {
        request = memory.promise_request
        promise_data = request.data
        promise_type = request.type || "standard"
        
        // Create promise
        promise_id = create_promise(promise_data, promise_type)
        
        // Emit promise created
        emit "promise_created" { 
          promise_id: promise_id,
          type: promise_type,
          timestamp: get_timestamp()
        }
        
        memory.promise_request = null
        
      } else if plan.action == "start_parallel_tasks" {
        request = memory.task_request
        tasks = request.tasks
        task_group_id = request.group_id || generate_task_group_id()
        
        // Start parallel tasks
        task_ids = start_parallel_task_group(tasks, task_group_id)
        
        // Emit parallel tasks started
        emit "parallel_tasks_started" { 
          group_id: task_group_id,
          task_ids: task_ids,
          total_tasks: tasks.length,
          timestamp: get_timestamp()
        }
        
        memory.task_request = null
        
      } else if plan.action == "handle_completion" {
        completion = memory.operation_completion
        operation_id = completion.operation_id
        result = completion.result
        success = completion.success
        
        // Handle operation completion
        handle_operation_completion(operation_id, result, success)
        
        // Process queued operations
        process_operation_queue()
        
        memory.operation_completion = null
        
      } else if plan.action == "maintain_async_utils" {
        // Clean up completed operations
        cleanup_completed_operations()
        
        // Update performance statistics
        update_async_statistics()
        
        // Monitor queue health
        monitor_queue_health()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      // Emit async statistics
      emit "async_stats_update" {
        total_operations: memory.async_stats.total_operations,
        completed_operations: memory.async_stats.completed_operations,
        failed_operations: memory.async_stats.failed_operations,
        average_completion_time: memory.async_stats.average_completion_time,
        active_operations: Object.keys(memory.active_operations).length,
        queued_operations: memory.operation_queue.length
      }
    }
  }

  // Async operation management
  recipe "start_operation" {
    needs: operation_id, operation_type, operation_data
    gives: operation_started
    
    brain {
      plan { action: "start_op" }
      execute {
        // Create operation record
        operation = {
          id: operation_id,
          type: operation_type,
          data: operation_data,
          start_time: get_timestamp(),
          status: "running"
        }
        
        memory.active_operations[operation_id] = operation
        
        // Execute operation based on type
        if operation_type == "data_fetch" {
          execute_data_fetch_operation(operation_id, operation_data)
        } else if operation_type == "file_operation" {
          execute_file_operation(operation_id, operation_data)
        } else if operation_type == "network_request" {
          execute_network_request(operation_id, operation_data)
        } else if operation_type == "computation" {
          execute_computation_operation(operation_id, operation_data)
        }
        
        operation_started = true
      }
    }
  }

  recipe "execute_data_fetch_operation" {
    needs: operation_id, operation_data
    gives: fetch_started
    
    brain {
      plan { action: "fetch_data" }
      execute {
        // Simulate async data fetch
        data_source = operation_data.source
        query_params = operation_data.params || {}
        
        // Start background fetch
        fetch_result = start_background_fetch(data_source, query_params)
        
        // Store operation context
        memory.active_operations[operation_id].fetch_result = fetch_result
        
        fetch_started = true
      }
    }
  }

  recipe "execute_file_operation" {
    needs: operation_id, operation_data
    gives: file_op_started
    
    brain {
      plan { action: "file_operation" }
      execute {
        file_path = operation_data.path
        operation_type = operation_data.operation || "read"
        
        if operation_type == "read" {
          // Start async file read
          file_content = start_async_file_read(file_path)
          memory.active_operations[operation_id].file_content = file_content
        } else if operation_type == "write" {
          // Start async file write
          content = operation_data.content
          write_result = start_async_file_write(file_path, content)
          memory.active_operations[operation_id].write_result = write_result
        }
        
        file_op_started = true
      }
    }
  }

  recipe "execute_network_request" {
    needs: operation_id, operation_data
    gives: network_request_started
    
    brain {
      plan { action: "network_request" }
      execute {
        url = operation_data.url
        method = operation_data.method || "GET"
        headers = operation_data.headers || {}
        body = operation_data.body
        
        // Start async network request
        request_result = start_async_network_request(url, method, headers, body)
        memory.active_operations[operation_id].request_result = request_result
        
        network_request_started = true
      }
    }
  }

  recipe "execute_computation_operation" {
    needs: operation_id, operation_data
    gives: computation_started
    
    brain {
      plan { action: "computation" }
      execute {
        computation_type = operation_data.type
        input_data = operation_data.input
        
        // Start background computation
        computation_result = start_background_computation(computation_type, input_data)
        memory.active_operations[operation_id].computation_result = computation_result
        
        computation_started = true
      }
    }
  }

  // Promise management
  recipe "create_promise" {
    needs: promise_data, promise_type
    gives: promise_id
    
    brain {
      plan { action: "create_promise" }
      execute {
        promise_id = generate_promise_id()
        
        // Create promise object
        promise = {
          id: promise_id,
          type: promise_type,
          data: promise_data,
          status: "pending",
          created_at: get_timestamp(),
          result: null,
          error: null
        }
        
        memory.pending_promises[promise_id] = promise
        
        // Start promise resolution
        resolve_promise(promise_id, promise_data)
        
        promise_id = promise_id
      }
    }
  }

  recipe "resolve_promise" {
    needs: promise_id, promise_data
    gives: promise_resolved
    
    brain {
      plan { action: "resolve_promise" }
      execute {
        promise = memory.pending_promises[promise_id]
        
        // Simulate async resolution
        if promise_data.resolve_immediately {
          // Resolve immediately
          promise.status = "resolved"
          promise.result = promise_data.result
          promise.resolved_at = get_timestamp()
        } else {
          // Simulate async resolution
          setTimeout(function() {
            promise.status = "resolved"
            promise.result = promise_data.result
            promise.resolved_at = get_timestamp()
            
            // Emit promise resolved
            emit "promise_resolved" { 
              promise_id: promise_id,
              result: promise.result,
              timestamp: get_timestamp()
            }
          }, promise_data.delay || 1000)
        }
        
        promise_resolved = true
      }
    }
  }

  // Parallel processing
  recipe "start_parallel_task_group" {
    needs: tasks, group_id
    gives: task_ids
    
    brain {
      plan { action: "start_parallel" }
      execute {
        task_ids = []
        
        // Start all tasks in parallel
        for each task in tasks {
          task_id = generate_task_id()
          task_ids.push(task_id)
          
          // Create task record
          task_record = {
            id: task_id,
            group_id: group_id,
            task_data: task,
            status: "running",
            start_time: get_timestamp()
          }
          
          memory.parallel_tasks[task_id] = task_record
          
          // Execute task
          execute_parallel_task(task_id, task)
        }
        
        task_ids = task_ids
      }
    }
  }

  recipe "execute_parallel_task" {
    needs: task_id, task_data
    gives: task_executed
    
    brain {
      plan { action: "execute_task" }
      execute {
        task_type = task_data.type
        task_input = task_data.input
        
        // Execute task based on type
        if task_type == "data_processing" {
          result = process_data_parallel(task_input)
        } else if task_type == "computation" {
          result = compute_parallel(task_input)
        } else if task_type == "validation" {
          result = validate_parallel(task_input)
        }
        
        // Store result
        memory.parallel_tasks[task_id].result = result
        memory.parallel_tasks[task_id].status = "completed"
        memory.parallel_tasks[task_id].completed_at = get_timestamp()
        
        task_executed = true
      }
    }
  }

  // Utility methods
  recipe "generate_operation_id" {
    needs: none
    gives: operation_id
    
    brain {
      plan { action: "generate_id" }
      execute {
        memory.operation_counter += 1
        operation_id = "op_" + get_timestamp() + "_" + memory.operation_counter
      }
    }
  }

  recipe "generate_promise_id" {
    needs: none
    gives: promise_id
    
    brain {
      plan { action: "generate_promise_id" }
      execute {
        promise_id = "promise_" + get_timestamp() + "_" + Math.random().toString(36).substring(2, 8)
      }
    }
  }

  recipe "generate_task_id" {
    needs: none
    gives: task_id
    
    brain {
      plan { action: "generate_task_id" }
      execute {
        task_id = "task_" + get_timestamp() + "_" + Math.random().toString(36).substring(2, 8)
      }
    }
  }

  recipe "generate_task_group_id" {
    needs: none
    gives: group_id
    
    brain {
      plan { action: "generate_group_id" }
      execute {
        group_id = "group_" + get_timestamp() + "_" + Math.random().toString(36).substring(2, 8)
      }
    }
  }

  recipe "handle_operation_completion" {
    needs: operation_id, result, success
    gives: completion_handled
    
    brain {
      plan { action: "handle_completion" }
      execute {
        operation = memory.active_operations[operation_id]
        
        if operation {
          // Update operation status
          operation.status = success ? "completed" : "failed"
          operation.result = result
          operation.completed_at = get_timestamp()
          operation.completion_time = operation.completed_at - operation.start_time
          
          // Update statistics
          if success {
            memory.async_stats.completed_operations += 1
          } else {
            memory.async_stats.failed_operations += 1
          }
          
          // Remove from active operations
          delete memory.active_operations[operation_id]
          
          // Emit completion event
          emit "operation_completed" { 
            operation_id: operation_id,
            success: success,
            result: result,
            completion_time: operation.completion_time
          }
        }
        
        completion_handled = true
      }
    }
  }

  recipe "process_operation_queue" {
    needs: none
    gives: queue_processed
    
    brain {
      plan { action: "process_queue" }
      execute {
        // Process queued operations if capacity available
        while memory.operation_queue.length > 0 && 
              Object.keys(memory.active_operations).length < memory.max_concurrent_operations {
          
          queued_operation = memory.operation_queue.shift()
          start_operation(queued_operation.id, queued_operation.type, queued_operation.data)
        }
        
        queue_processed = true
      }
    }
  }

  recipe "cleanup_completed_operations" {
    needs: none
    gives: cleanup_complete
    
    brain {
      plan { action: "cleanup" }
      execute {
        // Clean up old completed operations
        current_time = get_timestamp()
        for each operation_id in Object.keys(memory.active_operations) {
          operation = memory.active_operations[operation_id]
          if operation.status == "completed" && (current_time - operation.completed_at) > 300000 {
            delete memory.active_operations[operation_id]
          }
        }
        
        cleanup_complete = true
      }
    }
  }

  recipe "update_async_statistics" {
    needs: none
    gives: stats_updated
    
    brain {
      plan { action: "update_stats" }
      execute {
        // Calculate average completion time
        total_time = 0
        completed_count = 0
        
        for each operation_id in Object.keys(memory.active_operations) {
          operation = memory.active_operations[operation_id]
          if operation.status == "completed" && operation.completion_time {
            total_time += operation.completion_time
            completed_count += 1
          }
        }
        
        if completed_count > 0 {
          memory.async_stats.average_completion_time = total_time / completed_count
        }
        
        stats_updated = true
      }
    }
  }

  recipe "monitor_queue_health" {
    needs: none
    gives: health_monitored
    
    brain {
      plan { action: "monitor_health" }
      execute {
        // Monitor queue health
        queue_length = memory.operation_queue.length
        active_operations = Object.keys(memory.active_operations).length
        
        if queue_length > 50 {
          emit "queue_health_warning" { 
            message: "Operation queue is getting long: " + queue_length + " operations",
            queue_length: queue_length,
            active_operations: active_operations
          }
        }
        
        if active_operations >= memory.max_concurrent_operations {
          emit "concurrency_warning" { 
            message: "Maximum concurrent operations reached",
            active_operations: active_operations,
            max_concurrent: memory.max_concurrent_operations
          }
        }
        
        health_monitored = true
      }
    }
  }
} 