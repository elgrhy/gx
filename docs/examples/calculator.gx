helper "calculator" {
  can_do: ["addition", "multiplication", "subtraction", "division"]

  remember {
    calculations_performed = 0
    last_result = 0
    history = []
  }

  brain {
    plan {
      if memory.calculations_performed == 0 {
        plan = { action: "add_numbers" }
      } else if memory.calculations_performed == 1 {
        plan = { action: "multiply_numbers" }
      } else if memory.calculations_performed == 2 {
        plan = { action: "subtract_numbers" }
      } else {
        plan = { action: "divide_numbers" }
      }
    }

    execute {
      if plan.action == "add_numbers" {
        result = 5 + 3
        memory.last_result = result
        memory.calculations_performed = memory.calculations_performed + 1
        output("5 + 3 = " + result)
      } else if plan.action == "multiply_numbers" {
        result = 4 * 6
        memory.last_result = result
        memory.calculations_performed = memory.calculations_performed + 1
        output("4 * 6 = " + result)
      } else if plan.action == "subtract_numbers" {
        result = 10 - 4
        memory.last_result = result
        memory.calculations_performed = memory.calculations_performed + 1
        output("10 - 4 = " + result)
      } else if plan.action == "divide_numbers" {
        result = 20 / 4
        memory.last_result = result
        memory.calculations_performed = memory.calculations_performed + 1
        output("20 / 4 = " + result)
      }
    }

    remember {
      memory.total_calculations = memory.calculations_performed
    }

    communicate {
      emit "calculation_complete" {
        result: memory.last_result,
        total_calculations: memory.total_calculations
      }
    }
  }
}
