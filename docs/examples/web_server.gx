// Web Server — AI-powered HTTP server built in GX
//
// Run:
//   gx run docs/examples/web_server.gx
//
// Then open http://localhost:3000 in your browser.
// Or test with curl:
//   curl http://localhost:3000
//   curl http://localhost:3000/api/hello
//   curl -X POST http://localhost:3000/api/ask -d "What is the capital of France?"

agent "WebServer" {
  when started {
    print("Starting GX web server...")

    serve on port 3000 {

      route GET "/" {
        respond html "<!DOCTYPE html>
<html>
<head><title>GX Web Server</title>
<style>body{font-family:sans-serif;max-width:600px;margin:60px auto;padding:20px}
h1{color:#333}pre{background:#f5f5f5;padding:15px;border-radius:8px}
a{color:#0070f3}</style>
</head>
<body>
<h1>Hello from GX!</h1>
<p>This web server is built with the GX brain-first programming language.</p>
<h3>Try these endpoints:</h3>
<pre>GET  /api/hello          — JSON greeting
POST /api/ask            — Ask the AI anything (body = your question)
GET  /api/time           — Current timestamp</pre>
<p><a href='/api/hello'>Try /api/hello →</a></p>
</body></html>"
      }

      route GET "/api/hello" {
        respond json { message: "Hello from GX!", version: "0.1.3", language: "GX" }
      }

      route GET "/api/time" {
        ts = get_timestamp()
        respond json { timestamp: ts, message: "Current server time" }
      }

      route POST "/api/ask" {
        question = request.body
        if question == "" {
          respond json { error: "Send a question in the request body" }
        }
        result = ask openai {
          prompt: "Answer this question briefly: " + question,
          model: "gpt-4o-mini"
        }
        ok = result["ok"]
        if ok == true {
          respond json { answer: result["text"], question: question }
        } else {
          respond json { error: result["error"] }
        }
      }

      route GET "/api/status" {
        respond json { status: "running", name: "WebServer", powered_by: "GX Language" }
      }

    }
  }
}
