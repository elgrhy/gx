{
  "New Agent": {
    "prefix": "agent",
    "body": [
      "agent \"${1:name}\" {",
      "  remember {",
      "    ${2:key} = ${3:value}",
      "  }",
      "",
      "  when started {",
      "    ${4:say \"Hello!\"}",
      "  }",
      "}"
    ],
    "description": "Create a new GX agent"
  },
  "New Helper (full syntax)": {
    "prefix": "helper",
    "body": [
      "helper \"${1:name}\" {",
      "  remember {",
      "    ${2:key} = ${3:value}",
      "  }",
      "",
      "  brain {",
      "    plan {",
      "      plan = { action: \"${4:default}\" }",
      "    }",
      "    execute {",
      "      if plan.action == \"${4:default}\" {",
      "        ${5:// your logic here}",
      "      }",
      "    }",
      "    remember {",
      "      memory.last_run = get_timestamp()",
      "    }",
      "    communicate {",
      "      emit \"done\" {}",
      "    }",
      "  }",
      "}"
    ],
    "description": "Create a new GX helper with full brain cycle"
  },
  "Brain block": {
    "prefix": "brain",
    "body": [
      "brain {",
      "  plan {",
      "    plan = { action: \"${1:default}\" }",
      "  }",
      "  execute {",
      "    ${2:// execute logic}",
      "  }",
      "  remember {",
      "    ${3:// persist results}",
      "  }",
      "  communicate {",
      "    ${4:// emit events}",
      "  }",
      "}"
    ],
    "description": "Full brain cycle block"
  },
  "When started block": {
    "prefix": "when started",
    "body": [
      "when started {",
      "  ${1:say \"Agent started!\"}",
      "}"
    ],
    "description": "Run code when agent starts"
  },
  "Ask AI": {
    "prefix": "ask",
    "body": [
      "result = ask ${1|openai,anthropic,ollama|} {",
      "  prompt: \"${2:Your prompt here}\",",
      "  max_tokens: ${3:200}",
      "}",
      "",
      "if result.confidence > 0.8 {",
      "  say result.text",
      "} else {",
      "  escalate to human",
      "}"
    ],
    "description": "Ask an AI model and check confidence"
  },
  "Function definition": {
    "prefix": "function",
    "body": [
      "function ${1:name}(${2:params}) {",
      "  ${3:return null}",
      "}"
    ],
    "description": "Define a reusable function"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:memory.items} {",
      "  ${3:log(item)}",
      "}"
    ],
    "description": "For loop over a collection"
  },
  "If-else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "  ${2:// true branch}",
      "} else {",
      "  ${3:// false branch}",
      "}"
    ],
    "description": "If-else block"
  },
  "Try-catch": {
    "prefix": "try",
    "body": [
      "try {",
      "  ${1:// risky operation}",
      "} catch ${2:err} {",
      "  log(\"Error: \" + ${2:err})",
      "}"
    ],
    "description": "Try-catch block"
  },
  "Import file": {
    "prefix": "import",
    "body": [
      "import \"${1:path/to/file.gx}\""
    ],
    "description": "Import functions from another .gx file"
  },
  "Use package": {
    "prefix": "use",
    "body": [
      "use ${1|js,py|}.${2:package}"
    ],
    "description": "Import a JS or Python package"
  },
  "Emit event": {
    "prefix": "emit",
    "body": [
      "emit \"${1:event_name}\" { ${2:key}: ${3:value} }"
    ],
    "description": "Emit an event"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "  ${2:// loop body}",
      "}"
    ],
    "description": "While loop"
  },
  "Assert": {
    "prefix": "assert",
    "body": [
      "assert ${1:condition} \"${2:message}\""
    ],
    "description": "Assert a condition (for tests)"
  },
  "Null coalescing": {
    "prefix": "??",
    "body": [
      "${1:value} ?? ${2:default}"
    ],
    "description": "Return default if value is null"
  },
  "Interactive loop": {
    "prefix": "repl",
    "body": [
      "while true {",
      "  user_input = input(\"${1:> }\")",
      "  if user_input == \"exit\" {",
      "    break",
      "  }",
      "  ${2:// handle input}",
      "}"
    ],
    "description": "Interactive input loop"
  },
  "OpenClaw AI assistant": {
    "prefix": "openclaw",
    "body": [
      "agent \"${1:MyAssistant}\" {",
      "  memory {",
      "    history = []",
      "    provider = \"${2|openai,anthropic,ollama|}\"",
      "  }",
      "",
      "  when started {",
      "    print(\"${1:MyAssistant} ready. Type 'exit' to quit.\")",
      "",
      "    while true {",
      "      user_input = input(\"You: \")",
      "      user_input = trim(user_input)",
      "",
      "      if user_input == \"exit\" { break }",
      "      if user_input == \"\" { continue }",
      "",
      "      memory.history = push(memory.history, { role: \"user\", content: user_input })",
      "",
      "      response = ask ${2|openai,anthropic,ollama|} {",
      "        prompt: \"${3:You are a helpful assistant.}\\n\\nUser: \" + user_input",
      "      }",
      "",
      "      memory.history = push(memory.history, { role: \"assistant\", content: response })",
      "      print(\"${1:MyAssistant}: \" + response)",
      "      print(\"\")",
      "    }",
      "  }",
      "}"
    ],
    "description": "OpenClaw-style personal AI assistant agent"
  },
  "HTTP GET": {
    "prefix": "http_get",
    "body": [
      "response = http_get(\"${1:https://api.example.com/endpoint}\")",
      "if response[\"ok\"] == true {",
      "  data = json_parse(response[\"body\"])",
      "  ${2:log(data)}",
      "} else {",
      "  log(\"Error: \" + response[\"status\"])",
      "}"
    ],
    "description": "HTTP GET request"
  },
  "HTTP POST": {
    "prefix": "http_post",
    "body": [
      "response = http_post(\"${1:https://api.example.com/endpoint}\", {",
      "  ${2:key}: \"${3:value}\"",
      "})",
      "data = json_parse(response[\"body\"])"
    ],
    "description": "HTTP POST request"
  },
  "Read file": {
    "prefix": "read_file",
    "body": [
      "if file_exists(\"${1:path/to/file.txt}\") {",
      "  content = read_file(\"${1:path/to/file.txt}\")",
      "  ${2:log(content)}",
      "}"
    ],
    "description": "Read a file safely"
  },
  "Write file": {
    "prefix": "write_file",
    "body": [
      "write_file(\"${1:output.txt}\", ${2:content})"
    ],
    "description": "Write content to a file"
  },
  "Shell command": {
    "prefix": "shell",
    "body": [
      "result = shell(\"${1:ls -la}\")",
      "if result[\"ok\"] == true {",
      "  log(result[\"stdout\"])",
      "} else {",
      "  log(\"Error: \" + result[\"stderr\"])",
      "}"
    ],
    "description": "Run a shell command and capture output"
  },
  "HTTP Server": {
    "prefix": "serve",
    "body": [
      "serve on port ${1:3000} {",
      "  route GET \"${2:/}\" {",
      "    respond html \"${3:<h1>Hello from GX!</h1>}\"",
      "  }",
      "  route GET \"${4:/api/hello}\" {",
      "    respond json { message: \"${5:Hello!}\" }",
      "  }",
      "  route POST \"${6:/api/ask}\" {",
      "    body = request.body",
      "    respond json { reply: body }",
      "  }",
      "}"
    ],
    "description": "HTTP server with routes"
  },
  "Route handler": {
    "prefix": "route",
    "body": [
      "route ${1|GET,POST,PUT,DELETE|} \"${2:/path}\" {",
      "  ${3:respond json { message: \"ok\" }}",
      "}"
    ],
    "description": "Single HTTP route"
  },
  "Respond HTML": {
    "prefix": "respond-html",
    "body": [
      "respond html \"${1:<h1>Hello!</h1>}\""
    ],
    "description": "Respond with HTML"
  },
  "Respond JSON": {
    "prefix": "respond-json",
    "body": [
      "respond json { ${1:key}: ${2:\"value\"} }"
    ],
    "description": "Respond with JSON"
  },
  "Progressive Agent": {
    "prefix": "agent-simple",
    "body": [
      "Agent ${1:MyAgent}",
      "",
      "${2:name} = \"${3:World}\"",
      "",
      "Greet:",
      "  \"Hello {${2:name}}!\"",
      "",
      "On start:",
      "  Greet"
    ],
    "description": "Progressive syntax agent (no braces needed)"
  },
  "Opinionated Agent (v0.2.0)": {
    "prefix": "agent-full",
    "body": [
      "agent \"${1:name}\" {",
      "  goal: \"${2:What this agent does}\"",
      "",
      "  retry: ${3:2}",
      "  on_error: ${4|escalate,continue|}",
      "",
      "  when started {",
      "    observe {",
      "      ${5:input}: ${6:memory.data}",
      "    }",
      "",
      "    think {",
      "      prompt: \"${7:Your prompt using {$5}}\",",
      "      model: \"${8|openai,anthropic,ollama|}\",",
      "      min_confidence: ${9:0.8}",
      "    }",
      "",
      "    act {",
      "      ${10:log(result.text)}",
      "    }",
      "",
      "    remember {",
      "      memory.last_run = get_timestamp()",
      "    }",
      "",
      "    communicate {",
      "      say \"Done: {result.text}\"",
      "    }",
      "  }",
      "}"
    ],
    "description": "Full opinionated v0.2.0 agent with goal/think/act/observe"
  },
  "Think block": {
    "prefix": "think",
    "body": [
      "think {",
      "  prompt: \"${1:Your prompt here}\",",
      "  model: \"${2|openai,anthropic,ollama|}\",",
      "  min_confidence: ${3:0.8}",
      "}"
    ],
    "description": "AI call with automatic confidence gate"
  },
  "Observe block": {
    "prefix": "observe",
    "body": [
      "observe {",
      "  ${1:input}: ${2:memory.data}",
      "}"
    ],
    "description": "Declare agent inputs"
  },
  "Act block": {
    "prefix": "act",
    "body": [
      "act {",
      "  ${1:// your execution logic}",
      "}"
    ],
    "description": "Labeled execution block"
  },
  "Loop until": {
    "prefix": "loop",
    "body": [
      "loop until ${1:condition} {",
      "  ${2:// body}",
      "}"
    ],
    "description": "Loop until condition is true"
  },
  "Repeat N times": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:10} times as ${2:i} {",
      "  ${3:log(i)}",
      "}"
    ],
    "description": "Repeat a block N times"
  },
  "Parallel block": {
    "prefix": "parallel",
    "body": [
      "parallel {",
      "  ${1:step_a()}",
      "  ${2:step_b()}",
      "  ${3:step_c()}",
      "}"
    ],
    "description": "Run multiple steps in parallel"
  },
  "Spawn agent": {
    "prefix": "spawn",
    "body": [
      "${1:result} = spawn agent \"${2:agent_name}\" with { ${3:key}: ${4:value} }"
    ],
    "description": "Call another agent and get its result"
  },
  "Pipeline": {
    "prefix": "pipeline",
    "body": [
      "${1:result} = { ${2:key}: ${3:value} } |> spawn agent \"${4:agent1}\" |> spawn agent \"${5:agent2}\""
    ],
    "description": "Multi-agent pipeline"
  },
  "When message": {
    "prefix": "when message",
    "body": [
      "when message \"${1:event_name}\" {",
      "  ${2:log(message.data)}",
      "}"
    ],
    "description": "Handle incoming agent message"
  },
  "Send message": {
    "prefix": "send",
    "body": [
      "spawn \"${1:event}\" to \"${2:agent_name}\" with { ${3:key}: ${4:value} }"
    ],
    "description": "Send a message to another agent"
  },
  "HTTP Request": {
    "prefix": "http_request",
    "body": [
      "result = http_request({",
      "  url: \"${1:https://api.example.com/endpoint}\",",
      "  method: \"${2|GET,POST,PUT,DELETE|}\",",
      "  body: ${3:null}",
      "})"
    ],
    "description": "Unified HTTP request"
  },
  "Send email": {
    "prefix": "send_email",
    "body": [
      "send_email({",
      "  to: \"${1:recipient@example.com}\",",
      "  subject: \"${2:Subject}\",",
      "  body: \"${3:Message body}\"",
      "})"
    ],
    "description": "Send an email via SMTP"
  },
  "Scrape": {
    "prefix": "scrape",
    "body": [
      "${1:text} = scrape(\"${2:https://example.com}\")"
    ],
    "description": "Fetch a URL and return clean text"
  },
  "Notify": {
    "prefix": "notify",
    "body": [
      "notify({",
      "  channel: \"${1|slack,webhook|}\",",
      "  message: \"${2:Notification message}\"",
      "})"
    ],
    "description": "Send a webhook notification"
  }
}
