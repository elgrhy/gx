{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GX",
  "scopeName": "source.gx",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#type-keyword" },
    { "include": "#ai-keyword" },
    { "include": "#builtin-function" },
    { "include": "#boolean-null" },
    { "include": "#operator" },
    { "include": "#memory-access" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.gx",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.gx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gx",
          "match": "\\\\[ntr\"\\\\]"
        },
        {
          "name": "variable.other.interpolated.gx",
          "match": "\\{[^}]*\\}"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.gx",
      "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b"
    },
    "keyword": {
      "name": "keyword.control.gx",
      "match": "\\b(agent|helper|brain|plan|execute|remember|communicate|receive|channel|when|started|changes|if|else|for|each|in|while|break|continue|assert|try|catch|return|re-run|escalate|to|human|wait|emit|broadcast|use|import|function|memory|serve|route|respond|port|on|spawn|with|message|goal|think|act|observe|loop|until|repeat|times|parallel|retry|timeout|on_error)\\b"
    },
    "type-keyword": {
      "name": "keyword.declaration.gx",
      "match": "\\b(recipe|objective|needs|gives|can_do)\\b"
    },
    "ai-keyword": {
      "name": "keyword.other.ai.gx",
      "match": "\\b(ask|embed|infer|classifier|openai|anthropic|ollama|claude|gpt|local)\\b"
    },
    "builtin-function": {
      "name": "support.function.builtin.gx",
      "match": "\\b(log|say|print|output|get_timestamp|to_string|to_number|str|num|len|count|type_of|is_null|is_empty|is_array|is_object|is_bool|keys|values|entries|range|zip|flatten|push|pop|first|last|join|split|trim|trim_start|trim_end|replace|contains|starts_with|ends_with|upper|lower|to_upper|to_lower|has|set_key|delete_key|merge|floor|ceil|round|abs|sqrt|pow|max|min|clamp|random|pi|e|json_parse|json_stringify|http_get|http_post|http_put|http_delete|http_request|send_email|scrape|notify|read_file|write_file|append_file|read_file_lines|file_exists|list_dir|delete_file|env|shell|exec|input|exit|base64_encode|base64_decode|html_escape|url_encode|sleep|now|ord|chr|is_digit|is_alpha|is_alnum|is_whitespace|substr|substring)\\b"
    },
    "boolean-null": {
      "name": "constant.language.gx",
      "match": "\\b(true|false|null)\\b"
    },
    "operator": {
      "name": "keyword.operator.gx",
      "match": "(==|!=|<=|>=|<|>|\\?\\?|\\+=|-=|\\*=|/=|\\+|-|\\*|/|%|=|\\band\\b|\\bor\\b|\\bnot\\b)"
    },
    "identifier": {
      "name": "variable.other.gx",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
