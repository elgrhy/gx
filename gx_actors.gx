helper "gx_actors" {
  can_do: ["actor_model", "concurrency", "message_passing", "actor_management", "supervision"]
  
  remember {
    actors = {}
    actor_registry = {}
    actor_system = {
      supervisor_tree: {},
      actor_metrics: {
        total_actors: 0,
        active_actors: 0,
        messages_sent: 0,
        messages_received: 0,
        actor_errors: 0
      },
      system_config: {
        max_actors: 10000,
        actor_timeout: 30000,  // 30 seconds
        enable_supervision: true,
        auto_restart: true,
        max_restart_attempts: 3
      }
    }
  }

  receive {
    from "actor_manager" as "actor_request" {
      type: "create_actor"
      bind: memory.actor_request
      on_receive: brain.handle_actor_request
    }
    
    from "message_router" as "actor_message" {
      type: "send_to_actor"
      bind: memory.actor_message
      on_receive: brain.handle_actor_message
    }
  }

  brain {
    plan {
      if memory.actor_request {
        plan = { action: "handle_actor_request", request: memory.actor_request }
      } else if memory.actor_message {
        plan = { action: "handle_actor_message", message: memory.actor_message }
      } else {
        plan = { action: "idle_actor_monitoring" }
      }
    }

    execute {
      if plan.action == "handle_actor_request" {
        try {
          request = plan.request
          
          if request.action == "create_actor" {
            actor = create_actor(request.name, request.behavior, request.supervisor)
            memory.actors[request.name] = actor
            memory.actor_registry[actor.id] = actor
            memory.actor_system.actor_metrics.total_actors += 1
            memory.actor_system.actor_metrics.active_actors += 1
            
            emit "actor_created" {
              actor_id: actor.id,
              actor_name: request.name,
              supervisor: request.supervisor
            }
          } else if request.action == "stop_actor" {
            stop_actor(request.actor_name)
          }
          
        } catch error {
          memory.actor_system.actor_metrics.actor_errors += 1
          emit "actor_error" {
            error: error,
            request: request
          }
        }
      } else if plan.action == "handle_actor_message" {
        try {
          message = plan.message
          actor_name = message.target_actor
          
          if memory.actors[actor_name] {
            send_message_to_actor(actor_name, message.data)
            memory.actor_system.actor_metrics.messages_sent += 1
          } else {
            throw new Error("Actor not found: " + actor_name)
          }
          
        } catch error {
          memory.actor_system.actor_metrics.actor_errors += 1
          emit "actor_message_error" {
            error: error,
            message: message
          }
        }
      } else if plan.action == "idle_actor_monitoring" {
        // Monitor actor health
        monitor_actor_health()
        
        // Handle supervision
        handle_supervision()
        
        // Update actor metrics
        update_actor_metrics()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      if memory.actor_request {
        emit "actor_operation_completed" {
          operation: memory.actor_request.action,
          success: true
        }
      }
    }
  }

  recipe "create_actor" {
    needs: name, behavior, supervisor
    gives: actor
    
    brain {
      plan {
        plan = { action: "create_actor_object" }
      }
      
      execute {
        if plan.action == "create_actor_object" {
          actor_id = generate_actor_id()
          
          actor = {
            id: actor_id,
            name: name,
            behavior: behavior,
            supervisor: supervisor,
            status: "active",
            mailbox: [],
            state: {},
            created_at: get_timestamp(),
            last_activity: get_timestamp(),
            restart_count: 0,
            metrics: {
              messages_received: 0,
              messages_sent: 0,
              errors: 0
            }
          }
          
          // Add to supervisor tree
          if supervisor {
            if !memory.actor_system.supervisor_tree[supervisor] {
              memory.actor_system.supervisor_tree[supervisor] = []
            }
            memory.actor_system.supervisor_tree[supervisor].push(actor_id)
          }
        }
      }
    }
  }

  recipe "send_message_to_actor" {
    needs: actor_name, message_data
    gives: success
    
    brain {
      plan {
        plan = { action: "send_message" }
      }
      
      execute {
        if plan.action == "send_message" {
          actor = memory.actors[actor_name]
          
          if actor && actor.status == "active" {
            // Create message
            message = {
              id: generate_message_id(),
              data: message_data,
              timestamp: get_timestamp(),
              sender: get_current_sender()
            }
            
            // Add to actor's mailbox
            actor.mailbox.push(message)
            actor.last_activity = get_timestamp()
            
            // Process message
            process_actor_message(actor, message)
            
            success = true
          } else {
            throw new Error("Actor is not active: " + actor_name)
          }
        }
      }
    }
  }

  recipe "process_actor_message" {
    needs: actor, message
    gives: void
    
    brain {
      plan {
        plan = { action: "process_message" }
      }
      
      execute {
        if plan.action == "process_message" {
          try {
            // Update metrics
            actor.metrics.messages_received += 1
            
            // Execute actor behavior
            result = execute_actor_behavior(actor, message)
            
            // Handle behavior result
            if result.type == "reply" {
              send_reply(actor, message, result.data)
            } else if result.type == "spawn" {
              spawn_child_actor(actor, result.child_config)
            } else if result.type == "stop" {
              stop_actor(actor.name)
            }
            
          } catch error {
            // Handle actor error
            handle_actor_error(actor, error)
          }
        }
      }
    }
  }

  recipe "execute_actor_behavior" {
    needs: actor, message
    gives: result
    
    brain {
      plan {
        plan = { action: "execute_behavior" }
      }
      
      execute {
        if plan.action == "execute_behavior" {
          // Execute the actor's behavior function
          behavior_result = actor.behavior(actor.state, message.data)
          
          // Update actor state
          if behavior_result.state {
            actor.state = behavior_result.state
          }
          
          result = {
            type: behavior_result.type || "continue",
            data: behavior_result.data,
            state: behavior_result.state
          }
        }
      }
    }
  }

  recipe "stop_actor" {
    needs: actor_name
    gives: void
    
    brain {
      plan {
        plan = { action: "stop_actor_object" }
      }
      
      execute {
        if plan.action == "stop_actor_object" {
          actor = memory.actors[actor_name]
          
          if actor {
            // Mark actor as stopped
            actor.status = "stopped"
            actor.stopped_at = get_timestamp()
            
            // Remove from active actors
            memory.actor_system.actor_metrics.active_actors -= 1
            
            // Notify supervisor
            if actor.supervisor {
              notify_supervisor(actor.supervisor, {
                type: "actor_stopped",
                actor_id: actor.id,
                actor_name: actor_name
              })
            }
            
            // Cleanup after timeout
            schedule_actor_cleanup(actor.id)
            
            emit "actor_stopped" {
              actor_id: actor.id,
              actor_name: actor_name
            }
          }
        }
      }
    }
  }

  recipe "handle_actor_error" {
    needs: actor, error
    gives: void
    
    brain {
      plan {
        plan = { action: "handle_error" }
      }
      
      execute {
        if plan.action == "handle_error" {
          // Update actor metrics
          actor.metrics.errors += 1
          
          // Notify supervisor
          if actor.supervisor {
            notify_supervisor(actor.supervisor, {
              type: "actor_error",
              actor_id: actor.id,
              actor_name: actor.name,
              error: error
            })
          }
          
          // Handle error based on supervision strategy
          if memory.actor_system.system_config.enable_supervision {
            handle_supervision_strategy(actor, error)
          } else {
            // Stop actor on error
            stop_actor(actor.name)
          }
        }
      }
    }
  }

  recipe "handle_supervision_strategy" {
    needs: actor, error
    gives: void
    
    brain {
      plan {
        plan = { action: "handle_supervision" }
      }
      
      execute {
        if plan.action == "handle_supervision" {
          if memory.actor_system.system_config.auto_restart {
            if actor.restart_count < memory.actor_system.system_config.max_restart_attempts {
              // Restart actor
              restart_actor(actor)
            } else {
              // Stop actor after max restart attempts
              stop_actor(actor.name)
            }
          } else {
            // Stop actor on error
            stop_actor(actor.name)
          }
        }
      }
    }
  }

  recipe "restart_actor" {
    needs: actor
    gives: void
    
    brain {
      plan {
        plan = { action: "restart_actor_object" }
      }
      
      execute {
        if plan.action == "restart_actor_object" {
          // Reset actor state
          actor.status = "active"
          actor.mailbox = []
          actor.state = {}
          actor.restart_count += 1
          actor.last_activity = get_timestamp()
          
          emit "actor_restarted" {
            actor_id: actor.id,
            actor_name: actor.name,
            restart_count: actor.restart_count
          }
        }
      }
    }
  }

  recipe "spawn_child_actor" {
    needs: parent_actor, child_config
    gives: child_actor
    
    brain {
      plan {
        plan = { action: "spawn_child" }
      }
      
      execute {
        if plan.action == "spawn_child" {
          // Create child actor with parent as supervisor
          child_actor = create_actor(
            child_config.name,
            child_config.behavior,
            parent_actor.name
          )
          
          memory.actors[child_config.name] = child_actor
          memory.actor_registry[child_actor.id] = child_actor
          memory.actor_system.actor_metrics.total_actors += 1
          memory.actor_system.actor_metrics.active_actors += 1
          
          emit "child_actor_spawned" {
            parent_actor: parent_actor.name,
            child_actor: child_config.name,
            child_id: child_actor.id
          }
        }
      }
    }
  }

  recipe "send_reply" {
    needs: actor, original_message, reply_data
    gives: void
    
    brain {
      plan {
        plan = { action: "send_reply_message" }
      }
      
      execute {
        if plan.action == "send_reply_message" {
          // Send reply to original sender
          if original_message.sender {
            reply_message = {
              id: generate_message_id(),
              data: reply_data,
              timestamp: get_timestamp(),
              sender: actor.name,
              reply_to: original_message.id
            }
            
            // Send reply to sender
            send_message_to_actor(original_message.sender, reply_message)
            actor.metrics.messages_sent += 1
          }
        }
      }
    }
  }

  recipe "notify_supervisor" {
    needs: supervisor_name, notification
    gives: void
    
    brain {
      plan {
        plan = { action: "notify_supervisor_actor" }
      }
      
      execute {
        if plan.action == "notify_supervisor_actor" {
          if memory.actors[supervisor_name] {
            // Send notification to supervisor
            send_message_to_actor(supervisor_name, notification)
          }
        }
      }
    }
  }

  recipe "monitor_actor_health" {
    brain {
      plan {
        plan = { action: "monitor_health" }
      }
      
      execute {
        if plan.action == "monitor_health" {
          current_time = get_timestamp()
          
          // Check for inactive actors
          for each actor_name in Object.keys(memory.actors) {
            actor = memory.actors[actor_name]
            
            if actor.status == "active" {
              // Check for timeout
              if current_time - actor.last_activity > memory.actor_system.system_config.actor_timeout {
                emit "actor_timeout" {
                  actor_id: actor.id,
                  actor_name: actor_name,
                  inactive_duration: current_time - actor.last_activity
                }
                
                // Handle timeout based on supervision strategy
                if memory.actor_system.system_config.enable_supervision {
                  handle_supervision_strategy(actor, new Error("Actor timeout"))
                } else {
                  stop_actor(actor_name)
                }
              }
            }
          }
          
          // Check for actor limit
          if memory.actor_system.actor_metrics.total_actors > memory.actor_system.system_config.max_actors {
            emit "actor_limit_exceeded" {
              total_actors: memory.actor_system.actor_metrics.total_actors,
              max_actors: memory.actor_system.system_config.max_actors
            }
          }
        }
      }
    }
  }

  recipe "handle_supervision" {
    brain {
      plan {
        plan = { action: "handle_supervision_tree" }
      }
      
      execute {
        if plan.action == "handle_supervision_tree" {
          // Process supervision tree
          for each supervisor_name in Object.keys(memory.actor_system.supervisor_tree) {
            supervisor = memory.actors[supervisor_name]
            children = memory.actor_system.supervisor_tree[supervisor_name]
            
            if supervisor && supervisor.status == "active" {
              // Check children health
              for each child_id in children {
                child = memory.actor_registry[child_id]
                
                if child && child.status == "stopped" {
                  // Handle child actor failure
                  handle_child_failure(supervisor, child)
                }
              }
            }
          }
        }
      }
    }
  }

  recipe "handle_child_failure" {
    needs: supervisor, child
    gives: void
    
    brain {
      plan {
        plan = { action: "handle_child_failure_event" }
      }
      
      execute {
        if plan.action == "handle_child_failure_event" {
          // Notify supervisor of child failure
          notify_supervisor(supervisor.name, {
            type: "child_failed",
            child_id: child.id,
            child_name: child.name,
            error: "Child actor stopped"
          })
          
          // Remove from supervision tree
          children = memory.actor_system.supervisor_tree[supervisor.name]
          child_index = children.indexOf(child.id)
          if child_index > -1 {
            children.splice(child_index, 1)
          }
        }
      }
    }
  }

  recipe "update_actor_metrics" {
    brain {
      plan {
        plan = { action: "update_metrics" }
      }
      
      execute {
        if plan.action == "update_metrics" {
          // Update global metrics
          total_messages_received = 0
          total_messages_sent = 0
          total_errors = 0
          
          for each actor_name in Object.keys(memory.actors) {
            actor = memory.actors[actor_name]
            total_messages_received += actor.metrics.messages_received
            total_messages_sent += actor.metrics.messages_sent
            total_errors += actor.metrics.errors
          }
          
          memory.actor_system.actor_metrics.messages_received = total_messages_received
          memory.actor_system.actor_metrics.messages_sent = total_messages_sent
          memory.actor_system.actor_metrics.actor_errors = total_errors
        }
      }
    }
  }

  recipe "generate_actor_id" {
    gives: actor_id
    
    brain {
      plan {
        plan = { action: "generate_id" }
      }
      
      execute {
        if plan.action == "generate_id" {
          actor_id = "actor_" + get_timestamp() + "_" + Math.random().toString(36).substr(2, 9)
        }
      }
    }
  }

  recipe "generate_message_id" {
    gives: message_id
    
    brain {
      plan {
        plan = { action: "generate_message_id" }
      }
      
      execute {
        if plan.action == "generate_message_id" {
          message_id = "msg_" + get_timestamp() + "_" + Math.random().toString(36).substr(2, 9)
        }
      }
    }
  }

  recipe "get_current_sender" {
    gives: sender_id
    
    brain {
      plan {
        plan = { action: "get_sender" }
      }
      
      execute {
        if plan.action == "get_sender" {
          // Get current execution context sender
          sender_id = "current_sender_" + get_timestamp()
        }
      }
    }
  }

  recipe "schedule_actor_cleanup" {
    needs: actor_id
    gives: void
    
    brain {
      plan {
        plan = { action: "schedule_cleanup" }
      }
      
      execute {
        if plan.action == "schedule_cleanup" {
          // Schedule cleanup after timeout
          setTimeout(function() {
            cleanup_actor(actor_id)
          }, memory.actor_system.system_config.actor_timeout)
        }
      }
    }
  }

  recipe "cleanup_actor" {
    needs: actor_id
    gives: void
    
    brain {
      plan {
        plan = { action: "cleanup_actor_object" }
      }
      
      execute {
        if plan.action == "cleanup_actor_object" {
          // Remove actor from registry
          if memory.actor_registry[actor_id] {
            delete memory.actor_registry[actor_id]
          }
        }
      }
    }
  }
} 