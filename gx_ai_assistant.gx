helper "gx_ai_assistant" {
  can_do: ["ai_assistance", "code_generation", "intelligent_debugging", "code_optimization", "ai_learning"]
  
  remember {
    ai_models = {}
    code_patterns = {}
    learning_data = {
      code_examples: [],
      debugging_sessions: [],
      optimization_suggestions: [],
      user_feedback: []
    }
    
    ai_config = {
      enable_code_generation: true,
      enable_intelligent_debugging: true,
      enable_code_optimization: true,
      enable_learning: true,
      max_suggestions: 5,
      confidence_threshold: 0.7
    }
  }

  receive {
    from "developer" as "ai_request" {
      type: "ai_assistance_request"
      bind: memory.ai_request
      on_receive: brain.handle_ai_request
    }
    
    from "code_analyzer" as "code_analysis" {
      type: "code_analysis_result"
      bind: memory.code_analysis
      on_receive: brain.handle_code_analysis
    }
  }

  brain {
    plan {
      if memory.ai_request {
        plan = { action: "handle_ai_request", request: memory.ai_request }
      } else if memory.code_analysis {
        plan = { action: "handle_code_analysis", analysis: memory.code_analysis }
      } else {
        plan = { action: "idle_ai_learning" }
      }
    }

    execute {
      if plan.action == "handle_ai_request" {
        try {
          request = plan.request
          
          if request.action == "generate_code" {
            generated_code = generate_code_suggestion(request.context, request.requirements)
            emit "code_generated" {
              code: generated_code,
              confidence: generated_code.confidence,
              explanation: generated_code.explanation
            }
          } else if request.action == "debug_code" {
            debugging_suggestion = provide_debugging_suggestion(request.code, request.error)
            emit "debugging_suggestion" {
              suggestion: debugging_suggestion,
              confidence: debugging_suggestion.confidence,
              explanation: debugging_suggestion.explanation
            }
          } else if request.action == "optimize_code" {
            optimization_suggestion = provide_optimization_suggestion(request.code, request.performance_goals)
            emit "optimization_suggestion" {
              suggestion: optimization_suggestion,
              confidence: optimization_suggestion.confidence,
              explanation: optimization_suggestion.explanation
            }
          } else if request.action == "explain_code" {
            explanation = explain_code(request.code, request.context)
            emit "code_explanation" {
              explanation: explanation,
              confidence: explanation.confidence
            }
          }
          
        } catch error {
          emit "ai_assistance_error" {
            error: error,
            request: request
          }
        }
      } else if plan.action == "handle_code_analysis" {
        analysis = plan.analysis
        
        // Learn from code analysis
        learn_from_code_analysis(analysis)
        
        // Update AI models
        update_ai_models(analysis)
        
      } else if plan.action == "idle_ai_learning" {
        // Continuous learning from user feedback
        process_user_feedback()
        
        // Update code patterns
        update_code_patterns()
        
        // Optimize AI models
        optimize_ai_models()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      if memory.ai_request {
        emit "ai_assistance_completed" {
          request_type: memory.ai_request.action,
          success: true
        }
      }
    }
  }

  recipe "generate_code_suggestion" {
    needs: context, requirements
    gives: suggestion
    
    brain {
      plan {
        plan = { action: "generate_code" }
      }
      
      execute {
        if plan.action == "generate_code" {
          // Analyze context and requirements
          context_analysis = analyze_context(context)
          requirements_analysis = analyze_requirements(requirements)
          
          // Find relevant code patterns
          relevant_patterns = find_relevant_code_patterns(context_analysis, requirements_analysis)
          
          // Generate code suggestion
          generated_code = generate_code_from_patterns(relevant_patterns, requirements_analysis)
          
          // Calculate confidence
          confidence = calculate_generation_confidence(generated_code, context_analysis)
          
          suggestion = {
            code: generated_code,
            confidence: confidence,
            explanation: generate_explanation(generated_code, context_analysis),
            alternatives: generate_alternative_suggestions(relevant_patterns, requirements_analysis)
          }
        }
      }
    }
  }

  recipe "provide_debugging_suggestion" {
    needs: code, error
    gives: suggestion
    
    brain {
      plan {
        plan = { action: "debug_code" }
      }
      
      execute {
        if plan.action == "debug_code" {
          // Analyze the error
          error_analysis = analyze_error(error)
          
          // Analyze the code
          code_analysis = analyze_code_for_debugging(code)
          
          // Find similar debugging patterns
          debugging_patterns = find_debugging_patterns(error_analysis, code_analysis)
          
          // Generate debugging suggestion
          debugging_suggestion = generate_debugging_suggestion(debugging_patterns, error_analysis, code_analysis)
          
          // Calculate confidence
          confidence = calculate_debugging_confidence(debugging_suggestion, error_analysis)
          
          suggestion = {
            suggestion: debugging_suggestion,
            confidence: confidence,
            explanation: generate_debugging_explanation(debugging_suggestion, error_analysis),
            steps: generate_debugging_steps(debugging_suggestion)
          }
        }
      }
    }
  }

  recipe "provide_optimization_suggestion" {
    needs: code, performance_goals
    gives: suggestion
    
    brain {
      plan {
        plan = { action: "optimize_code" }
      }
      
      execute {
        if plan.action == "optimize_code" {
          // Analyze code performance
          performance_analysis = analyze_code_performance(code)
          
          // Analyze performance goals
          goals_analysis = analyze_performance_goals(performance_goals)
          
          // Find optimization patterns
          optimization_patterns = find_optimization_patterns(performance_analysis, goals_analysis)
          
          // Generate optimization suggestion
          optimization_suggestion = generate_optimization_suggestion(optimization_patterns, performance_analysis, goals_analysis)
          
          // Calculate confidence
          confidence = calculate_optimization_confidence(optimization_suggestion, performance_analysis)
          
          suggestion = {
            suggestion: optimization_suggestion,
            confidence: confidence,
            explanation: generate_optimization_explanation(optimization_suggestion, performance_analysis),
            expected_improvement: calculate_expected_improvement(optimization_suggestion, performance_analysis)
          }
        }
      }
    }
  }

  recipe "explain_code" {
    needs: code, context
    gives: explanation
    
    brain {
      plan {
        plan = { action: "explain_code_logic" }
      }
      
      execute {
        if plan.action == "explain_code_logic" {
          // Analyze code structure
          code_structure = analyze_code_structure(code)
          
          // Generate explanation
          code_explanation = generate_code_explanation(code_structure, context)
          
          // Calculate confidence
          confidence = calculate_explanation_confidence(code_explanation, code_structure)
          
          explanation = {
            explanation: code_explanation,
            confidence: confidence,
            structure: code_structure,
            highlights: generate_code_highlights(code_structure)
          }
        }
      }
    }
  }

  recipe "learn_from_code_analysis" {
    needs: analysis
    gives: void
    
    brain {
      plan {
        plan = { action: "learn_from_analysis" }
      }
      
      execute {
        if plan.action == "learn_from_analysis" {
          // Extract patterns from analysis
          patterns = extract_patterns_from_analysis(analysis)
          
          // Update learning data
          memory.learning_data.code_examples.push({
            code: analysis.code,
            patterns: patterns,
            timestamp: get_timestamp()
          })
          
          // Update code patterns
          for each pattern in patterns {
            update_code_pattern(pattern)
          }
          
          // Learn from debugging sessions
          if analysis.debugging_session {
            memory.learning_data.debugging_sessions.push({
              session: analysis.debugging_session,
              patterns: patterns,
              timestamp: get_timestamp()
            })
          }
        }
      }
    }
  }

  recipe "update_ai_models" {
    needs: analysis
    gives: void
    
    brain {
      plan {
        plan = { action: "update_models" }
      }
      
      execute {
        if plan.action == "update_models" {
          // Update code generation model
          update_code_generation_model(analysis)
          
          // Update debugging model
          update_debugging_model(analysis)
          
          // Update optimization model
          update_optimization_model(analysis)
          
          // Update explanation model
          update_explanation_model(analysis)
        }
      }
    }
  }

  recipe "process_user_feedback" {
    brain {
      plan {
        plan = { action: "process_feedback" }
      }
      
      execute {
        if plan.action == "process_feedback" {
          // Process user feedback for learning
          for each feedback in memory.learning_data.user_feedback {
            process_single_feedback(feedback)
          }
          
          // Clear processed feedback
          memory.learning_data.user_feedback = []
        }
      }
    }
  }

  recipe "update_code_patterns" {
    brain {
      plan {
        plan = { action: "update_patterns" }
      }
      
      execute {
        if plan.action == "update_patterns" {
          // Update code patterns based on learning data
          for each example in memory.learning_data.code_examples {
            patterns = extract_patterns_from_example(example)
            for each pattern in patterns {
              update_code_pattern(pattern)
            }
          }
        }
      }
    }
  }

  recipe "optimize_ai_models" {
    brain {
      plan {
        plan = { action: "optimize_models" }
      }
      
      execute {
        if plan.action == "optimize_models" {
          // Optimize AI models based on learning data
          optimize_code_generation_model()
          optimize_debugging_model()
          optimize_optimization_model()
          optimize_explanation_model()
        }
      }
    }
  }

  // Helper recipes for AI operations
  recipe "analyze_context" {
    needs: context
    gives: analysis
    
    brain {
      plan {
        plan = { action: "analyze_context_data" }
      }
      
      execute {
        if plan.action == "analyze_context_data" {
          analysis = {
            language: context.language || "gx",
            domain: context.domain || "general",
            complexity: context.complexity || "medium",
            patterns: extract_context_patterns(context)
          }
        }
      }
    }
  }

  recipe "analyze_requirements" {
    needs: requirements
    gives: analysis
    
    brain {
      plan {
        plan = { action: "analyze_requirements_data" }
      }
      
      execute {
        if plan.action == "analyze_requirements_data" {
          analysis = {
            functionality: requirements.functionality || [],
            constraints: requirements.constraints || [],
            performance: requirements.performance || {},
            patterns: extract_requirement_patterns(requirements)
          }
        }
      }
    }
  }

  recipe "find_relevant_code_patterns" {
    needs: context_analysis, requirements_analysis
    gives: patterns
    
    brain {
      plan {
        plan = { action: "find_patterns" }
      }
      
      execute {
        if plan.action == "find_patterns" {
          // Find relevant code patterns based on context and requirements
          patterns = []
          
          for each pattern_name in Object.keys(memory.code_patterns) {
            pattern = memory.code_patterns[pattern_name]
            
            if is_pattern_relevant(pattern, context_analysis, requirements_analysis) {
              patterns.push(pattern)
            }
          }
          
          // Sort by relevance score
          patterns.sort(function(a, b) {
            return b.relevance_score - a.relevance_score
          })
        }
      }
    }
  }

  recipe "generate_code_from_patterns" {
    needs: patterns, requirements_analysis
    gives: generated_code
    
    brain {
      plan {
        plan = { action: "generate_from_patterns" }
      }
      
      execute {
        if plan.action == "generate_from_patterns" {
          // Combine patterns to generate code
          combined_pattern = combine_patterns(patterns)
          
          // Adapt pattern to requirements
          adapted_pattern = adapt_pattern_to_requirements(combined_pattern, requirements_analysis)
          
          // Generate final code
          generated_code = generate_final_code(adapted_pattern)
        }
      }
    }
  }

  recipe "calculate_generation_confidence" {
    needs: generated_code, context_analysis
    gives: confidence
    
    brain {
      plan {
        plan = { action: "calculate_confidence" }
      }
      
      execute {
        if plan.action == "calculate_confidence" {
          // Calculate confidence based on pattern match and context fit
          pattern_confidence = calculate_pattern_confidence(generated_code)
          context_confidence = calculate_context_confidence(generated_code, context_analysis)
          
          confidence = (pattern_confidence + context_confidence) / 2
        }
      }
    }
  }

  recipe "analyze_error" {
    needs: error
    gives: analysis
    
    brain {
      plan {
        plan = { action: "analyze_error_data" }
      }
      
      execute {
        if plan.action == "analyze_error_data" {
          analysis = {
            type: error.type || "unknown",
            message: error.message || "",
            stack_trace: error.stack_trace || [],
            patterns: extract_error_patterns(error)
          }
        }
      }
    }
  }

  recipe "analyze_code_for_debugging" {
    needs: code
    gives: analysis
    
    brain {
      plan {
        plan = { action: "analyze_code_debugging" }
      }
      
      execute {
        if plan.action == "analyze_code_debugging" {
          analysis = {
            structure: analyze_code_structure(code),
            complexity: calculate_code_complexity(code),
            potential_issues: identify_potential_issues(code),
            patterns: extract_debugging_patterns(code)
          }
        }
      }
    }
  }

  recipe "find_debugging_patterns" {
    needs: error_analysis, code_analysis
    gives: patterns
    
    brain {
      plan {
        plan = { action: "find_debugging_patterns" }
      }
      
      execute {
        if plan.action == "find_debugging_patterns" {
          // Find debugging patterns based on error and code analysis
          patterns = []
          
          // Search for similar error patterns in learning data
          for each session in memory.learning_data.debugging_sessions {
            if is_error_similar(session.error, error_analysis) {
              patterns.push(session.solution)
            }
          }
          
          // Sort by similarity score
          patterns.sort(function(a, b) {
            return b.similarity_score - a.similarity_score
          })
        }
      }
    }
  }

  recipe "generate_debugging_suggestion" {
    needs: debugging_patterns, error_analysis, code_analysis
    gives: suggestion
    
    brain {
      plan {
        plan = { action: "generate_debugging" }
      }
      
      execute {
        if plan.action == "generate_debugging" {
          // Generate debugging suggestion based on patterns
          if debugging_patterns.length > 0 {
            best_pattern = debugging_patterns[0]
            suggestion = adapt_debugging_pattern(best_pattern, error_analysis, code_analysis)
          } else {
            suggestion = generate_generic_debugging_suggestion(error_analysis, code_analysis)
          }
        }
      }
    }
  }

  recipe "analyze_code_performance" {
    needs: code
    gives: analysis
    
    brain {
      plan {
        plan = { action: "analyze_performance" }
      }
      
      execute {
        if plan.action == "analyze_performance" {
          analysis = {
            complexity: calculate_time_complexity(code),
            memory_usage: estimate_memory_usage(code),
            bottlenecks: identify_performance_bottlenecks(code),
            optimization_opportunities: find_optimization_opportunities(code)
          }
        }
      }
    }
  }

  recipe "analyze_performance_goals" {
    needs: performance_goals
    gives: analysis
    
    brain {
      plan {
        plan = { action: "analyze_goals" }
      }
      
      execute {
        if plan.action == "analyze_goals" {
          analysis = {
            target_complexity: performance_goals.complexity || "O(n)",
            target_memory: performance_goals.memory || "low",
            target_speed: performance_goals.speed || "fast",
            constraints: performance_goals.constraints || []
          }
        }
      }
    }
  }

  recipe "find_optimization_patterns" {
    needs: performance_analysis, goals_analysis
    gives: patterns
    
    brain {
      plan {
        plan = { action: "find_optimization_patterns" }
      }
      
      execute {
        if plan.action == "find_optimization_patterns" {
          // Find optimization patterns based on performance analysis and goals
          patterns = []
          
          // Search for optimization patterns in learning data
          for each example in memory.learning_data.code_examples {
            if is_optimization_relevant(example, performance_analysis, goals_analysis) {
              patterns.push(example.optimization)
            }
          }
          
          // Sort by relevance score
          patterns.sort(function(a, b) {
            return b.relevance_score - a.relevance_score
          })
        }
      }
    }
  }

  recipe "generate_optimization_suggestion" {
    needs: optimization_patterns, performance_analysis, goals_analysis
    gives: suggestion
    
    brain {
      plan {
        plan = { action: "generate_optimization" }
      }
      
      execute {
        if plan.action == "generate_optimization" {
          // Generate optimization suggestion based on patterns
          if optimization_patterns.length > 0 {
            best_pattern = optimization_patterns[0]
            suggestion = adapt_optimization_pattern(best_pattern, performance_analysis, goals_analysis)
          } else {
            suggestion = generate_generic_optimization_suggestion(performance_analysis, goals_analysis)
          }
        }
      }
    }
  }

  recipe "extract_patterns_from_analysis" {
    needs: analysis
    gives: patterns
    
    brain {
      plan {
        plan = { action: "extract_patterns" }
      }
      
      execute {
        if plan.action == "extract_patterns" {
          patterns = []
          
          // Extract code patterns
          if analysis.code_patterns {
            patterns = patterns.concat(analysis.code_patterns)
          }
          
          // Extract error patterns
          if analysis.error_patterns {
            patterns = patterns.concat(analysis.error_patterns)
          }
          
          // Extract optimization patterns
          if analysis.optimization_patterns {
            patterns = patterns.concat(analysis.optimization_patterns)
          }
        }
      }
    }
  }

  recipe "update_code_pattern" {
    needs: pattern
    gives: void
    
    brain {
      plan {
        plan = { action: "update_pattern" }
      }
      
      execute {
        if plan.action == "update_pattern" {
          pattern_name = pattern.name || generate_pattern_name(pattern)
          
          if memory.code_patterns[pattern_name] {
            // Update existing pattern
            existing_pattern = memory.code_patterns[pattern_name]
            existing_pattern.usage_count += 1
            existing_pattern.last_used = get_timestamp()
            existing_pattern.examples.push(pattern.example)
          } else {
            // Create new pattern
            memory.code_patterns[pattern_name] = {
              name: pattern_name,
              pattern: pattern.pattern,
              examples: [pattern.example],
              usage_count: 1,
              created_at: get_timestamp(),
              last_used: get_timestamp()
            }
          }
        }
      }
    }
  }

  recipe "generate_pattern_name" {
    needs: pattern
    gives: name
    
    brain {
      plan {
        plan = { action: "generate_name" }
      }
      
      execute {
        if plan.action == "generate_name" {
          name = "pattern_" + pattern.type + "_" + get_timestamp()
        }
      }
    }
  }
} 