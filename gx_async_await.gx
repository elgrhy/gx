helper "gx_async_await" {
  can_do: ["async_await", "concurrency", "promise_management", "async_execution", "await_handling"]
  
  remember {
    async_contexts = {}
    promise_registry = {}
    async_queue = []
    execution_context = {
      current_async_id: null,
      async_stack: [],
      await_points: []
    }
    
    async_config = {
      max_concurrent_async: 100,
      async_timeout: 30000,  // 30 seconds
      enable_debugging: true,
      auto_cancel_on_error: true
    }
  }

  receive {
    from "async_executor" as "async_request" {
      type: "execute_async_function"
      bind: memory.async_request
      on_receive: brain.handle_async_execution
    }
    
    from "promise_manager" as "promise_update" {
      type: "promise_resolved"
      bind: memory.promise_update
      on_receive: brain.handle_promise_update
    }
  }

  brain {
    plan {
      if memory.async_request {
        plan = { action: "execute_async_function", request: memory.async_request }
      } else if memory.promise_update {
        plan = { action: "handle_promise_resolution", update: memory.promise_update }
      } else {
        plan = { action: "idle_async_monitoring" }
      }
    }

    execute {
      if plan.action == "execute_async_function" {
        try {
          request = plan.request
          async_id = generate_async_id()
          
          // Create async context
          memory.async_contexts[async_id] = {
            id: async_id,
            function: request.function,
            parameters: request.parameters,
            status: "pending",
            start_time: get_timestamp(),
            result: null,
            error: null,
            promise: create_promise(async_id)
          }
          
          // Add to execution queue
          memory.async_queue.push(async_id)
          
          // Execute async function
          execute_async_function(async_id, request.function, request.parameters)
          
        } catch error {
          memory.async_contexts[async_id].status = "failed"
          memory.async_contexts[async_id].error = error
          reject_promise(async_id, error)
        }
      } else if plan.action == "handle_promise_resolution" {
        update = plan.update
        promise_id = update.promise_id
        
        if memory.promise_registry[promise_id] {
          if update.status == "resolved" {
            resolve_promise(promise_id, update.result)
          } else if update.status == "rejected" {
            reject_promise(promise_id, update.error)
          }
        }
      } else if plan.action == "idle_async_monitoring" {
        // Monitor async execution health
        monitor_async_execution_health()
        
        // Cleanup completed async contexts
        cleanup_completed_async_contexts()
        
        // Process async queue
        process_async_queue()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      if memory.async_request {
        emit "async_function_started" {
          async_id: memory.async_request.async_id,
          function_name: memory.async_request.function.name
        }
      }
    }
  }

  recipe "execute_async_function" {
    needs: async_id, function, parameters
    gives: void
    
    brain {
      plan {
        plan = { action: "execute_async" }
      }
      
      execute {
        if plan.action == "execute_async" {
          try {
            // Set execution context
            memory.execution_context.current_async_id = async_id
            memory.execution_context.async_stack.push(async_id)
            
            // Execute the function
            result = function.apply(null, parameters)
            
            // Handle different result types
            if is_promise(result) {
              // Function returned a promise
              handle_promise_result(async_id, result)
            } else {
              // Function completed synchronously
              complete_async_function(async_id, result)
            }
            
          } catch error {
            // Handle async function error
            handle_async_error(async_id, error)
          } finally {
            // Cleanup execution context
            memory.execution_context.async_stack.pop()
            if memory.execution_context.async_stack.length == 0 {
              memory.execution_context.current_async_id = null
            }
          }
        }
      }
    }
  }

  recipe "await_expression" {
    needs: promise
    gives: result
    
    brain {
      plan {
        plan = { action: "handle_await" }
      }
      
      execute {
        if plan.action == "handle_await" {
          current_async_id = memory.execution_context.current_async_id
          
          if current_async_id {
            // Add await point to execution context
            memory.execution_context.await_points.push({
              async_id: current_async_id,
              promise: promise,
              timestamp: get_timestamp()
            })
            
            // Suspend current async function
            suspend_async_function(current_async_id)
            
            // Wait for promise resolution
            result = wait_for_promise_resolution(promise)
            
            // Resume async function
            resume_async_function(current_async_id, result)
          } else {
            // Not in async context, execute synchronously
            result = promise.then()
          }
        }
      }
    }
  }

  recipe "create_promise" {
    needs: async_id
    gives: promise
    
    brain {
      plan {
        plan = { action: "create_promise_object" }
      }
      
      execute {
        if plan.action == "create_promise_object" {
          promise = {
            id: async_id,
            status: "pending",
            result: null,
            error: null,
            resolve_callbacks: [],
            reject_callbacks: [],
            then: function(on_resolve, on_reject) {
              if (this.status == "resolved") {
                return on_resolve(this.result)
              } else if (this.status == "rejected") {
                return on_reject(this.error)
              } else {
                this.resolve_callbacks.push(on_resolve)
                this.reject_callbacks.push(on_reject)
              }
            },
            catch: function(on_reject) {
              return this.then(null, on_reject)
            }
          }
          
          memory.promise_registry[async_id] = promise
        }
      }
    }
  }

  recipe "resolve_promise" {
    needs: promise_id, result
    gives: void
    
    brain {
      plan {
        plan = { action: "resolve_promise_object" }
      }
      
      execute {
        if plan.action == "resolve_promise_object" {
          promise = memory.promise_registry[promise_id]
          
          if promise && promise.status == "pending" {
            promise.status = "resolved"
            promise.result = result
            
            // Execute resolve callbacks
            for each callback in promise.resolve_callbacks {
              try {
                callback(result)
              } catch error {
                log("Error in promise resolve callback: " + error)
              }
            }
            
            // Update async context
            if memory.async_contexts[promise_id] {
              memory.async_contexts[promise_id].status = "completed"
              memory.async_contexts[promise_id].result = result
            }
          }
        }
      }
    }
  }

  recipe "reject_promise" {
    needs: promise_id, error
    gives: void
    
    brain {
      plan {
        plan = { action: "reject_promise_object" }
      }
      
      execute {
        if plan.action == "reject_promise_object" {
          promise = memory.promise_registry[promise_id]
          
          if promise && promise.status == "pending" {
            promise.status = "rejected"
            promise.error = error
            
            // Execute reject callbacks
            for each callback in promise.reject_callbacks {
              try {
                callback(error)
              } catch callback_error {
                log("Error in promise reject callback: " + callback_error)
              }
            }
            
            // Update async context
            if memory.async_contexts[promise_id] {
              memory.async_contexts[promise_id].status = "failed"
              memory.async_contexts[promise_id].error = error
            }
          }
        }
      }
    }
  }

  recipe "complete_async_function" {
    needs: async_id, result
    gives: void
    
    brain {
      plan {
        plan = { action: "complete_async" }
      }
      
      execute {
        if plan.action == "complete_async" {
          // Update async context
          memory.async_contexts[async_id].status = "completed"
          memory.async_contexts[async_id].result = result
          
          // Resolve promise
          resolve_promise(async_id, result)
          
          // Emit completion event
          emit "async_function_completed" {
            async_id: async_id,
            result: result
          }
        }
      }
    }
  }

  recipe "handle_async_error" {
    needs: async_id, error
    gives: void
    
    brain {
      plan {
        plan = { action: "handle_error" }
      }
      
      execute {
        if plan.action == "handle_error" {
          // Update async context
          memory.async_contexts[async_id].status = "failed"
          memory.async_contexts[async_id].error = error
          
          // Reject promise
          reject_promise(async_id, error)
          
          // Emit error event
          emit "async_function_failed" {
            async_id: async_id,
            error: error
          }
        }
      }
    }
  }

  recipe "suspend_async_function" {
    needs: async_id
    gives: void
    
    brain {
      plan {
        plan = { action: "suspend_execution" }
      }
      
      execute {
        if plan.action == "suspend_execution" {
          // Mark async function as suspended
          memory.async_contexts[async_id].status = "suspended"
          
          // Store current execution state
          memory.async_contexts[async_id].suspended_at = get_timestamp()
        }
      }
    }
  }

  recipe "resume_async_function" {
    needs: async_id, result
    gives: void
    
    brain {
      plan {
        plan = { action: "resume_execution" }
      }
      
      execute {
        if plan.action == "resume_execution" {
          // Resume async function execution
          memory.async_contexts[async_id].status = "running"
          
          // Continue execution with result
          continue_async_execution(async_id, result)
        }
      }
    }
  }

  recipe "wait_for_promise_resolution" {
    needs: promise
    gives: result
    
    brain {
      plan {
        plan = { action: "wait_for_resolution" }
      }
      
      execute {
        if plan.action == "wait_for_resolution" {
          // Wait for promise to be resolved or rejected
          while promise.status == "pending" {
            // Check for timeout
            if get_timestamp() - memory.async_contexts[memory.execution_context.current_async_id].start_time > memory.async_config.async_timeout {
              throw new Error("Async operation timed out")
            }
            
            // Yield control to other async operations
            yield_control()
          }
          
          if promise.status == "resolved" {
            result = promise.result
          } else if promise.status == "rejected" {
            throw promise.error
          }
        }
      }
    }
  }

  recipe "monitor_async_execution_health" {
    brain {
      plan {
        plan = { action: "monitor_health" }
      }
      
      execute {
        if plan.action == "monitor_health" {
          current_time = get_timestamp()
          
          // Check for stuck async functions
          for each async_id in Object.keys(memory.async_contexts) {
            context = memory.async_contexts[async_id]
            
            if context.status == "running" || context.status == "suspended" {
              if current_time - context.start_time > memory.async_config.async_timeout {
                // Async function is stuck
                emit "async_function_timeout" {
                  async_id: async_id,
                  duration: current_time - context.start_time
                }
                
                // Cancel stuck async function
                if memory.async_config.auto_cancel_on_error {
                  cancel_async_function(async_id)
                }
              }
            }
          }
          
          // Check queue health
          if memory.async_queue.length > memory.async_config.max_concurrent_async {
            emit "async_queue_overflow" {
              queue_length: memory.async_queue.length,
              max_concurrent: memory.async_config.max_concurrent_async
            }
          }
        }
      }
    }
  }

  recipe "cleanup_completed_async_contexts" {
    brain {
      plan {
        plan = { action: "cleanup_contexts" }
      }
      
      execute {
        if plan.action == "cleanup_contexts" {
          current_time = get_timestamp()
          
          // Remove completed contexts older than 5 minutes
          for each async_id in Object.keys(memory.async_contexts) {
            context = memory.async_contexts[async_id]
            
            if (context.status == "completed" || context.status == "failed") {
              if current_time - context.start_time > 300000 { // 5 minutes
                delete memory.async_contexts[async_id]
                delete memory.promise_registry[async_id]
              }
            }
          }
        }
      }
    }
  }

  recipe "process_async_queue" {
    brain {
      plan {
        plan = { action: "process_queue" }
      }
      
      execute {
        if plan.action == "process_queue" {
          // Process async queue with concurrency limit
          running_count = 0
          
          for each async_id in Object.keys(memory.async_contexts) {
            if memory.async_contexts[async_id].status == "running" {
              running_count += 1
            }
          }
          
          // Start new async functions if under limit
          while memory.async_queue.length > 0 && running_count < memory.async_config.max_concurrent_async {
            async_id = memory.async_queue.shift()
            context = memory.async_contexts[async_id]
            
            if context.status == "pending" {
              context.status = "running"
              running_count += 1
              
              // Execute the async function
              execute_async_function(async_id, context.function, context.parameters)
            }
          }
        }
      }
    }
  }

  recipe "generate_async_id" {
    gives: async_id
    
    brain {
      plan {
        plan = { action: "generate_id" }
      }
      
      execute {
        if plan.action == "generate_id" {
          async_id = "async_" + get_timestamp() + "_" + Math.random().toString(36).substr(2, 9)
        }
      }
    }
  }

  recipe "is_promise" {
    needs: value
    gives: is_promise
    
    brain {
      plan {
        plan = { action: "check_promise" }
      }
      
      execute {
        if plan.action == "check_promise" {
          is_promise = value && typeof value.then === "function"
        }
      }
    }
  }

  recipe "yield_control" {
    brain {
      plan {
        plan = { action: "yield" }
      }
      
      execute {
        if plan.action == "yield" {
          // Allow other async operations to run
          // This is a simplified yield - in a real implementation,
          // this would involve more sophisticated scheduling
          setTimeout(function() {}, 0)
        }
      }
    }
  }

  recipe "cancel_async_function" {
    needs: async_id
    gives: void
    
    brain {
      plan {
        plan = { action: "cancel_async" }
      }
      
      execute {
        if plan.action == "cancel_async" {
          if memory.async_contexts[async_id] {
            memory.async_contexts[async_id].status = "cancelled"
            
            // Reject promise with cancellation error
            reject_promise(async_id, new Error("Async function cancelled"))
            
            // Remove from queue
            queue_index = memory.async_queue.indexOf(async_id)
            if queue_index > -1 {
              memory.async_queue.splice(queue_index, 1)
            }
          }
        }
      }
    }
  }
} 