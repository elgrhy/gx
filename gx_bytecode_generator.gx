helper "gx_bytecode_generator" {
  can_do: ["bytecode_generation", "instruction_optimization", "symbol_resolution", "code_generation"]
  
  remember {
    instruction_set = {
      // Data manipulation
      LOAD_CONST: 0x01,      // Load constant value
      STORE_VAR: 0x02,       // Store to variable
      LOAD_VAR: 0x03,        // Load variable value
      COPY: 0x04,            // Copy value between registers
      
      // Helper operations
      SPAWN_HELPER: 0x10,    // Create new helper
      CALL_HELPER: 0x11,     // Call helper function
      DESTROY_HELPER: 0x12,  // Destroy helper
      
      // Message handling
      SEND_MESSAGE: 0x20,    // Send message to helper
      RECEIVE_MESSAGE: 0x21, // Receive message from channel
      BROADCAST: 0x22,       // Broadcast message to all
      
      // Brain process instructions
      BRAIN_PLAN: 0x30,      // Start plan phase
      BRAIN_EXECUTE: 0x31,   // Start execute phase
      BRAIN_REMEMBER: 0x32,  // Start remember phase
      BRAIN_COMMUNICATE: 0x33, // Start communicate phase
      
      // Control flow
      JUMP: 0x40,            // Unconditional jump
      JUMP_IF: 0x41,         // Conditional jump
      JUMP_IF_FALSE: 0x42,   // Jump if condition is false
      CALL: 0x43,            // Call function
      RETURN: 0x44,          // Return from function
      HALT: 0x45,            // Halt execution
      
      // Arithmetic operations
      ADD: 0x50,             // Addition
      SUB: 0x51,             // Subtraction
      MUL: 0x52,             // Multiplication
      DIV: 0x53,             // Division
      MOD: 0x54,             // Modulo
      
      // Logical operations
      AND: 0x60,             // Logical AND
      OR: 0x61,              // Logical OR
      NOT: 0x62,             // Logical NOT
      EQ: 0x63,              // Equality comparison
      LT: 0x64,              // Less than
      GT: 0x65,              // Greater than
      
      // Memory operations
      ALLOC: 0x70,           // Allocate memory
      FREE: 0x71,            // Free memory
      PUSH: 0x72,            // Push to stack
      POP: 0x73,             // Pop from stack
      
      // System operations
      LOG: 0x80,             // Log message
      ERROR: 0x81,           // Raise error
      TIMESTAMP: 0x82,       // Get current timestamp
      RANDOM: 0x83,          // Generate random number
    }
    
    symbol_table = {}
    label_table = {}
    current_address = 0
    generated_bytecode = []
    optimization_level = "production"
  }

  receive {
    from "compiler" as "ast_data" {
      type: "parsed_ast"
      bind: memory.ast_input
      on_receive: brain.generate_bytecode
    }
    
    from "optimizer" as "optimization_request" {
      type: "optimize_bytecode"
      bind: memory.optimization_request
      on_receive: brain.optimize_bytecode
    }
  }

  brain {
    plan {
      if memory.ast_input {
        plan = {
          action: "generate_from_ast",
          ast: memory.ast_input
        }
      } else if memory.optimization_request {
        plan = {
          action: "apply_optimizations",
          request: memory.optimization_request
        }
      }
    }
    
    execute {
      if plan.action == "generate_from_ast" {
        // Reset state
        memory.symbol_table = {}
        memory.label_table = {}
        memory.current_address = 0
        memory.generated_bytecode = []
        
        // Generate bytecode from AST
        bytecode = generate_bytecode_from_ast(plan.ast)
        memory.generated_bytecode = bytecode
        
        // Resolve labels and symbols
        resolve_labels_and_symbols()
        
        // Optimize bytecode
        optimized_bytecode = optimize_generated_bytecode(bytecode)
        memory.generated_bytecode = optimized_bytecode
      } else if plan.action == "apply_optimizations" {
        optimized_bytecode = apply_optimization_passes(memory.generated_bytecode, plan.request.passes)
        memory.generated_bytecode = optimized_bytecode
      }
    }
    
    remember {
      memory.generation_stats = {
        total_instructions: memory.generated_bytecode.length,
        symbols_resolved: Object.keys(memory.symbol_table).length,
        labels_resolved: Object.keys(memory.label_table).length,
        optimization_level: memory.optimization_level,
        generation_time: get_timestamp()
      }
    }
    
    communicate {
      if memory.generated_bytecode.length > 0 {
        broadcast "bytecode_generated" {
          bytecode: memory.generated_bytecode,
          stats: memory.generation_stats,
          symbol_table: memory.symbol_table
        }
      }
    }
  }

  recipe "generate_bytecode_from_ast" {
    needs: ast
    gives: bytecode
    
    brain {
      plan {
        plan = {
          action: "traverse_ast",
          ast: ast
        }
      }
      
      execute {
        bytecode = []
        
        // Generate bytecode for each helper
        for each helper in ast.helpers {
          helper_bytecode = generate_helper_bytecode(helper)
          bytecode.push(...helper_bytecode)
        }
        
        // Add main entry point
        bytecode.push(memory.instruction_set.HALT)
      }
    }
  }

  recipe "generate_helper_bytecode" {
    needs: helper_ast
    gives: helper_bytecode
    
    brain {
      plan {
        plan = {
          action: "compile_helper_structure",
          helper: helper_ast
        }
      }
      
      execute {
        helper_bytecode = []
        
        // Helper declaration
        helper_bytecode.push(memory.instruction_set.SPAWN_HELPER, helper_ast.name)
        
        // Capabilities
        for each capability in helper_ast.capabilities {
          helper_bytecode.push(memory.instruction_set.LOAD_CONST, capability)
        }
        
        // Memory section
        if helper_ast.memory {
          memory_bytecode = generate_memory_bytecode(helper_ast.memory)
          helper_bytecode.push(...memory_bytecode)
        }
        
        // Receive channels
        if helper_ast.receive {
          receive_bytecode = generate_receive_bytecode(helper_ast.receive)
          helper_bytecode.push(...receive_bytecode)
        }
        
        // Brain process
        if helper_ast.brain {
          brain_bytecode = generate_brain_bytecode(helper_ast.brain)
          helper_bytecode.push(...brain_bytecode)
        }
        
        // Objectives
        if helper_ast.objectives {
          for each objective in helper_ast.objectives {
            objective_bytecode = generate_objective_bytecode(objective)
            helper_bytecode.push(...objective_bytecode)
          }
        }
        
        // Messages
        if helper_ast.messages {
          for each message in helper_ast.messages {
            message_bytecode = generate_message_bytecode(message)
            helper_bytecode.push(...message_bytecode)
          }
        }
        
        // Recipes
        if helper_ast.recipes {
          for each recipe in helper_ast.recipes {
            recipe_bytecode = generate_recipe_bytecode(recipe)
            helper_bytecode.push(...recipe_bytecode)
          }
        }
      }
    }
  }

  recipe "generate_brain_bytecode" {
    needs: brain_ast
    gives: brain_bytecode
    
    brain {
      plan {
        plan = {
          action: "compile_brain_cycle",
          brain: brain_ast
        }
      }
      
      execute {
        brain_bytecode = []
        
        // Plan phase
        if brain_ast.plan {
          brain_bytecode.push(memory.instruction_set.BRAIN_PLAN)
          plan_bytecode = generate_expression_bytecode(brain_ast.plan)
          brain_bytecode.push(...plan_bytecode)
        }
        
        // Execute phase
        if brain_ast.execute {
          brain_bytecode.push(memory.instruction_set.BRAIN_EXECUTE)
          execute_bytecode = generate_expression_bytecode(brain_ast.execute)
          brain_bytecode.push(...execute_bytecode)
        }
        
        // Remember phase
        if brain_ast.remember {
          brain_bytecode.push(memory.instruction_set.BRAIN_REMEMBER)
          remember_bytecode = generate_expression_bytecode(brain_ast.remember)
          brain_bytecode.push(...remember_bytecode)
        }
        
        // Communicate phase
        if brain_ast.communicate {
          brain_bytecode.push(memory.instruction_set.BRAIN_COMMUNICATE)
          communicate_bytecode = generate_expression_bytecode(brain_ast.communicate)
          brain_bytecode.push(...communicate_bytecode)
        }
      }
    }
  }

  recipe "generate_expression_bytecode" {
    needs: expression_ast
    gives: expression_bytecode
    
    brain {
      plan {
        plan = {
          action: "compile_expression",
          expression: expression_ast
        }
      }
      
      execute {
        expression_bytecode = []
        
        // Handle different expression types
        if expression_ast.type == "literal" {
          expression_bytecode.push(memory.instruction_set.LOAD_CONST, expression_ast.value)
        } else if expression_ast.type == "variable" {
          expression_bytecode.push(memory.instruction_set.LOAD_VAR, expression_ast.name)
        } else if expression_ast.type == "binary_operation" {
          // Generate left operand
          left_bytecode = generate_expression_bytecode(expression_ast.left)
          expression_bytecode.push(...left_bytecode)
          
          // Generate right operand
          right_bytecode = generate_expression_bytecode(expression_ast.right)
          expression_bytecode.push(...right_bytecode)
          
          // Generate operation
          operation_bytecode = generate_operation_bytecode(expression_ast.operator)
          expression_bytecode.push(...operation_bytecode)
        } else if expression_ast.type == "function_call" {
          // Generate arguments
          for each arg in expression_ast.arguments {
            arg_bytecode = generate_expression_bytecode(arg)
            expression_bytecode.push(...arg_bytecode)
          }
          
          // Generate function call
          expression_bytecode.push(memory.instruction_set.CALL, expression_ast.function_name)
        } else if expression_ast.type == "helper_call" {
          expression_bytecode.push(memory.instruction_set.CALL_HELPER, expression_ast.helper_name)
        }
      }
    }
  }

  recipe "generate_operation_bytecode" {
    needs: operator
    gives: operation_bytecode
    
    brain {
      plan {
        plan = {
          action: "map_operator",
          operator: operator
        }
      }
      
      execute {
        operation_bytecode = []
        
        // Map operator to bytecode instruction
        if operator == "+" {
          operation_bytecode.push(memory.instruction_set.ADD)
        } else if operator == "-" {
          operation_bytecode.push(memory.instruction_set.SUB)
        } else if operator == "*" {
          operation_bytecode.push(memory.instruction_set.MUL)
        } else if operator == "/" {
          operation_bytecode.push(memory.instruction_set.DIV)
        } else if operator == "%" {
          operation_bytecode.push(memory.instruction_set.MOD)
        } else if operator == "&&" {
          operation_bytecode.push(memory.instruction_set.AND)
        } else if operator == "||" {
          operation_bytecode.push(memory.instruction_set.OR)
        } else if operator == "!" {
          operation_bytecode.push(memory.instruction_set.NOT)
        } else if operator == "==" {
          operation_bytecode.push(memory.instruction_set.EQ)
        } else if operator == "<" {
          operation_bytecode.push(memory.instruction_set.LT)
        } else if operator == ">" {
          operation_bytecode.push(memory.instruction_set.GT)
        }
      }
    }
  }

  recipe "optimize_generated_bytecode" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "apply_optimizations",
          bytecode: bytecode,
          level: memory.optimization_level
        }
      }
      
      execute {
        optimized_bytecode = bytecode
        
        // Apply optimization passes
        optimized_bytecode = constant_folding(optimized_bytecode)
        optimized_bytecode = dead_code_elimination(optimized_bytecode)
        optimized_bytecode = peephole_optimization(optimized_bytecode)
        
        if memory.optimization_level == "aggressive" {
          optimized_bytecode = loop_optimization(optimized_bytecode)
          optimized_bytecode = instruction_combining(optimized_bytecode)
        }
      }
    }
  }

  recipe "constant_folding" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "fold_constants",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = []
        i = 0
        
        while i < bytecode.length {
          if i + 2 < bytecode.length {
            // Check for constant arithmetic operations
            if bytecode[i] == memory.instruction_set.LOAD_CONST &&
                bytecode[i + 2] == memory.instruction_set.LOAD_CONST &&
                bytecode[i + 4] in [memory.instruction_set.ADD, memory.instruction_set.SUB, memory.instruction_set.MUL, memory.instruction_set.DIV] {
              
              // Fold constant operation
              left_value = bytecode[i + 1]
              right_value = bytecode[i + 3]
              operator = bytecode[i + 4]
              
              result = calculate_constant_operation(left_value, right_value, operator)
              optimized_bytecode.push(memory.instruction_set.LOAD_CONST, result)
              
              i += 5
            } else {
              optimized_bytecode.push(bytecode[i])
              i += 1
            }
          } else {
            optimized_bytecode.push(bytecode[i])
            i += 1
          }
        }
      }
    }
  }

  objective "ensure_bytecode_quality" {
    when memory.generation_stats.total_instructions > 10000
    then {
      action: "apply_aggressive_optimization",
      target: memory.generated_bytecode
    }
  }

  message "bytecode_generation_error" {
    do {
      log("Bytecode generation failed: " + memory.error_message)
      broadcast "bytecode_generation_failed" {
        error: memory.error_message,
        ast: memory.ast_input
      }
    }
  }
} 