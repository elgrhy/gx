        if plan.action == "test_quantum_gates" {
          gates_test_result = {
            total_tests: 0,
            passed_tests: 0,
            failed_tests: 0,
            details: {}
          }
          
          // Test Hadamard gate
          try {
            hadamard_result = apply_hadamard_gate(0) // Apply to qubit 0
            if hadamard_result && hadamard_result.gate == "H" {
              gates_test_result.passed_tests += 1
              gates_test_result.details.hadamard_gate = "PASSED"
            } else {
              gates_test_result.failed_tests += 1
              gates_test_result.details.hadamard_gate = "FAILED"
            }
            gates_test_result.total_tests += 1
          } catch error {
            gates_test_result.failed_tests += 1
            gates_test_result.total_tests += 1
            gates_test_result.details.hadamard_gate = "FAILED: " + error
          }
          
          // Test CNOT gate
          try {
            cnot_result = apply_cnot_gate(0, 1) // Control qubit 0, target qubit 1
            if cnot_result && cnot_result.gate == "CNOT" {
              gates_test_result.passed_tests += 1
              gates_test_result.details.cnot_gate = "PASSED"
            } else {
              gates_test_result.failed_tests += 1
              gates_test_result.details.cnot_gate = "FAILED"
            }
            gates_test_result.total_tests += 1
          } catch error {
            gates_test_result.failed_tests += 1
            gates_test_result.total_tests += 1
            gates_test_result.details.cnot_gate = "FAILED: " + error
          }
        }
      }
    }
  }

