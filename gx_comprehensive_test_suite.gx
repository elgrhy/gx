  recipe "test_basic_type_checking" {
    gives: basic_type_result
    
    brain {
      plan {
        plan = { action: "test_basic_types" }
      }
      
      execute {
        if plan.action == "test_basic_types" {
          basic_type_result = {
            total_tests: 0,
            passed_tests: 0,
            failed_tests: 0,
            details: {}
          }
          
          // Test int type
          try {
            int_value: int = 42
            if typeof int_value == "number" && Number.isInteger(int_value) {
              basic_type_result.passed_tests += 1
              basic_type_result.details.int_type = "PASSED"
            } else {
              basic_type_result.failed_tests += 1
              basic_type_result.details.int_type = "FAILED"
            }
            basic_type_result.total_tests += 1
          } catch error {
            basic_type_result.failed_tests += 1
            basic_type_result.details.int_type = "FAILED: " + error
            basic_type_result.total_tests += 1
          }
          
          // Test float type
          try {
            float_value: float = 3.14
            if typeof float_value == "number" {
              basic_type_result.passed_tests += 1
              basic_type_result.details.float_type = "PASSED"
            } else {
              basic_type_result.failed_tests += 1
              basic_type_result.details.float_type = "FAILED"
            }
            basic_type_result.total_tests += 1
          } catch error {
            basic_type_result.failed_tests += 1
            basic_type_result.details.float_type = "FAILED: " + error
            basic_type_result.total_tests += 1
          }
          
          // Test string type
          try {
            string_value: string = "Hello, GX!"
            if typeof string_value == "string" {
              basic_type_result.passed_tests += 1
              basic_type_result.details.string_type = "PASSED"
            } else {
              basic_type_result.failed_tests += 1
              basic_type_result.details.string_type = "FAILED"
            }
            basic_type_result.total_tests += 1
          } catch error {
            basic_type_result.failed_tests += 1
            basic_type_result.details.string_type = "FAILED: " + error
            basic_type_result.total_tests += 1
          }
          
          // Test bool type
          try {
            bool_value: bool = true
            if typeof bool_value == "boolean" {
              basic_type_result.passed_tests += 1
              basic_type_result.details.bool_type = "PASSED"
            } else {
              basic_type_result.failed_tests += 1
              basic_type_result.details.bool_type = "FAILED"
            }
            basic_type_result.total_tests += 1
          } catch error {
            basic_type_result.failed_tests += 1
