helper "gx_comprehensive_test_suite" {
  can_do: ["comprehensive_testing", "system_integration", "performance_testing", "security_testing", "regression_testing"]
  
  remember {
    test_results = {
      security_tests: {},
      type_system_tests: {},
      error_handling_tests: {},
      package_management_tests: {},
      testing_framework_tests: {},
      documentation_tests: {},
      ide_integration_tests: {},
      logging_tests: {},
      performance_tests: {},
      memory_management_tests: {},
      integration_tests: {}
    }
    
    test_config = {
      run_security_tests: true,
      run_type_tests: true,
      run_error_tests: true,
      run_package_tests: true,
      run_testing_tests: true,
      run_doc_tests: true,
      run_ide_tests: true,
      run_logging_tests: true,
      run_performance_tests: true,
      run_memory_tests: true,
      run_integration_tests: true
    }
    
    test_metrics = {
      total_tests: 0,
      passed_tests: 0,
      failed_tests: 0,
      test_duration: 0,
      coverage_percentage: 0
    }
  }

  receive {
    from "test_runner" as "test_execution_request" {
      type: "run_comprehensive_tests"
      bind: memory.test_request
      on_receive: brain.execute_comprehensive_tests
    }
    
    from "test_monitor" as "test_progress" {
      type: "test_progress_update"
      bind: memory.test_progress
      on_receive: brain.update_test_progress
    }
  }

  brain {
    plan {
      if memory.test_request {
        plan = { action: "run_all_tests", request: memory.test_request }
      } else if memory.test_progress {
        plan = { action: "update_progress", progress: memory.test_progress }
      } else {
        plan = { action: "idle_test_monitoring" }
      }
    }

    execute {
      if plan.action == "run_all_tests" {
        try {
          start_time = get_timestamp()
          
          // Run all test suites
          test_suites = [
            "security_test_suite",
            "type_system_test_suite", 
            "error_handling_test_suite",
            "package_management_test_suite",
            "testing_framework_test_suite",
            "documentation_test_suite",
            "ide_integration_test_suite",
            "logging_test_suite",
            "performance_test_suite",
            "memory_management_test_suite",
            "integration_test_suite"
          ]
          
          for each test_suite in test_suites {
            suite_result = execute_test_suite(test_suite)
            memory.test_results[test_suite] = suite_result
            
            // Update metrics
            memory.test_metrics.total_tests += suite_result.total_tests
            memory.test_metrics.passed_tests += suite_result.passed_tests
            memory.test_metrics.failed_tests += suite_result.failed_tests
          }
          
          memory.test_metrics.test_duration = get_timestamp() - start_time
          memory.test_metrics.coverage_percentage = calculate_test_coverage()
          
          memory.comprehensive_test_result = {
            success: memory.test_metrics.failed_tests == 0,
            total_tests: memory.test_metrics.total_tests,
            passed_tests: memory.test_metrics.passed_tests,
            failed_tests: memory.test_metrics.failed_tests,
            duration: memory.test_metrics.test_duration,
            coverage: memory.test_metrics.coverage_percentage,
            test_results: memory.test_results
          }
          
        } catch test_error {
          memory.comprehensive_test_result = {
            success: false,
            error: "Comprehensive testing failed: " + test_error
          }
        }
      } else if plan.action == "update_progress" {
        progress = plan.progress
        memory.test_progress = progress
      } else if plan.action == "idle_test_monitoring" {
        // Monitor test health
        monitor_test_health()
        
        // Update test statistics
        update_test_statistics()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      if memory.comprehensive_test_result {
        if memory.comprehensive_test_result.success {
          emit "comprehensive_tests_passed" {
            total_tests: memory.comprehensive_test_result.total_tests,
            passed_tests: memory.comprehensive_test_result.passed_tests,
            coverage: memory.comprehensive_test_result.coverage,
            duration: memory.comprehensive_test_result.duration
          }
        } else {
          emit "comprehensive_tests_failed" {
            failed_tests: memory.comprehensive_test_result.failed_tests,
            error: memory.comprehensive_test_result.error
          }
        }
      }
    }
  }

  recipe "execute_test_suite" {
    needs: test_suite_name
    gives: suite_result
    
    brain {
      plan {
        plan = { action: "run_test_suite" }
      }
      
      execute {
        if plan.action == "run_test_suite" {
          suite_result = {
            name: test_suite_name,
            total_tests: 0,
            passed_tests: 0,
            failed_tests: 0,
            duration: 0,
            details: {}
          }
          
          start_time = get_timestamp()
          
          switch test_suite_name {
            case "security_test_suite":
              suite_result = run_security_tests()
              break
            case "type_system_test_suite":
              suite_result = run_type_system_tests()
              break
            case "error_handling_test_suite":
              suite_result = run_error_handling_tests()
              break
            case "package_management_test_suite":
              suite_result = run_package_management_tests()
              break
            case "testing_framework_test_suite":
              suite_result = run_testing_framework_tests()
              break
            case "documentation_test_suite":
              suite_result = run_documentation_tests()
              break
            case "ide_integration_test_suite":
              suite_result = run_ide_integration_tests()
              break
            case "logging_test_suite":
              suite_result = run_logging_tests()
              break
            case "performance_test_suite":
              suite_result = run_performance_tests()
              break
            case "memory_management_test_suite":
              suite_result = run_memory_management_tests()
              break
            case "integration_test_suite":
              suite_result = run_integration_tests()
              break
          }
          
          suite_result.duration = get_timestamp() - start_time
        }
      }
    }
  }

  recipe "run_security_tests" {
    gives: security_test_result
    
    brain {
      plan {
        plan = { action: "test_security_components" }
      }
      
      execute {
        if plan.action == "test_security_components" {
          security_test_result = {
            name: "security_test_suite",
            total_tests: 0,
            passed_tests: 0,
            failed_tests: 0,
            details: {}
          }
          
          // Test 1: Authentication System
          auth_test = test_authentication_system()
          security_test_result.total_tests += auth_test.total_tests
          security_test_result.passed_tests += auth_test.passed_tests
          security_test_result.failed_tests += auth_test.failed_tests
          security_test_result.details.authentication = auth_test
          
          // Test 2: Authorization Framework
          authz_test = test_authorization_framework()
          security_test_result.total_tests += authz_test.total_tests
          security_test_result.passed_tests += authz_test.passed_tests
          security_test_result.failed_tests += authz_test.failed_tests
          security_test_result.details.authorization = authz_test
          
          // Test 3: Secure Communication
          comm_test = test_secure_communication()
          security_test_result.total_tests += comm_test.total_tests
          security_test_result.passed_tests += comm_test.passed_tests
          security_test_result.failed_tests += comm_test.failed_tests
          security_test_result.details.communication = comm_test
          
          // Test 4: JWT Token Validation
          jwt_test = test_jwt_token_validation()
          security_test_result.total_tests += jwt_test.total_tests
          security_test_result.passed_tests += jwt_test.passed_tests
          security_test_result.failed_tests += jwt_test.failed_tests
          security_test_result.details.jwt = jwt_test
          
          // Test 5: Password Hashing
          hash_test = test_password_hashing()
          security_test_result.total_tests += hash_test.total_tests
          security_test_result.passed_tests += hash_test.passed_tests
          security_test_result.failed_tests += hash_test.failed_tests
          security_test_result.details.hashing = hash_test
        }
      }
    }
  }

  recipe "test_authentication_system" {
    gives: auth_test_result
    
    brain {
      plan {
        plan = { action: "test_auth_system" }
      }
      
      execute {
        if plan.action == "test_auth_system" {
          auth_test_result = {
            total_tests: 0,
            passed_tests: 0,
            failed_tests: 0,
            details: {}
          }
          
          // Test user registration
          try {
            user_data = {
              username: "testuser",
              password: "securepassword123",
              email: "test@example.com"
            }
            
            registration_result = register_user(user_data)
            if registration_result.success {
              auth_test_result.passed_tests += 1
              auth_test_result.details.registration = "PASSED"
            } else {
              auth_test_result.failed_tests += 1
              auth_test_result.details.registration = "FAILED: " + registration_result.error
            }
            auth_test_result.total_tests += 1
            
          } catch error {
            auth_test_result.failed_tests += 1
            auth_test_result.details.registration = "FAILED: " + error
            auth_test_result.total_tests += 1
          }
          
          // Test user login
          try {
            login_data = {
              username: "testuser",
              password: "securepassword123"
            }
            
            login_result = authenticate_user(login_data)
            if login_result.success {
              auth_test_result.passed_tests += 1
              auth_test_result.details.login = "PASSED"
            } else {
              auth_test_result.failed_tests += 1
              auth_test_result.details.login = "FAILED: " + login_result.error
            }
            auth_test_result.total_tests += 1
            
          } catch error {
            auth_test_result.failed_tests += 1
            auth_test_result.details.login = "FAILED: " + error
            auth_test_result.total_tests += 1
          }
          
          // Test session management
          try {
            session_result = create_user_session("testuser")
            if session_result.success {
              auth_test_result.passed_tests += 1
              auth_test_result.details.session = "PASSED"
            } else {
              auth_test_result.failed_tests += 1
              auth_test_result.details.session = "FAILED: " + session_result.error
            }
            auth_test_result.total_tests += 1
            
          } catch error {
            auth_test_result.failed_tests += 1
            auth_test_result.details.session = "FAILED: " + error
            auth_test_result.total_tests += 1
          }
        }
      }
    }
  }

