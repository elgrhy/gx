helper "gx_error_handler" {
  can_do: ["error_handling", "stack_traces", "error_recovery", "error_logging", "exception_management"]
  
  remember {
    error_hierarchy = {
      GXError: {
        name: "GXError",
        message: "Base error class for all GX errors",
        recoverable: true
      },
      GXTypeError: {
        name: "GXTypeError", 
        message: "Type mismatch or invalid type operation",
        recoverable: true,
        parent: "GXError"
      },
      GXRuntimeError: {
        name: "GXRuntimeError",
        message: "Runtime execution error",
        recoverable: true,
        parent: "GXError"
      },
      GXMemoryError: {
        name: "GXMemoryError",
        message: "Memory allocation or access error",
        recoverable: false,
        parent: "GXError"
      },
      GXNetworkError: {
        name: "GXNetworkError",
        message: "Network communication error",
        recoverable: true,
        parent: "GXError"
      },
      GXSecurityError: {
        name: "GXSecurityError",
        message: "Security violation or authentication error",
        recoverable: false,
        parent: "GXError"
      },
      GXCompilationError: {
        name: "GXCompilationError",
        message: "Compilation or parsing error",
        recoverable: true,
        parent: "GXError"
      }
    }
    
    error_log = []
    error_recovery_strategies = {}
    stack_trace_cache = {}
    error_metrics = {
      total_errors: 0,
      errors_by_type: {},
      errors_by_severity: {},
      recovery_attempts: 0,
      successful_recoveries: 0
    }
    
    error_handling_config = {
      max_error_log_size: 10000,
      enable_stack_traces: true,
      enable_error_recovery: true,
      log_error_details: true,
      error_reporting_level: "detailed"
    }
  }

  receive {
    from "any_helper" as "error_event" {
      type: "error_occurred"
      bind: memory.error_event
      on_receive: brain.handle_error
    }
    
    from "runtime" as "recovery_request" {
      type: "error_recovery_request"
      bind: memory.recovery_request
      on_receive: brain.attempt_recovery
    }
    
    from "debugger" as "stack_trace_request" {
      type: "stack_trace_request"
      bind: memory.stack_trace_request
      on_receive: brain.generate_stack_trace
    }
  }

  brain {
    plan {
      if memory.error_event {
        plan = { action: "handle_error", error: memory.error_event }
      } else if memory.recovery_request {
        plan = { action: "attempt_recovery", request: memory.recovery_request }
      } else if memory.stack_trace_request {
        plan = { action: "generate_stack_trace", request: memory.stack_trace_request }
      } else {
        plan = { action: "idle_error_monitoring" }
      }
    }

    execute {
      if plan.action == "handle_error" {
        try {
          error = plan.error
          
          // Create error context
          error_context = create_error_context(error)
          
          // Generate stack trace if enabled
          if memory.error_handling_config.enable_stack_traces {
            stack_trace = generate_stack_trace_for_error(error)
            error_context.stack_trace = stack_trace
          }
          
          // Determine error type and severity
          error_type = determine_error_type(error)
          severity = determine_error_severity(error_type, error)
          
          // Log the error
          log_error(error_context, error_type, severity)
          
          // Update error metrics
          update_error_metrics(error_type, severity)
          
          // Attempt automatic recovery if enabled
          if memory.error_handling_config.enable_error_recovery {
            recovery_result = attempt_automatic_recovery(error_context)
            error_context.recovery_attempted = true
            error_context.recovery_successful = recovery_result.success
          }
          
          memory.error_handling_result = {
            error_id: error_context.error_id,
            handled: true,
            error_type: error_type,
            severity: severity,
            recovery_attempted: error_context.recovery_attempted,
            recovery_successful: error_context.recovery_successful
          }
          
        } catch error_handling_error {
          memory.error_handling_result = {
            handled: false,
            error: "Failed to handle error: " + error_handling_error
          }
        }
      } else if plan.action == "attempt_recovery" {
        try {
          request = plan.request
          error_id = request.error_id
          
          // Find the error in log
          error_entry = find_error_by_id(error_id)
          if error_entry {
            recovery_strategy = determine_recovery_strategy(error_entry)
            recovery_result = execute_recovery_strategy(recovery_strategy, error_entry)
            
            memory.recovery_result = {
              error_id: error_id,
              strategy_used: recovery_strategy.name,
              success: recovery_result.success,
              actions_taken: recovery_result.actions
            }
          } else {
            memory.recovery_result = {
              error_id: error_id,
              success: false,
              error: "Error not found in log"
            }
          }
          
        } catch recovery_error {
          memory.recovery_result = {
            error_id: request.error_id,
            success: false,
            error: "Recovery failed: " + recovery_error
          }
        }
      } else if plan.action == "generate_stack_trace" {
        try {
          request = plan.request
          helper_id = request.helper_id
          execution_context = request.execution_context
          
          stack_trace = generate_detailed_stack_trace(helper_id, execution_context)
          
          memory.stack_trace_result = {
            helper_id: helper_id,
            stack_trace: stack_trace,
            depth: stack_trace.length
          }
          
        } catch stack_trace_error {
          memory.stack_trace_result = {
            error: "Failed to generate stack trace: " + stack_trace_error
          }
        }
      } else if plan.action == "idle_error_monitoring" {
        // Clean up old error logs
        cleanup_old_error_logs()
        
        // Analyze error patterns
        analyze_error_patterns()
        
        // Update error statistics
        update_error_statistics()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
      
      // Update error handling metrics
      if memory.error_handling_result && memory.error_handling_result.handled {
        memory.error_metrics.total_errors += 1
      }
      
      if memory.recovery_result && memory.recovery_result.success {
        memory.error_metrics.successful_recoveries += 1
      }
    }

    communicate {
      if memory.error_handling_result {
        if memory.error_handling_result.handled {
          emit "error_handled" {
            error_id: memory.error_handling_result.error_id,
            error_type: memory.error_handling_result.error_type,
            severity: memory.error_handling_result.severity,
            recovery_attempted: memory.error_handling_result.recovery_attempted,
            recovery_successful: memory.error_handling_result.recovery_successful
          }
        } else {
          emit "error_handling_failed" {
            error: memory.error_handling_result.error
          }
        }
      }
      
      if memory.recovery_result {
        emit "recovery_result" {
          error_id: memory.recovery_result.error_id,
          strategy_used: memory.recovery_result.strategy_used,
          success: memory.recovery_result.success,
          actions_taken: memory.recovery_result.actions
        }
      }
      
      if memory.stack_trace_result {
        emit "stack_trace_generated" {
          helper_id: memory.stack_trace_result.helper_id,
          depth: memory.stack_trace_result.depth
        }
      }
    }
  }

  recipe "create_error_context" {
    needs: error
    gives: error_context
    
    brain {
      plan {
        plan = { action: "build_error_context" }
      }
      
      execute {
        if plan.action == "build_error_context" {
          error_context = {
            error_id: generate_error_id(),
            timestamp: get_timestamp(),
            message: error.message || "Unknown error",
            type: error.type || "GXError",
            helper_id: error.helper_id || "unknown",
            execution_cycle: error.execution_cycle || 0,
            memory_state: error.memory_state || {},
            execution_context: error.execution_context || {},
            severity: "medium",
            recoverable: true,
            stack_trace: null,
            recovery_attempted: false,
            recovery_successful: false
          }
        }
      }
    }
  }

  recipe "generate_stack_trace_for_error" {
    needs: error
    gives: stack_trace
    
    brain {
      plan {
        plan = { action: "capture_execution_stack" }
      }
      
      execute {
        if plan.action == "capture_execution_stack" {
          stack_trace = []
          
          // Get current execution context
          execution_context = error.execution_context || {}
          
          // Add error location
          stack_trace.push({
            level: 0,
            function: "error_occurred",
            file: error.file || "unknown",
            line: error.line || 0,
            column: error.column || 0,
            context: "Error occurred here"
          })
          
          // Add call stack
          if execution_context.call_stack {
            for each call in execution_context.call_stack {
              stack_trace.push({
                level: call.level,
                function: call.function,
                file: call.file,
                line: call.line,
                column: call.column,
                context: call.context
              })
            }
          }
          
          // Add brain cycle context
          if execution_context.brain_cycle {
            stack_trace.push({
              level: stack_trace.length,
              function: "brain_cycle",
              phase: execution_context.brain_cycle.phase,
              context: "Brain cycle execution"
            })
          }
        }
      }
    }
  }

  recipe "determine_error_type" {
    needs: error
    gives: error_type
    
    brain {
      plan {
        plan = { action: "classify_error" }
      }
      
      execute {
        if plan.action == "classify_error" {
          error_message = error.message.toLowerCase()
          
          if error_message.includes("type") || error_message.includes("type mismatch") {
            error_type = "GXTypeError"
          } else if error_message.includes("memory") || error_message.includes("allocation") {
            error_type = "GXMemoryError"
          } else if error_message.includes("network") || error_message.includes("connection") {
            error_type = "GXNetworkError"
          } else if error_message.includes("security") || error_message.includes("authentication") {
            error_type = "GXSecurityError"
          } else if error_message.includes("compilation") || error_message.includes("parse") {
            error_type = "GXCompilationError"
          } else if error_message.includes("runtime") || error_message.includes("execution") {
            error_type = "GXRuntimeError"
          } else {
            error_type = "GXError"
          }
        }
      }
    }
  }

  recipe "determine_error_severity" {
    needs: error_type, error
    gives: severity
    
    brain {
      plan {
        plan = { action: "assess_error_severity" }
      }
      
      execute {
        if plan.action == "assess_error_severity" {
          // Check error hierarchy for recoverability
          error_info = memory.error_hierarchy[error_type]
          if error_info && not error_info.recoverable {
            severity = "critical"
          } else {
            // Analyze error context for severity
            error_message = error.message.toLowerCase()
            
            if error_message.includes("fatal") || error_message.includes("critical") {
              severity = "critical"
            } else if error_message.includes("error") || error_message.includes("failed") {
              severity = "high"
            } else if error_message.includes("warning") || error_message.includes("deprecated") {
              severity = "medium"
            } else if error_message.includes("info") || error_message.includes("notice") {
              severity = "low"
            } else {
              severity = "medium"
            }
          }
        }
      }
    }
  }

  recipe "log_error" {
    needs: error_context, error_type, severity
    gives: void
    
    brain {
      plan {
        plan = { action: "record_error_in_log" }
      }
      
      execute {
        if plan.action == "record_error_in_log" {
          log_entry = {
            error_id: error_context.error_id,
            timestamp: error_context.timestamp,
            error_type: error_type,
            severity: severity,
            message: error_context.message,
            helper_id: error_context.helper_id,
            stack_trace: error_context.stack_trace,
            memory_state: error_context.memory_state,
            execution_context: error_context.execution_context
          }
          
          memory.error_log.push(log_entry)
          
          // Limit log size
          if memory.error_log.length > memory.error_handling_config.max_error_log_size {
            memory.error_log.shift()
          }
          
          // Log to console if configured
          if memory.error_handling_config.log_error_details {
            log("ERROR [" + severity.toUpperCase() + "] " + error_type + ": " + error_context.message)
            if error_context.stack_trace {
              log("Stack trace: " + JSON.stringify(error_context.stack_trace))
            }
          }
        }
      }
    }
  }

  recipe "attempt_automatic_recovery" {
    needs: error_context
    gives: recovery_result
    
    brain {
      plan {
        plan = { action: "execute_automatic_recovery" }
      }
      
      execute {
        if plan.action == "execute_automatic_recovery" {
          recovery_result = { success: false, actions: [] }
          
          // Determine recovery strategy based on error type
          strategy = determine_automatic_recovery_strategy(error_context)
          
          if strategy {
            try {
              // Execute recovery actions
              for each action in strategy.actions {
                action_result = execute_recovery_action(action, error_context)
                recovery_result.actions.push({
                  action: action.name,
                  success: action_result.success,
                  result: action_result.result
                })
              }
              
              // Check if recovery was successful
              recovery_result.success = strategy.actions.every(action => 
                recovery_result.actions.find(r => r.action == action.name).success
              )
              
            } catch recovery_error {
              recovery_result.actions.push({
                action: "recovery_execution",
                success: false,
                result: "Recovery failed: " + recovery_error
              })
            }
          }
        }
      }
    }
  }

  recipe "determine_automatic_recovery_strategy" {
    needs: error_context
    gives: strategy
    
    brain {
      plan {
        plan = { action: "select_recovery_strategy" }
      }
      
      execute {
        if plan.action == "select_recovery_strategy" {
          error_type = error_context.type
          
          if error_type == "GXTypeError" {
            strategy = {
              name: "type_error_recovery",
              actions: [
                { name: "retry_with_type_conversion", priority: 1 },
                { name: "fallback_to_default_type", priority: 2 }
              ]
            }
          } else if error_type == "GXNetworkError" {
            strategy = {
              name: "network_error_recovery",
              actions: [
                { name: "retry_connection", priority: 1 },
                { name: "use_cached_data", priority: 2 },
                { name: "switch_to_offline_mode", priority: 3 }
              ]
            }
          } else if error_type == "GXMemoryError" {
            strategy = {
              name: "memory_error_recovery",
              actions: [
                { name: "garbage_collection", priority: 1 },
                { name: "reduce_memory_usage", priority: 2 }
              ]
            }
          } else if error_type == "GXRuntimeError" {
            strategy = {
              name: "runtime_error_recovery",
              actions: [
                { name: "retry_operation", priority: 1 },
                { name: "skip_failed_operation", priority: 2 }
              ]
            }
          } else {
            strategy = {
              name: "generic_recovery",
              actions: [
                { name: "log_error_and_continue", priority: 1 }
              ]
            }
          }
        }
      }
    }
  }

  recipe "execute_recovery_action" {
    needs: action, error_context
    gives: action_result
    
    brain {
      plan {
        plan = { action: "perform_recovery_action" }
      }
      
      execute {
        if plan.action == "perform_recovery_action" {
          action_result = { success: false, result: "Action not implemented" }
          
          if action.name == "retry_with_type_conversion" {
            action_result = retry_with_type_conversion(error_context)
          } else if action.name == "fallback_to_default_type" {
            action_result = fallback_to_default_type(error_context)
          } else if action.name == "retry_connection" {
            action_result = retry_connection(error_context)
          } else if action.name == "use_cached_data" {
            action_result = use_cached_data(error_context)
          } else if action.name == "garbage_collection" {
            action_result = garbage_collection(error_context)
          } else if action.name == "reduce_memory_usage" {
            action_result = reduce_memory_usage(error_context)
          } else if action.name == "retry_operation" {
            action_result = retry_operation(error_context)
          } else if action.name == "skip_failed_operation" {
            action_result = skip_failed_operation(error_context)
          } else if action.name == "log_error_and_continue" {
            action_result = log_error_and_continue(error_context)
          }
        }
      }
    }
  }

  recipe "cleanup_old_error_logs" {
    brain {
      plan {
        plan = { action: "remove_old_entries" }
      }
      
      execute {
        if plan.action == "remove_old_entries" {
          current_time = get_timestamp()
          max_age = 24 * 60 * 60 * 1000  // 24 hours
          
          memory.error_log = memory.error_log.filter(entry => 
            current_time - entry.timestamp < max_age
          )
        }
      }
    }
  }

  recipe "analyze_error_patterns" {
    brain {
      plan {
        plan = { action: "identify_error_patterns" }
      }
      
      execute {
        if plan.action == "identify_error_patterns" {
          // Analyze recent errors for patterns
          recent_errors = memory.error_log.slice(-100)
          
          // Group by error type
          errors_by_type = {}
          for each error in recent_errors {
            if not errors_by_type[error.error_type] {
              errors_by_type[error.error_type] = 0
            }
            errors_by_type[error.error_type] += 1
          }
          
          // Identify frequent errors
          for each error_type in Object.keys(errors_by_type) {
            count = errors_by_type[error_type]
            if count > 10 {
              emit "error_pattern_detected" {
                error_type: error_type,
                frequency: count,
                pattern: "frequent_occurrence"
              }
            }
          }
        }
      }
    }
  }

  recipe "update_error_statistics" {
    brain {
      plan {
        plan = { action: "calculate_error_stats" }
      }
      
      execute {
        if plan.action == "calculate_error_stats" {
          // Update error metrics
          memory.error_metrics.total_errors = memory.error_log.length
          
          // Calculate errors by type
          for each error in memory.error_log {
            if not memory.error_metrics.errors_by_type[error.error_type] {
              memory.error_metrics.errors_by_type[error.error_type] = 0
            }
            memory.error_metrics.errors_by_type[error.error_type] += 1
          }
          
          // Calculate errors by severity
          for each error in memory.error_log {
            if not memory.error_metrics.errors_by_severity[error.severity] {
              memory.error_metrics.errors_by_severity[error.severity] = 0
            }
            memory.error_metrics.errors_by_severity[error.severity] += 1
          }
        }
      }
    }
  }
} 