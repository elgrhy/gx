helper "gx_garbage_collector" {
  can_do: ["garbage_collection", "memory_management", "memory_profiling", "leak_detection", "memory_optimization"]
  
  remember {
    gc_config = {
      enable_gc: true,
      gc_algorithm: "mark_and_sweep",
      gc_threshold: 0.8,  // 80% memory usage
      gc_interval: 30000,  // 30 seconds
      enable_incremental_gc: true,
      enable_concurrent_gc: true,
      memory_limit: 100 * 1024 * 1024  // 100MB
    }
    
    memory_map = {}
    object_references = {}
    gc_metrics = {
      total_collections: 0,
      total_objects_freed: 0,
      total_memory_freed: 0,
      average_collection_time: 0,
      memory_usage_history: []
    }
    
    gc_algorithms = {
      mark_and_sweep: true,
      generational: true,
      reference_counting: false,
      copying: false
    }
  }

  receive {
    from "memory_manager" as "gc_request" {
      type: "garbage_collection_request"
      bind: memory.gc_request
      on_receive: brain.perform_garbage_collection
    }
    
    from "memory_profiler" as "memory_usage" {
      type: "memory_usage_update"
      bind: memory.memory_usage
      on_receive: brain.monitor_memory_usage
    }
    
    from "leak_detector" as "leak_report" {
      type: "memory_leak_detected"
      bind: memory.leak_report
      on_receive: brain.handle_memory_leak
    }
  }

  brain {
    plan {
      if memory.gc_request {
        plan = { action: "perform_garbage_collection", request: memory.gc_request }
      } else if memory.memory_usage {
        plan = { action: "monitor_memory_usage", usage: memory.memory_usage }
      } else if memory.leak_report {
        plan = { action: "handle_memory_leak", leak: memory.leak_report }
      } else {
        plan = { action: "idle_gc_maintenance" }
      }
    }

    execute {
      if plan.action == "perform_garbage_collection" {
        try {
          request = plan.request
          gc_type = request.type || "automatic"
          
          // Start garbage collection
          gc_start_time = get_timestamp()
          
          // Perform garbage collection based on algorithm
          if memory.gc_config.gc_algorithm == "mark_and_sweep" {
            gc_result = perform_mark_and_sweep()
          } else if memory.gc_config.gc_algorithm == "generational" {
            gc_result = perform_generational_gc()
          } else if memory.gc_config.gc_algorithm == "reference_counting" {
            gc_result = perform_reference_counting_gc()
          } else {
            gc_result = perform_copying_gc()
          }
          
          gc_duration = get_timestamp() - gc_start_time
          
          // Update metrics
          memory.gc_metrics.total_collections += 1
          memory.gc_metrics.total_objects_freed += gc_result.objects_freed
          memory.gc_metrics.total_memory_freed += gc_result.memory_freed
          memory.gc_metrics.average_collection_time = 
            (memory.gc_metrics.average_collection_time * (memory.gc_metrics.total_collections - 1) + gc_duration) / 
            memory.gc_metrics.total_collections
          
          memory.gc_result = {
            success: true,
            gc_type: gc_type,
            objects_freed: gc_result.objects_freed,
            memory_freed: gc_result.memory_freed,
            duration: gc_duration,
            algorithm: memory.gc_config.gc_algorithm
          }
          
        } catch gc_error {
          memory.gc_result = {
            success: false,
            error: "Garbage collection failed: " + gc_error
          }
        }
      } else if plan.action == "monitor_memory_usage" {
        try {
          usage = plan.usage
          
          // Update memory usage history
          memory.gc_metrics.memory_usage_history.push({
            timestamp: get_timestamp(),
            usage_percentage: usage.usage_percentage,
            total_memory: usage.total_memory,
            used_memory: usage.used_memory,
            free_memory: usage.free_memory
          })
          
          // Keep only last 100 entries
          if memory.gc_metrics.memory_usage_history.length > 100 {
            memory.gc_metrics.memory_usage_history.shift()
          }
          
          // Check if garbage collection is needed
          if usage.usage_percentage > memory.gc_config.gc_threshold {
            emit "gc_threshold_exceeded" {
              current_usage: usage.usage_percentage,
              threshold: memory.gc_config.gc_threshold
            }
          }
          
          // Check for memory leaks
          detect_memory_leaks(usage)
          
        } catch monitoring_error {
          log("Memory monitoring failed: " + monitoring_error)
        }
      } else if plan.action == "handle_memory_leak" {
        try {
          leak = plan.leak
          
          // Analyze memory leak
          leak_analysis = analyze_memory_leak(leak)
          
          // Attempt to fix memory leak
          fix_result = attempt_leak_fix(leak_analysis)
          
          memory.leak_handling_result = {
            leak_id: leak.id,
            leak_type: leak.type,
            objects_involved: leak.objects_involved,
            memory_lost: leak.memory_lost,
            analysis: leak_analysis,
            fix_applied: fix_result.success,
            fix_description: fix_result.description
          }
          
        } catch leak_error {
          memory.leak_handling_result = {
            error: "Memory leak handling failed: " + leak_error
          }
        }
      } else if plan.action == "idle_gc_maintenance" {
        // Update memory map
        update_memory_map()
        
        // Clean up old references
        cleanup_old_references()
        
        // Update GC statistics
        update_gc_statistics()
        
        // Check for memory fragmentation
        check_memory_fragmentation()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      if memory.gc_result {
        if memory.gc_result.success {
          emit "garbage_collection_complete" {
            gc_type: memory.gc_result.gc_type,
            objects_freed: memory.gc_result.objects_freed,
            memory_freed: memory.gc_result.memory_freed,
            duration: memory.gc_result.duration
          }
        } else {
          emit "garbage_collection_failed" {
            error: memory.gc_result.error
          }
        }
      }
      
      if memory.leak_handling_result {
        emit "memory_leak_handled" {
          leak_id: memory.leak_handling_result.leak_id,
          fix_applied: memory.leak_handling_result.fix_applied
        }
      }
    }
  }

  recipe "perform_mark_and_sweep" {
    gives: gc_result
    
    brain {
      plan {
        plan = { action: "execute_mark_and_sweep" }
      }
      
      execute {
        if plan.action == "execute_mark_and_sweep" {
          gc_result = {
            objects_freed: 0,
            memory_freed: 0,
            mark_phase_time: 0,
            sweep_phase_time: 0
          }
          
          // Mark phase - identify reachable objects
          mark_start_time = get_timestamp()
          reachable_objects = mark_reachable_objects()
          gc_result.mark_phase_time = get_timestamp() - mark_start_time
          
          // Sweep phase - free unreachable objects
          sweep_start_time = get_timestamp()
          freed_objects = sweep_unreachable_objects(reachable_objects)
          gc_result.sweep_phase_time = get_timestamp() - sweep_start_time
          
          gc_result.objects_freed = freed_objects.count
          gc_result.memory_freed = freed_objects.memory
        }
      }
    }
  }

  recipe "mark_reachable_objects" {
    gives: reachable_objects
    
    brain {
      plan {
        plan = { action: "identify_reachable_objects" }
      }
      
      execute {
        if plan.action == "identify_reachable_objects" {
          reachable_objects = new Set()
          
          // Start from root objects
          root_objects = get_root_objects()
          
          // Use depth-first search to mark all reachable objects
          for each root in root_objects {
            mark_object_and_children(root, reachable_objects)
          }
        }
      }
    }
  }

  recipe "mark_object_and_children" {
    needs: object, reachable_objects
    gives: void
    
    brain {
      plan {
        plan = { action: "mark_object_recursively" }
      }
      
      execute {
        if plan.action == "mark_object_recursively" {
          // Mark current object
          reachable_objects.add(object.id)
          
          // Mark all children
          children = get_object_children(object)
          for each child in children {
            if not reachable_objects.has(child.id) {
              mark_object_and_children(child, reachable_objects)
            }
          }
        }
      }
    }
  }

  recipe "sweep_unreachable_objects" {
    needs: reachable_objects
    gives: freed_objects
    
    brain {
      plan {
        plan = { action: "free_unreachable_objects" }
      }
      
      execute {
        if plan.action == "free_unreachable_objects" {
          freed_objects = {
            count: 0,
            memory: 0,
            object_ids: []
          }
          
          // Iterate through all objects in memory
          for each object_id in Object.keys(memory.memory_map) {
            if not reachable_objects.has(object_id) {
              // Free unreachable object
              object = memory.memory_map[object_id]
              freed_objects.count += 1
              freed_objects.memory += object.size
              freed_objects.object_ids.push(object_id)
              
              // Remove from memory map
              memory.memory_map[object_id] = null
              
              // Remove references
              remove_object_references(object_id)
            }
          }
        }
      }
    }
  }

  recipe "perform_generational_gc" {
    gives: gc_result
    
    brain {
      plan {
        plan = { action: "execute_generational_gc" }
      }
      
      execute {
        if plan.action == "execute_generational_gc" {
          gc_result = {
            objects_freed: 0,
            memory_freed: 0,
            young_gen_collections: 0,
            old_gen_collections: 0
          }
          
          // Young generation collection (frequent, fast)
          young_gen_result = collect_young_generation()
          gc_result.objects_freed += young_gen_result.objects_freed
          gc_result.memory_freed += young_gen_result.memory_freed
          gc_result.young_gen_collections += 1
          
          // Old generation collection (less frequent, thorough)
          if should_collect_old_generation() {
            old_gen_result = collect_old_generation()
            gc_result.objects_freed += old_gen_result.objects_freed
            gc_result.memory_freed += old_gen_result.memory_freed
            gc_result.old_gen_collections += 1
          }
        }
      }
    }
  }

  recipe "collect_young_generation" {
    gives: young_gen_result
    
    brain {
      plan {
        plan = { action: "collect_young_objects" }
      }
      
      execute {
        if plan.action == "collect_young_objects" {
          young_gen_result = {
            objects_freed: 0,
            memory_freed: 0
          }
          
          // Get young generation objects
          young_objects = get_young_generation_objects()
          
          // Mark reachable objects in young generation
          reachable_young = mark_reachable_objects_in_generation(young_objects)
          
          // Free unreachable young objects
          for each object_id in Object.keys(young_objects) {
            if not reachable_young.has(object_id) {
              object = young_objects[object_id]
              young_gen_result.objects_freed += 1
              young_gen_result.memory_freed += object.size
              
              // Free the object
              memory.memory_map[object_id] = null
            } else {
              // Promote to old generation
              promote_to_old_generation(object_id)
            }
          }
        }
      }
    }
  }

  recipe "collect_old_generation" {
    gives: old_gen_result
    
    brain {
      plan {
        plan = { action: "collect_old_objects" }
      }
      
      execute {
        if plan.action == "collect_old_objects" {
          old_gen_result = {
            objects_freed: 0,
            memory_freed: 0
          }
          
          // Get old generation objects
          old_objects = get_old_generation_objects()
          
          // Perform full mark and sweep on old generation
          reachable_old = mark_reachable_objects_in_generation(old_objects)
          
          // Free unreachable old objects
          for each object_id in Object.keys(old_objects) {
            if not reachable_old.has(object_id) {
              object = old_objects[object_id]
              old_gen_result.objects_freed += 1
              old_gen_result.memory_freed += object.size
              
              // Free the object
              memory.memory_map[object_id] = null
            }
          }
        }
      }
    }
  }

  recipe "detect_memory_leaks" {
    needs: usage
    gives: void
    
    brain {
      plan {
        plan = { action: "analyze_memory_patterns" }
      }
      
      execute {
        if plan.action == "analyze_memory_patterns" {
          // Analyze memory usage history for patterns
          if memory.gc_metrics.memory_usage_history.length > 10 {
            recent_usage = memory.gc_metrics.memory_usage_history.slice(-10)
            
            // Check for continuous memory growth
            continuous_growth = check_continuous_memory_growth(recent_usage)
            if continuous_growth {
              emit "potential_memory_leak" {
                pattern: "continuous_growth",
                growth_rate: calculate_memory_growth_rate(recent_usage)
              }
            }
            
            // Check for memory not being freed after GC
            gc_ineffectiveness = check_gc_ineffectiveness(recent_usage)
            if gc_ineffectiveness {
              emit "gc_ineffective" {
                pattern: "memory_not_freed",
                retention_rate: calculate_memory_retention_rate(recent_usage)
              }
            }
          }
        }
      }
    }
  }

  recipe "analyze_memory_leak" {
    needs: leak
    gives: leak_analysis
    
    brain {
      plan {
        plan = { action: "analyze_leak_pattern" }
      }
      
      execute {
        if plan.action == "analyze_leak_pattern" {
          leak_analysis = {
            leak_type: leak.type,
            root_cause: "unknown",
            affected_objects: [],
            memory_impact: 0,
            suggested_fixes: []
          }
          
          // Analyze leak type
          switch leak.type {
            case "circular_reference":
              leak_analysis.root_cause = "Circular references preventing garbage collection"
              leak_analysis.suggested_fixes.push("Break circular references")
              leak_analysis.suggested_fixes.push("Use weak references")
              break
              
            case "event_listener":
              leak_analysis.root_cause = "Event listeners not properly removed"
              leak_analysis.suggested_fixes.push("Remove event listeners on cleanup")
              leak_analysis.suggested_fixes.push("Use weak event listeners")
              break
              
            case "cache_overflow":
              leak_analysis.root_cause = "Cache growing without bounds"
              leak_analysis.suggested_fixes.push("Implement cache size limits")
              leak_analysis.suggested_fixes.push("Add cache eviction policies")
              break
              
            case "timer_accumulation":
              leak_analysis.root_cause = "Timers not being cleared"
              leak_analysis.suggested_fixes.push("Clear timers on cleanup")
              leak_analysis.suggested_fixes.push("Use timer pools")
              break
          }
          
          // Calculate memory impact
          leak_analysis.memory_impact = calculate_leak_memory_impact(leak)
          
          // Identify affected objects
          leak_analysis.affected_objects = identify_leak_affected_objects(leak)
        }
      }
    }
  }

  recipe "attempt_leak_fix" {
    needs: leak_analysis
    gives: fix_result
    
    brain {
      plan {
        plan = { action: "apply_leak_fix" }
      }
      
      execute {
        if plan.action == "apply_leak_fix" {
          fix_result = {
            success: false,
            description: "No fix applied",
            objects_freed: 0,
            memory_freed: 0
          }
          
          switch leak_analysis.leak_type {
            case "circular_reference":
              fix_result = fix_circular_references(leak_analysis.affected_objects)
              break
              
            case "event_listener":
              fix_result = fix_event_listener_leaks(leak_analysis.affected_objects)
              break
              
            case "cache_overflow":
              fix_result = fix_cache_overflow(leak_analysis.affected_objects)
              break
              
            case "timer_accumulation":
              fix_result = fix_timer_accumulation(leak_analysis.affected_objects)
              break
              
            default:
              fix_result.description = "Unknown leak type, no fix available"
          }
        }
      }
    }
  }

  recipe "update_memory_map" {
    brain {
      plan {
        plan = { action: "refresh_memory_map" }
      }
      
      execute {
        if plan.action == "refresh_memory_map" {
          // Update memory map with current objects
          current_objects = get_all_objects()
          
          for each object_id in Object.keys(current_objects) {
            object = current_objects[object_id]
            memory.memory_map[object_id] = {
              id: object_id,
              type: object.type,
              size: calculate_object_size(object),
              references: get_object_references(object_id),
              created_at: object.created_at || get_timestamp(),
              last_accessed: object.last_accessed || get_timestamp()
            }
          }
        }
      }
    }
  }

  recipe "cleanup_old_references" {
    brain {
      plan {
        plan = { action: "remove_stale_references" }
      }
      
      execute {
        if plan.action == "remove_stale_references" {
          current_time = get_timestamp()
          max_age = 24 * 60 * 60 * 1000  // 24 hours
          
          for each object_id in Object.keys(memory.object_references) {
            reference = memory.object_references[object_id]
            
            if current_time - reference.last_accessed > max_age {
              // Remove stale reference
              memory.object_references[object_id] = null
            }
          }
        }
      }
    }
  }

  recipe "update_gc_statistics" {
    brain {
      plan {
        plan = { action: "calculate_gc_stats" }
      }
      
      execute {
        if plan.action == "calculate_gc_stats" {
          // Calculate collection frequency
          if memory.gc_metrics.total_collections > 0 {
            memory.gc_metrics.collection_frequency = 
              memory.gc_metrics.total_collections / (get_timestamp() - memory.gc_metrics.start_time)
          }
          
          // Calculate memory efficiency
          if memory.gc_metrics.total_memory_freed > 0 {
            memory.gc_metrics.memory_efficiency = 
              memory.gc_metrics.total_memory_freed / memory.gc_metrics.total_objects_freed
          }
          
          // Calculate GC overhead
          total_gc_time = memory.gc_metrics.average_collection_time * memory.gc_metrics.total_collections
          total_runtime = get_timestamp() - memory.gc_metrics.start_time
          memory.gc_metrics.gc_overhead = (total_gc_time / total_runtime) * 100
        }
      }
    }
  }

  recipe "check_memory_fragmentation" {
    brain {
      plan {
        plan = { action: "analyze_memory_fragmentation" }
      }
      
      execute {
        if plan.action == "analyze_memory_fragmentation" {
          // Analyze memory fragmentation
          fragmentation_analysis = analyze_memory_fragmentation()
          
          if fragmentation_analysis.fragmentation_level > 0.3 {
            emit "high_memory_fragmentation" {
              fragmentation_level: fragmentation_analysis.fragmentation_level,
              suggested_action: "Perform memory compaction"
            }
          }
          
          // Update fragmentation metrics
          memory.gc_metrics.fragmentation_level = fragmentation_analysis.fragmentation_level
          memory.gc_metrics.free_blocks = fragmentation_analysis.free_blocks
          memory.gc_metrics.largest_free_block = fragmentation_analysis.largest_free_block
        }
      }
    }
  }
} 