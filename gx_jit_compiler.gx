helper "gx_jit_compiler" {
  can_do: ["jit_compilation", "hot_code_optimization", "runtime_optimization", "performance_profiling", "adaptive_optimization"]
  
  remember {
    jit_config = {
      enable_jit: true,
      optimization_level: "production",
      hot_path_threshold: 1000,
      max_optimization_passes: 5,
      enable_inlining: true,
      enable_loop_optimization: true,
      enable_dead_code_elimination: true
    }
    
    compiled_functions = {}
    hot_paths = {}
    optimization_cache = {}
    performance_metrics = {
      functions_compiled: 0,
      optimization_passes: 0,
      performance_improvements: {},
      compilation_time: 0
    }
    
    optimization_strategies = {
      constant_folding: true,
      dead_code_elimination: true,
      loop_unrolling: true,
      function_inlining: true,
      register_allocation: true,
      instruction_combining: true
    }
  }

  receive {
    from "runtime" as "jit_request" {
      type: "jit_compilation_request"
      bind: memory.jit_request
      on_receive: brain.compile_function
    }
    
    from "profiler" as "hot_path_data" {
      type: "hot_path_detection"
      bind: memory.hot_path_data
      on_receive: brain.optimize_hot_paths
    }
    
    from "optimizer" as "optimization_request" {
      type: "runtime_optimization"
      bind: memory.optimization_request
      on_receive: brain.apply_runtime_optimizations
    }
  }

  brain {
    plan {
      if memory.jit_request {
        plan = { action: "compile_function", request: memory.jit_request }
      } else if memory.hot_path_data {
        plan = { action: "optimize_hot_paths", data: memory.hot_path_data }
      } else if memory.optimization_request {
        plan = { action: "apply_runtime_optimizations", request: memory.optimization_request }
      } else {
        plan = { action: "idle_jit_maintenance" }
      }
    }

    execute {
      if plan.action == "compile_function" {
        try {
          request = plan.jit_request
          function_ast = request.function_ast
          execution_count = request.execution_count || 0
          
          // Check if function should be JIT compiled
          if should_jit_compile(function_ast, execution_count) {
            // Compile function to optimized bytecode
            compiled_function = compile_function_to_bytecode(function_ast)
            
            // Apply optimizations
            optimized_function = apply_jit_optimizations(compiled_function)
            
            // Store compiled function
            memory.compiled_functions[function_ast.name] = {
              bytecode: optimized_function,
              compilation_time: get_timestamp(),
              optimization_level: memory.jit_config.optimization_level,
              execution_count: execution_count
            }
            
            memory.jit_compilation_result = {
              success: true,
              function_name: function_ast.name,
              compilation_time: get_timestamp() - request.start_time,
              optimization_passes: optimized_function.optimization_passes,
              performance_gain: calculate_performance_gain(optimized_function)
            }
          } else {
            memory.jit_compilation_result = {
              success: false,
              reason: "Function does not meet JIT compilation criteria"
            }
          }
          
        } catch compilation_error {
          memory.jit_compilation_result = {
            success: false,
            error: "JIT compilation failed: " + compilation_error
          }
        }
      } else if plan.action == "optimize_hot_paths" {
        try {
          data = plan.data
          hot_paths = data.hot_paths
          
          // Identify hot paths
          for each path in hot_paths {
            if path.execution_count > memory.jit_config.hot_path_threshold {
              // Apply aggressive optimizations to hot paths
              optimized_path = optimize_hot_path(path)
              
              memory.hot_paths[path.id] = {
                original_path: path,
                optimized_path: optimized_path,
                optimization_applied: get_timestamp()
              }
            }
          }
          
          memory.hot_path_optimization_result = {
            hot_paths_optimized: Object.keys(memory.hot_paths).length,
            total_hot_paths: hot_paths.length
          }
          
        } catch optimization_error {
          memory.hot_path_optimization_result = {
            error: "Hot path optimization failed: " + optimization_error
          }
        }
      } else if plan.action == "apply_runtime_optimizations" {
        try {
          request = plan.optimization_request
          target_function = request.target_function
          optimization_type = request.optimization_type
          
          // Apply specific runtime optimization
          optimization_result = apply_runtime_optimization(target_function, optimization_type)
          
          memory.runtime_optimization_result = {
            function_name: target_function,
            optimization_type: optimization_type,
            success: optimization_result.success,
            performance_improvement: optimization_result.improvement
          }
          
        } catch runtime_error {
          memory.runtime_optimization_result = {
            error: "Runtime optimization failed: " + runtime_error
          }
        }
      } else if plan.action == "idle_jit_maintenance" {
        // Clean up old compiled functions
        cleanup_old_compiled_functions()
        
        // Update performance metrics
        update_jit_metrics()
        
        // Analyze optimization effectiveness
        analyze_optimization_effectiveness()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
      
      // Update JIT metrics
      if memory.jit_compilation_result && memory.jit_compilation_result.success {
        memory.performance_metrics.functions_compiled += 1
        memory.performance_metrics.compilation_time += memory.jit_compilation_result.compilation_time
      }
    }

    communicate {
      if memory.jit_compilation_result {
        if memory.jit_compilation_result.success {
          emit "jit_compilation_success" {
            function_name: memory.jit_compilation_result.function_name,
            compilation_time: memory.jit_compilation_result.compilation_time,
            performance_gain: memory.jit_compilation_result.performance_gain
          }
        } else {
          emit "jit_compilation_failed" {
            function_name: memory.jit_request.function_ast.name,
            error: memory.jit_compilation_result.error
          }
        }
      }
      
      if memory.hot_path_optimization_result {
        emit "hot_path_optimization_complete" {
          hot_paths_optimized: memory.hot_path_optimization_result.hot_paths_optimized,
          total_hot_paths: memory.hot_path_optimization_result.total_hot_paths
        }
      }
      
      if memory.runtime_optimization_result {
        emit "runtime_optimization_applied" {
          function_name: memory.runtime_optimization_result.function_name,
          optimization_type: memory.runtime_optimization_result.optimization_type,
          performance_improvement: memory.runtime_optimization_result.performance_improvement
        }
      }
    }
  }

  recipe "should_jit_compile" {
    needs: function_ast, execution_count
    gives: should_compile
    
    brain {
      plan {
        plan = { action: "evaluate_jit_criteria" }
      }
      
      execute {
        if plan.action == "evaluate_jit_criteria" {
          should_compile = false
          
          // Check if JIT is enabled
          if not memory.jit_config.enable_jit {
            return
          }
          
          // Check execution count threshold
          if execution_count >= memory.jit_config.hot_path_threshold {
            should_compile = true
          }
          
          // Check function complexity
          complexity_score = calculate_function_complexity(function_ast)
          if complexity_score > 10 {
            should_compile = true
          }
          
          // Check if function is in hot path
          if is_in_hot_path(function_ast.name) {
            should_compile = true
          }
          
          // Check optimization potential
          optimization_potential = estimate_optimization_potential(function_ast)
          if optimization_potential > 0.3 {
            should_compile = true
          }
        }
      }
    }
  }

  recipe "compile_function_to_bytecode" {
    needs: function_ast
    gives: compiled_function
    
    brain {
      plan {
        plan = { action: "generate_optimized_bytecode" }
      }
      
      execute {
        if plan.action == "generate_optimized_bytecode" {
          compiled_function = {
            name: function_ast.name,
            bytecode: [],
            symbol_table: {},
            optimization_passes: 0,
            compilation_time: get_timestamp()
          }
          
          // Parse function body
          function_body = function_ast.body
          
          // Generate bytecode for each statement
          for each statement in function_body {
            statement_bytecode = generate_statement_bytecode(statement)
            compiled_function.bytecode.push(...statement_bytecode)
          }
          
          // Build symbol table
          compiled_function.symbol_table = build_symbol_table(function_ast)
          
          // Apply basic optimizations
          compiled_function.bytecode = apply_basic_optimizations(compiled_function.bytecode)
          compiled_function.optimization_passes += 1
        }
      }
    }
  }

  recipe "apply_jit_optimizations" {
    needs: compiled_function
    gives: optimized_function
    
    brain {
      plan {
        plan = { action: "apply_advanced_optimizations" }
      }
      
      execute {
        if plan.action == "apply_advanced_optimizations" {
          optimized_function = { ...compiled_function }
          
          // Apply constant folding
          if memory.optimization_strategies.constant_folding {
            optimized_function.bytecode = apply_constant_folding(optimized_function.bytecode)
            optimized_function.optimization_passes += 1
          }
          
          // Apply dead code elimination
          if memory.optimization_strategies.dead_code_elimination {
            optimized_function.bytecode = apply_dead_code_elimination(optimized_function.bytecode)
            optimized_function.optimization_passes += 1
          }
          
          // Apply loop optimization
          if memory.optimization_strategies.loop_unrolling {
            optimized_function.bytecode = apply_loop_optimization(optimized_function.bytecode)
            optimized_function.optimization_passes += 1
          }
          
          // Apply function inlining
          if memory.optimization_strategies.function_inlining {
            optimized_function.bytecode = apply_function_inlining(optimized_function.bytecode)
            optimized_function.optimization_passes += 1
          }
          
          // Apply register allocation
          if memory.optimization_strategies.register_allocation {
            optimized_function.bytecode = apply_register_allocation(optimized_function.bytecode)
            optimized_function.optimization_passes += 1
          }
          
          // Apply instruction combining
          if memory.optimization_strategies.instruction_combining {
            optimized_function.bytecode = apply_instruction_combining(optimized_function.bytecode)
            optimized_function.optimization_passes += 1
          }
        }
      }
    }
  }

  recipe "optimize_hot_path" {
    needs: hot_path
    gives: optimized_path
    
    brain {
      plan {
        plan = { action: "apply_hot_path_optimizations" }
      }
      
      execute {
        if plan.action == "apply_hot_path_optimizations" {
          optimized_path = {
            id: hot_path.id,
            original_bytecode: hot_path.bytecode,
            optimized_bytecode: [],
            optimizations_applied: [],
            performance_gain: 0
          }
          
          // Apply aggressive optimizations for hot paths
          bytecode = hot_path.bytecode
          
          // Loop unrolling
          bytecode = apply_aggressive_loop_unrolling(bytecode)
          optimized_path.optimizations_applied.push("aggressive_loop_unrolling")
          
          // Function inlining
          bytecode = apply_aggressive_function_inlining(bytecode)
          optimized_path.optimizations_applied.push("aggressive_function_inlining")
          
          // Register allocation
          bytecode = apply_advanced_register_allocation(bytecode)
          optimized_path.optimizations_applied.push("advanced_register_allocation")
          
          // Instruction scheduling
          bytecode = apply_instruction_scheduling(bytecode)
          optimized_path.optimizations_applied.push("instruction_scheduling")
          
          // Branch prediction
          bytecode = apply_branch_prediction(bytecode)
          optimized_path.optimizations_applied.push("branch_prediction")
          
          optimized_path.optimized_bytecode = bytecode
          optimized_path.performance_gain = calculate_hot_path_performance_gain(hot_path, optimized_path)
        }
      }
    }
  }

  recipe "apply_runtime_optimization" {
    needs: target_function, optimization_type
    gives: optimization_result
    
    brain {
      plan {
        plan = { action: "apply_specific_optimization" }
      }
      
      execute {
        if plan.action == "apply_specific_optimization" {
          optimization_result = {
            success: false,
            improvement: 0,
            applied_optimizations: []
          }
          
          if memory.compiled_functions[target_function] {
            compiled_function = memory.compiled_functions[target_function]
            
            switch optimization_type {
              case "constant_folding":
                optimized_bytecode = apply_constant_folding(compiled_function.bytecode)
                optimization_result.success = true
                optimization_result.applied_optimizations.push("constant_folding")
                break
                
              case "dead_code_elimination":
                optimized_bytecode = apply_dead_code_elimination(compiled_function.bytecode)
                optimization_result.success = true
                optimization_result.applied_optimizations.push("dead_code_elimination")
                break
                
              case "loop_optimization":
                optimized_bytecode = apply_loop_optimization(compiled_function.bytecode)
                optimization_result.success = true
                optimization_result.applied_optimizations.push("loop_optimization")
                break
                
              case "function_inlining":
                optimized_bytecode = apply_function_inlining(compiled_function.bytecode)
                optimization_result.success = true
                optimization_result.applied_optimizations.push("function_inlining")
                break
                
              case "register_allocation":
                optimized_bytecode = apply_register_allocation(compiled_function.bytecode)
                optimization_result.success = true
                optimization_result.applied_optimizations.push("register_allocation")
                break
                
              default:
                optimization_result.success = false
                optimization_result.error = "Unknown optimization type: " + optimization_type
            }
            
            if optimization_result.success {
              // Update compiled function
              memory.compiled_functions[target_function].bytecode = optimized_bytecode
              memory.compiled_functions[target_function].optimization_passes += 1
              
              // Calculate performance improvement
              optimization_result.improvement = calculate_optimization_improvement(
                compiled_function.bytecode,
                optimized_bytecode
              )
            }
          } else {
            optimization_result.success = false
            optimization_result.error = "Function not found: " + target_function
          }
        }
      }
    }
  }

  recipe "calculate_performance_gain" {
    needs: optimized_function
    gives: performance_gain
    
    brain {
      plan {
        plan = { action: "measure_performance_improvement" }
      }
      
      execute {
        if plan.action == "measure_performance_improvement" {
          // Calculate performance gain based on optimization passes
          base_performance = 1.0
          optimization_multiplier = 1.0
          
          for each pass in optimized_function.optimization_passes {
            switch pass {
              case "constant_folding":
                optimization_multiplier *= 1.1
                break
              case "dead_code_elimination":
                optimization_multiplier *= 1.15
                break
              case "loop_unrolling":
                optimization_multiplier *= 1.2
                break
              case "function_inlining":
                optimization_multiplier *= 1.25
                break
              case "register_allocation":
                optimization_multiplier *= 1.1
                break
              case "instruction_combining":
                optimization_multiplier *= 1.05
                break
            }
          }
          
          performance_gain = ((optimization_multiplier - base_performance) / base_performance) * 100
        }
      }
    }
  }

  recipe "cleanup_old_compiled_functions" {
    brain {
      plan {
        plan = { action: "remove_old_functions" }
      }
      
      execute {
        if plan.action == "remove_old_functions" {
          current_time = get_timestamp()
          max_age = 24 * 60 * 60 * 1000  // 24 hours
          
          for each function_name in Object.keys(memory.compiled_functions) {
            compiled_function = memory.compiled_functions[function_name]
            
            if current_time - compiled_function.compilation_time > max_age {
              // Check if function is still being used
              if not is_function_frequently_used(function_name) {
                memory.compiled_functions[function_name] = null
                log("Removed old compiled function: " + function_name)
              }
            }
          }
        }
      }
    }
  }

  recipe "update_jit_metrics" {
    brain {
      plan {
        plan = { action: "calculate_jit_metrics" }
      }
      
      execute {
        if plan.action == "calculate_jit_metrics" {
          // Calculate average compilation time
          if memory.performance_metrics.functions_compiled > 0 {
            memory.performance_metrics.average_compilation_time = 
              memory.performance_metrics.compilation_time / memory.performance_metrics.functions_compiled
          }
          
          // Calculate optimization effectiveness
          total_improvements = 0
          improvement_count = 0
          
          for each function_name in Object.keys(memory.compiled_functions) {
            compiled_function = memory.compiled_functions[function_name]
            if compiled_function.performance_gain {
              total_improvements += compiled_function.performance_gain
              improvement_count += 1
            }
          }
          
          if improvement_count > 0 {
            memory.performance_metrics.average_performance_gain = total_improvements / improvement_count
          }
        }
      }
    }
  }

  recipe "analyze_optimization_effectiveness" {
    brain {
      plan {
        plan = { action: "evaluate_optimizations" }
      }
      
      execute {
        if plan.action == "evaluate_optimizations" {
          // Analyze which optimizations are most effective
          optimization_effectiveness = {}
          
          for each function_name in Object.keys(memory.compiled_functions) {
            compiled_function = memory.compiled_functions[function_name]
            
            for each optimization in compiled_function.optimizations_applied {
              if not optimization_effectiveness[optimization] {
                optimization_effectiveness[optimization] = {
                  count: 0,
                  total_gain: 0
                }
              }
              
              optimization_effectiveness[optimization].count += 1
              optimization_effectiveness[optimization].total_gain += compiled_function.performance_gain
            }
          }
          
          // Calculate average effectiveness
          for each optimization in Object.keys(optimization_effectiveness) {
            stats = optimization_effectiveness[optimization]
            stats.average_gain = stats.total_gain / stats.count
          }
          
          // Update optimization strategies based on effectiveness
          update_optimization_strategies(optimization_effectiveness)
        }
      }
    }
  }

  recipe "update_optimization_strategies" {
    needs: optimization_effectiveness
    gives: void
    
    brain {
      plan {
        plan = { action: "adjust_optimization_strategies" }
      }
      
      execute {
        if plan.action == "adjust_optimization_strategies" {
          // Enable optimizations that are effective
          for each optimization in Object.keys(optimization_effectiveness) {
            stats = optimization_effectiveness[optimization]
            
            if stats.average_gain > 10 {  // 10% improvement threshold
              memory.optimization_strategies[optimization] = true
            } else if stats.average_gain < 5 {  // 5% improvement threshold
              memory.optimization_strategies[optimization] = false
            }
          }
          
          // Log strategy updates
          for each strategy in Object.keys(memory.optimization_strategies) {
            if memory.optimization_strategies[strategy] {
              log("Enabled optimization strategy: " + strategy)
            } else {
              log("Disabled optimization strategy: " + strategy)
            }
          }
        }
      }
    }
  }
} 