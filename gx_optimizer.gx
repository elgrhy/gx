helper "gx_optimizer" {
  can_do: ["code_optimization", "performance_analysis", "dead_code_elimination", "constant_folding", "loop_optimization"]
  
  remember {
    optimization_passes = {
      constant_folding: true,
      dead_code_elimination: true,
      loop_optimization: true,
      instruction_combining: true,
      peephole_optimization: true,
      register_allocation: true,
      function_inlining: true,
      tail_call_optimization: true
    }
    optimization_level = "production"
    performance_metrics = {
      instructions_before: 0,
      instructions_after: 0,
      optimization_time: 0,
      memory_usage_before: 0,
      memory_usage_after: 0
    }
    optimization_stats = {
      constant_folds: 0,
      dead_code_removed: 0,
      loops_optimized: 0,
      instructions_combined: 0,
      functions_inlined: 0
    }
  }

  receive {
    from "bytecode_generator" as "bytecode_input" {
      type: "unoptimized_bytecode"
      bind: memory.input_bytecode
      on_receive: brain.optimize_bytecode
    }
    
    from "compiler" as "optimization_request" {
      type: "optimize_code"
      bind: memory.optimization_request
      on_receive: brain.apply_optimizations
    }
  }

  brain {
    plan {
      if memory.input_bytecode {
        plan = {
          action: "optimize_bytecode",
          bytecode: memory.input_bytecode,
          level: memory.optimization_level
        }
      } else if memory.optimization_request {
        plan = {
          action: "apply_specific_optimizations",
          request: memory.optimization_request
        }
      }
    }
    
    execute {
      if plan.action == "optimize_bytecode" {
        // Record initial metrics
        memory.performance_metrics.instructions_before = plan.bytecode.length
        memory.performance_metrics.memory_usage_before = estimate_memory_usage(plan.bytecode)
        
        // Apply optimization passes
        optimized_bytecode = plan.bytecode
        
        for each pass_name in Object.keys(memory.optimization_passes) {
          if memory.optimization_passes[pass_name] {
            optimized_bytecode = apply_optimization_pass(optimized_bytecode, pass_name)
          }
        }
        
        // Record final metrics
        memory.performance_metrics.instructions_after = optimized_bytecode.length
        memory.performance_metrics.memory_usage_after = estimate_memory_usage(optimized_bytecode)
        memory.performance_metrics.optimization_time = get_timestamp()
        
        memory.optimized_bytecode = optimized_bytecode
      } else if plan.action == "apply_specific_optimizations" {
        optimized_bytecode = apply_specific_optimizations(plan.request)
        memory.optimized_bytecode = optimized_bytecode
      }
    }
    
    remember {
      memory.optimization_ratio = memory.performance_metrics.instructions_before / memory.performance_metrics.instructions_after
      memory.memory_improvement = memory.performance_metrics.memory_usage_before / memory.performance_metrics.memory_usage_after
    }
    
    communicate {
      if memory.optimized_bytecode {
        broadcast "optimization_complete" {
          optimized_bytecode: memory.optimized_bytecode,
          stats: memory.optimization_stats,
          metrics: memory.performance_metrics,
          improvement_ratio: memory.optimization_ratio
        }
      }
    }
  }

  recipe "apply_optimization_pass" {
    needs: bytecode, pass_name
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "apply_pass",
          bytecode: bytecode,
          pass: pass_name
        }
      }
      
      execute {
        if pass_name == "constant_folding" {
          optimized_bytecode = constant_folding_pass(bytecode)
          memory.optimization_stats.constant_folds += 1
        } else if pass_name == "dead_code_elimination" {
          optimized_bytecode = dead_code_elimination_pass(bytecode)
          memory.optimization_stats.dead_code_removed += 1
        } else if pass_name == "loop_optimization" {
          optimized_bytecode = loop_optimization_pass(bytecode)
          memory.optimization_stats.loops_optimized += 1
        } else if pass_name == "instruction_combining" {
          optimized_bytecode = instruction_combining_pass(bytecode)
          memory.optimization_stats.instructions_combined += 1
        } else if pass_name == "peephole_optimization" {
          optimized_bytecode = peephole_optimization_pass(bytecode)
        } else if pass_name == "register_allocation" {
          optimized_bytecode = register_allocation_pass(bytecode)
        } else if pass_name == "function_inlining" {
          optimized_bytecode = function_inlining_pass(bytecode)
          memory.optimization_stats.functions_inlined += 1
        } else if pass_name == "tail_call_optimization" {
          optimized_bytecode = tail_call_optimization_pass(bytecode)
        }
      }
    }
  }

  recipe "constant_folding_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "fold_constants",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = []
        i = 0
        
        while i < bytecode.length {
          if i + 4 < bytecode.length {
            // Look for constant arithmetic patterns
            if is_constant_arithmetic_pattern(bytecode, i) {
              result = evaluate_constant_expression(bytecode, i)
              optimized_bytecode.push(LOAD_CONST, result)
              i += 5  // Skip the original 5 instructions
            } else {
              optimized_bytecode.push(bytecode[i])
              i += 1
            }
          } else {
            optimized_bytecode.push(bytecode[i])
            i += 1
          }
        }
      }
    }
  }

  recipe "dead_code_elimination_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "eliminate_dead_code",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = []
        live_instructions = analyze_live_instructions(bytecode)
        
        for each instruction in bytecode {
          if is_instruction_live(instruction, live_instructions) {
            optimized_bytecode.push(instruction)
          }
        }
      }
    }
  }

  recipe "loop_optimization_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "optimize_loops",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = bytecode
        loops = detect_loops(bytecode)
        
        for each loop in loops {
          optimized_loop = optimize_loop(loop)
          optimized_bytecode = replace_loop_in_bytecode(optimized_bytecode, loop, optimized_loop)
        }
      }
    }
  }

  recipe "instruction_combining_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "combine_instructions",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = []
        i = 0
        
        while i < bytecode.length {
          if i + 1 < bytecode.length {
            combined = try_combine_instructions(bytecode[i], bytecode[i + 1])
            if combined {
              optimized_bytecode.push(combined)
              i += 2
            } else {
              optimized_bytecode.push(bytecode[i])
              i += 1
            }
          } else {
            optimized_bytecode.push(bytecode[i])
            i += 1
          }
        }
      }
    }
  }

  recipe "peephole_optimization_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "apply_peephole_patterns",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = bytecode
        
        // Apply peephole optimization patterns
        patterns = [
          // Load followed by immediate store can be optimized
          [LOAD_VAR, STORE_VAR],
          // Redundant jumps
          [JUMP, JUMP],
          // Load constant 0 followed by comparison
          [LOAD_CONST, 0, EQ],
          // Load constant 1 followed by multiplication
          [LOAD_CONST, 1, MUL]
        ]
        
        for each pattern in patterns {
          optimized_bytecode = apply_peephole_pattern(optimized_bytecode, pattern)
        }
      }
    }
  }

  recipe "register_allocation_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "allocate_registers",
          bytecode: bytecode
        }
      }
      
      execute {
        // Analyze variable usage
        variable_usage = analyze_variable_usage(bytecode)
        
        // Allocate registers optimally
        register_map = allocate_registers(variable_usage)
        
        // Rewrite bytecode with register allocation
        optimized_bytecode = rewrite_with_registers(bytecode, register_map)
      }
    }
  }

  recipe "function_inlining_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "inline_functions",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = bytecode
        
        // Find small functions that can be inlined
        inlineable_functions = find_inlineable_functions(bytecode)
        
        for each function in inlineable_functions {
          optimized_bytecode = inline_function(optimized_bytecode, function)
        }
      }
    }
  }

  recipe "tail_call_optimization_pass" {
    needs: bytecode
    gives: optimized_bytecode
    
    brain {
      plan {
        plan = {
          action: "optimize_tail_calls",
          bytecode: bytecode
        }
      }
      
      execute {
        optimized_bytecode = bytecode
        
        // Find tail calls
        tail_calls = find_tail_calls(bytecode)
        
        for each tail_call in tail_calls {
          optimized_bytecode = optimize_tail_call(optimized_bytecode, tail_call)
        }
      }
    }
  }

  recipe "analyze_live_instructions" {
    needs: bytecode
    gives: live_instructions
    
    brain {
      plan {
        plan = {
          action: "analyze_liveness",
          bytecode: bytecode
        }
      }
      
      execute {
        live_instructions = new Set()
        
        // Backward analysis to find live instructions
        for i = bytecode.length - 1; i >= 0; i-- {
          instruction = bytecode[i]
          
          if is_instruction_used(instruction) {
            live_instructions.add(i)
            
            // Add dependencies
            dependencies = get_instruction_dependencies(instruction)
            for each dep in dependencies {
              live_instructions.add(dep)
            }
          }
        }
      }
    }
  }

  recipe "detect_loops" {
    needs: bytecode
    gives: loops
    
    brain {
      plan {
        plan = {
          action: "find_loops",
          bytecode: bytecode
        }
      }
      
      execute {
        loops = []
        
        // Find jump patterns that form loops
        for i = 0; i < bytecode.length; i++ {
          if bytecode[i] == JUMP || bytecode[i] == JUMP_IF {
            target = bytecode[i + 1]
            
            if target < i {
              // This is a backward jump - potential loop
              loop = {
                start: target,
                end: i,
                body: bytecode.slice(target, i + 1)
              }
              loops.push(loop)
            }
          }
        }
      }
    }
  }

  objective "ensure_optimization_quality" {
    when memory.optimization_ratio < 0.8
    then {
      action: "apply_aggressive_optimization",
      target: memory.input_bytecode
    }
  }

  message "optimization_error" {
    do {
      log("Optimization failed: " + memory.error_message)
      broadcast "optimization_failed" {
        error: memory.error_message,
        bytecode: memory.input_bytecode
      }
    }
  }
} 