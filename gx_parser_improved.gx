helper "gx_parser_improved" {
  capabilities: ["parse", "ast_build", "syntax_validation", "cognitive_grammar", "backward_compatibility"]
  
  memory {
    tokens = []
    ast_nodes = {}
    current_agent = null
    parse_errors = []
    grammar_version = "0.2.0"
    syntax_mode = "improved" // "legacy" or "improved"
    
    // New syntax keywords
    improved_keywords = {
      // Agent definition
      "helper": "helper",
      "capabilities": "can_do",
      "brain": "brain",
      "receive": "receive",
      
      // Mental cycle
      "plan": "plan",
      "execute": "execute", 
      "remember": "remember",
      "communicate": "communicate",
      
      // Data flow
      "assign.helper": "send_to",
      "emit": "broadcast",
      
      // Functions
      "recipe": "recipe",
      "receive": "needs",
      "output": "gives",
      "brain": "steps",
      
      // Goals and signals
      "objective": "rule",
      "message": "when",
      
      // UI binding
      "bind": "connect",
      "↔": "<->"
    }
    
    // Legacy syntax support
    legacy_keywords = {
      "helper": "helper",
      "can_do": "capabilities",
      "brain": "brain",
      "receive": "receive",
      "plan": "plan",
      "execute": "execute",
      "remember": "remember",
      "communicate": "communicate",
      "send_to": "assign.helper",
      "broadcast": "emit",
      "recipe": "recipe",
      "needs": "receive",
      "gives": "output",
      "steps": "brain",
      "rule": "objective",
      "when": "message",
      "connect": "bind",
      "<->": "↔"
    }
  }

  receive {
    channel "parse_request" {
      source: "file_system"
      type: "gx_file"
      bind: memory.source_code
      on_receive: brain.parse_gx_file
    }
    
    channel "syntax_check" {
      source: "editor"
      type: "validation_request"
      bind: memory.code_snippet
      on_receive: brain.validate_syntax
    }
    
    channel "syntax_mode_request" {
      source: "config"
      type: "syntax_mode"
      bind: memory.mode_request
      on_receive: brain.set_syntax_mode
    }
  }

  brain {
    plan {
      if memory.source_code {
        plan = {
          action: "parse_complete_file",
          tokens: tokenize_with_mode(memory.source_code),
          target: "ast_builder"
        }
      } else if memory.code_snippet {
        plan = {
          action: "validate_snippet",
          tokens: tokenize_with_mode(memory.code_snippet),
          target: "syntax_validator"
        }
      } else if memory.mode_request {
        plan = {
          action: "update_syntax_mode",
          mode: memory.mode_request.mode
        }
      } else {
        plan = {
          action: "idle",
          target: "wait_for_input"
        }
      }
    }

    execute {
      if plan.action == "parse_complete_file" {
        memory.tokens = plan.tokens
        memory.ast_nodes = build_improved_ast(memory.tokens)
        memory.current_agent = extract_agent_info(memory.ast_nodes)
      } else if plan.action == "validate_snippet" {
        memory.tokens = plan.tokens
        syntax_errors = validate_improved_syntax(memory.tokens)
        memory.parse_errors = syntax_errors
      } else if plan.action == "update_syntax_mode" {
        memory.syntax_mode = plan.mode
        log("Syntax mode updated to: " + memory.syntax_mode)
      }
    }

    remember {
      memory.last_parse_timestamp = get_timestamp()
      memory.parsed_agents_count = count(memory.ast_nodes.agents)
    }

    communicate {
      if memory.parse_errors.length > 0 {
        emit "parse_errors"
      } else if memory.ast_nodes.agents {
        emit "ast_ready"
      }
    }
  }

  objective "ensure_grammar_compliance" {
    when memory.parse_errors.length > 0
    then {
      action: "report_errors",
      details: memory.parse_errors
    }
  }

  objective "suggest_improvements" {
    when memory.syntax_mode == "legacy" and memory.parse_errors.length == 0
    then {
      action: "suggest_improved_syntax",
      reason: "Legacy syntax detected - consider upgrading"
    }
  }

  message "ast_ready" {
    do {
      assign.helper("gx_runtime_improved").load_ast(memory.ast_nodes)
    }
  }

  message "parse_errors" {
    do {
      log("Parse errors detected: " + memory.parse_errors)
      emit "syntax_validation_failed"
    }
  }

  recipe "tokenize_with_mode" {
    receive: source_code
    output: tokens
    
    brain {
      execute {
        // First pass: basic tokenization
        raw_tokens = basic_tokenize(source_code)
        
        // Second pass: keyword transformation based on mode
        if memory.syntax_mode == "improved" {
          tokens = transform_to_improved_syntax(raw_tokens)
        } else {
          tokens = transform_to_legacy_syntax(raw_tokens)
        }
      }
    }
  }

  recipe "transform_to_improved_syntax" {
    receive: raw_tokens
    output: improved_tokens
    
    brain {
      execute {
        improved_tokens = []
        
        for each token in raw_tokens {
          if memory.improved_keywords[token.value] {
            // Transform legacy keyword to improved keyword
            improved_tokens.push({
              type: "keyword",
              value: memory.improved_keywords[token.value],
              line: token.line,
              column: token.column
            })
          } else {
            // Keep token as is
            improved_tokens.push(token)
          }
        }
      }
    }
  }

  recipe "transform_to_legacy_syntax" {
    receive: raw_tokens
    output: legacy_tokens
    
    brain {
      execute {
        legacy_tokens = []
        
        for each token in raw_tokens {
          if memory.legacy_keywords[token.value] {
            // Transform improved keyword to legacy keyword
            legacy_tokens.push({
              type: "keyword",
              value: memory.legacy_keywords[token.value],
              line: token.line,
              column: token.column
            })
          } else {
            // Keep token as is
            legacy_tokens.push(token)
          }
        }
      }
    }
  }

  recipe "build_improved_ast" {
    receive: tokens
    output: ast_nodes
    
    brain {
      execute {
        ast_nodes = {
          agents: [],
          functions: [],
          goals: [],
          signals: [],
          views: [],
          renders: []
        }
        
        current_agent = null
        current_function = null
        
        for each token in tokens {
          if token.value == "helper" {
            // Start new helper definition
            current_agent = {
              type: "helper",
              name: get_next_token_value(tokens, token.index),
              capabilities: [],
              memory: {},
              input_channels: [],
              mental_cycle: {},
              goals: [],
              signals: []
            }
            ast_nodes.agents.push(current_agent)
            
          } else if token.value == "can_do" {
            // Parse capabilities
            capabilities = parse_array_expression(tokens, token.index)
            current_agent.capabilities = capabilities
            
          } else if token.value == "remember" {
            // Parse memory block
            memory_block = parse_memory_block(tokens, token.index)
            current_agent.memory = memory_block
            
          } else if token.value == "receive" {
            // Parse receive channels
            input_channels = parse_input_channels(tokens, token.index)
            current_agent.input_channels = input_channels
            
          } else if token.value == "brain" {
            // Parse brain cycle
            mental_cycle = parse_mental_cycle(tokens, token.index)
            current_agent.mental_cycle = mental_cycle
            
          } else if token.value == "recipe" {
            // Start new recipe definition
            current_function = {
              type: "recipe",
              name: get_next_token_value(tokens, token.index),
              inputs: [],
              outputs: [],
              steps: {}
            }
            ast_nodes.functions.push(current_function)
            
          } else if token.value == "rule" {
            // Parse objective/rule
            rule = parse_rule(tokens, token.index)
            current_agent.goals.push(rule)
            
          } else if token.value == "when" {
            // Parse message handler
            message = parse_signal_handler(tokens, token.index)
            current_agent.signals.push(message)
          }
        }
      }
    }
  }

  recipe "parse_memory_block" {
    receive: tokens, start_index
    output: memory_block
    
    brain {
      execute {
        memory_block = {}
        current_index = start_index + 1 // Skip opening brace
        
        while tokens[current_index].value != "}" {
          if tokens[current_index].type == "identifier" {
            key = tokens[current_index].value
            current_index += 1
            
            if tokens[current_index].value == "=" {
              current_index += 1
              value = parse_value(tokens, current_index)
              memory_block[key] = value
            } else if tokens[current_index].value == ":" {
              // Typed memory (improved syntax)
              current_index += 1
              type_info = parse_type_definition(tokens, current_index)
              memory_block[key] = type_info
            }
          }
          current_index += 1
        }
      }
    }
  }

  recipe "parse_input_channels" {
    receive: tokens, start_index
    output: input_channels
    
    brain {
      execute {
        input_channels = []
        current_index = start_index + 1 // Skip opening brace
        
        while tokens[current_index].value != "}" {
          if tokens[current_index].value == "from" {
            // Improved syntax: from "source" as "channel_name"
            source = get_next_token_value(tokens, current_index)
            current_index += 2 // Skip "as"
            channel_name = get_next_token_value(tokens, current_index)
            
            channel_block = parse_channel_block(tokens, current_index)
            channel_block.source = source
            channel_block.name = channel_name
            
            input_channels.push(channel_block)
          } else if tokens[current_index].value == "channel" {
            // Legacy syntax: channel "name" { ... }
            channel_name = get_next_token_value(tokens, current_index)
            channel_block = parse_channel_block(tokens, current_index)
            channel_block.name = channel_name
            
            input_channels.push(channel_block)
          }
          current_index += 1
        }
      }
    }
  }

  recipe "parse_mental_cycle" {
    receive: tokens, start_index
    output: mental_cycle
    
    brain {
      execute {
        mental_cycle = {}
        current_index = start_index + 1 // Skip opening brace
        
        while tokens[current_index].value != "}" {
          if tokens[current_index].value == "plan" {
            plan_block = parse_code_block(tokens, current_index)
            mental_cycle.plan = plan_block
          } else if tokens[current_index].value == "execute" {
            execute_block = parse_code_block(tokens, current_index)
            mental_cycle.execute = execute_block
          } else if tokens[current_index].value == "remember" {
            remember_block = parse_code_block(tokens, current_index)
            mental_cycle.remember = remember_block
          } else if tokens[current_index].value == "communicate" {
            communicate_block = parse_code_block(tokens, current_index)
            mental_cycle.communicate = communicate_block
          }
          current_index += 1
        }
      }
    }
  }

  recipe "parse_rule" {
    receive: tokens, start_index
    output: rule
    
    brain {
      execute {
        rule = {
          name: get_next_token_value(tokens, start_index),
          condition: "",
          action: {}
        }
        
        current_index = start_index + 1
        
        // Parse condition
        if tokens[current_index].value == "if" {
          condition = parse_condition(tokens, current_index)
          rule.condition = condition
        }
        
        // Parse action
        if tokens[current_index].value == "do" {
          action = parse_action_block(tokens, current_index)
          rule.action = action
        }
      }
    }
  }

  recipe "validate_improved_syntax" {
    receive: tokens
    output: errors
    
    brain {
      execute {
        errors = []
        
        // Check for required blocks in agents
        for each helper in memory.ast_nodes.agents {
          if not helper.memory {
            errors.push("Agent '" + helper.name + "' must have a 'remember' block")
          }
          if not helper.mental_cycle {
            errors.push("Agent '" + helper.name + "' must have a 'brain' block")
          }
          if not helper.input_channels {
            errors.push("Agent '" + helper.name + "' must have a 'receive' block")
          }
        }
        
        // Check for improved syntax patterns
        for each token in tokens {
          if token.value == "helper" {
            errors.push("Use 'helper' instead of 'helper' for improved syntax")
          }
          if token.value == "brain" {
            errors.push("Use 'brain' instead of 'brain' for improved syntax")
          }
          if token.value == "receive" {
            errors.push("Use 'receive' instead of 'receive' for improved syntax")
          }
        }
      }
    }
  }

  recipe "set_syntax_mode" {
    receive: mode_request
    output: void
    
    brain {
      execute {
        memory.syntax_mode = mode_request.mode
        log("Parser syntax mode set to: " + memory.syntax_mode)
      }
    }
  }
} 