helper "gx_production_launcher" {
  can_do: ["system_bootstrap", "deployment_management", "monitoring", "error_recovery"]
  
  remember {
    deployment_status = "initializing"
    runtime_config = {
      max_memory: 2048 * 1024 * 1024, // 2GB
      max_agents: 1000,
      execution_timeout: 30000, // 30 seconds
      error_threshold: 10,
      performance_monitoring: true,
      garbage_collection: true,
      hot_reload: false
    }
    deployed_applications = {}
    system_metrics = {
      startup_time: null,
      applications_loaded: 0,
      total_agents: 0,
      memory_usage: 0,
      errors_count: 0
    }
  }

  receive {
    from "command_line" as "launch_command" {
      type: "run_application"
      bind: memory.launch_request
      on_receive: brain.handle_launch_request
    }
    
    from "file_system" as "config_file" {
      type: "runtime_config"
      bind: memory.config_data
      on_receive: brain.load_configuration
    }
    
    from "gx_runtime_production" as "runtime_status" {
      type: "status_update"
      bind: memory.runtime_status
      on_receive: brain.update_runtime_status
    }
  }

  brain {
    plan {
      if memory.deployment_status == "initializing" {
        plan = {
          action: "bootstrap_production_system",
          config: memory.runtime_config
        }
      } else if memory.launch_request {
        plan = {
          action: "launch_application",
          app: memory.launch_request,
          priority: "high"
        }
      } else if memory.runtime_status {
        plan = {
          action: "monitor_deployment",
          status: memory.runtime_status
        }
      } else {
        plan = {
          action: "idle_monitoring",
          priority: "low"
        }
      }
    }

    execute {
      if plan.action == "bootstrap_production_system" {
        memory.system_metrics.startup_time = get_timestamp()
        
        // Initialize production runtime
        send_to "gx_runtime_production" {
          recipe: "initialize_production_runtime"
          config: plan.config
        }
        
        // Start monitoring systems
        send_to "performance_monitor" {
          recipe: "start_production_monitoring"
          metrics: ["execution_time", "memory_usage", "agent_count", "error_rate"]
        }
        
        // Initialize deployment manager
        send_to "deployment_manager" {
          recipe: "initialize_deployment_system"
          config: {
            max_applications: 100,
            auto_restart: true,
            health_checks: true
          }
        }
        
        memory.deployment_status = "ready"
        log("🚀 GX Production Launcher initialized")
      } else if plan.action == "launch_application" {
        try {
          app_name = plan.app.name
          app_file = plan.app.file
          
          // Validate application file
          if not file_exists(app_file) {
            throw "Application file not found: " + app_file
          }
          
          // Load and deploy application
          send_to "gx_runtime_production" {
            recipe: "load_application"
            file: app_file
            config: {
              name: app_name,
              auto_restart: true,
              monitoring: true
            }
          }
          
          memory.deployed_applications[app_name] = {
            file: app_file,
            status: "loading",
            start_time: get_timestamp(),
            agent_count: 0
          }
          
          memory.system_metrics.applications_loaded += 1
          
          log("📦 Deploying application: " + app_name)
        } catch error {
          memory.system_metrics.errors_count += 1
          log("❌ Failed to launch application: " + error.message)
        }
      } else if plan.action == "monitor_deployment" {
        update_deployment_metrics(plan.status)
      } else if plan.action == "idle_monitoring" {
        monitor_system_health()
      }
    }

    remember {
      memory.launch_request = null
      memory.runtime_status = null
    }

    communicate {
      if memory.deployment_status == "ready" {
        broadcast "production_launcher_ready"
      }
      
      if memory.system_metrics.errors_count > 0 {
        broadcast "deployment_errors"
      }
    }
  }

  rule "ensure_deployment_stability" {
    if memory.system_metrics.errors_count > memory.runtime_config.error_threshold
    then {
      action: "emergency_restart",
      reason: "Too many deployment errors"
    }
  }

  rule "optimize_performance" {
    if memory.system_metrics.memory_usage > memory.runtime_config.max_memory * 0.8
    then {
      action: "optimize_memory_usage",
      reason: "High memory usage detected"
    }
  }

  when "production_launcher_ready" {
    do {
      log("🎉 GX Production Launcher ready for deployment!")
      log("📊 System metrics: " + JSON.stringify(memory.system_metrics))
    }
  }

  when "deployment_errors" {
    do {
      log("⚠️ Deployment errors detected: " + memory.system_metrics.errors_count)
      send_to "error_handler" {
        recipe: "handle_deployment_errors"
        errors: memory.system_metrics.errors_count
      }
    }
  }

  recipe "handle_launch_request" {
    needs: launch_request
    gives: void
    
    steps {
      execute {
        memory.launch_request = launch_request
      }
    }
  }

  recipe "load_configuration" {
    needs: config_data
    gives: void
    
    steps {
      execute {
        memory.runtime_config = merge_configs(memory.runtime_config, config_data)
      }
    }
  }

  recipe "update_runtime_status" {
    needs: runtime_status
    gives: void
    
    steps {
      execute {
        memory.runtime_status = runtime_status
      }
    }
  }
}

helper "deployment_manager" {
  can_do: ["application_deployment", "health_monitoring", "auto_restart", "deployment_optimization"]
  
  remember {
    deployed_apps = {}
    health_checks = {}
    restart_policies = {}
    deployment_metrics = {
      total_deployments: 0,
      successful_deployments: 0,
      failed_deployments: 0,
      active_applications: 0
    }
  }

  receive {
    from "gx_production_launcher" as "deployment_request" {
      type: "deploy_application"
      bind: memory.deployment_request
      on_receive: brain.handle_deployment_request
    }
    
    from "health_monitor" as "health_status" {
      type: "application_health"
      bind: memory.health_status
      on_receive: brain.update_health_status
    }
  }

  brain {
    plan {
      if memory.deployment_request {
        plan = {
          action: "deploy_application",
          app: memory.deployment_request
        }
      } else if memory.health_status {
        plan = {
          action: "handle_health_update",
          health: memory.health_status
        }
      } else {
        plan = {
          action: "monitor_deployments",
          priority: "normal"
        }
      }
    }

    execute {
      if plan.action == "deploy_application" {
        app_name = plan.app.name
        app_file = plan.app.file
        
        try {
          // Validate application
          validate_application(app_file)
          
          // Deploy to runtime
          send_to "gx_runtime_production" {
            recipe: "load_application"
            file: app_file
            config: {
              name: app_name,
              monitoring: true,
              auto_restart: true
            }
          }
          
          // Set up health monitoring
          memory.health_checks[app_name] = {
            status: "healthy",
            last_check: get_timestamp(),
            error_count: 0
          }
          
          memory.deployed_apps[app_name] = {
            file: app_file,
            status: "running",
            start_time: get_timestamp(),
            restart_count: 0
          }
          
          memory.deployment_metrics.successful_deployments += 1
          memory.deployment_metrics.active_applications += 1
          
          log("✅ Successfully deployed: " + app_name)
        } catch error {
          memory.deployment_metrics.failed_deployments += 1
          log("❌ Failed to deploy " + app_name + ": " + error.message)
        }
      } else if plan.action == "handle_health_update" {
        app_name = plan.health.app_name
        health_status = plan.health.status
        
        if memory.health_checks[app_name] {
          memory.health_checks[app_name].status = health_status
          memory.health_checks[app_name].last_check = get_timestamp()
          
          if health_status == "unhealthy" {
            memory.health_checks[app_name].error_count += 1
            
            // Auto-restart if configured
            if memory.deployed_apps[app_name] and memory.deployed_apps[app_name].restart_count < 3 {
              restart_application(app_name)
            }
          }
        }
      } else if plan.action == "monitor_deployments" {
        monitor_deployment_health()
        cleanup_failed_deployments()
      }
    }

    remember {
      memory.deployment_request = null
      memory.health_status = null
    }

    communicate {
      if memory.deployment_metrics.failed_deployments > 0 {
        broadcast "deployment_failures"
      }
    }
  }

  rule "prevent_deployment_cascade" {
    if memory.deployment_metrics.failed_deployments > 10
    then {
      action: "pause_deployments",
      reason: "Too many deployment failures"
    }
  }

  recipe "handle_deployment_request" {
    needs: deployment_request
    gives: void
    
    steps {
      execute {
        memory.deployment_request = deployment_request
      }
    }
  }

  recipe "update_health_status" {
    needs: health_status
    gives: void
    
    steps {
      execute {
        memory.health_status = health_status
      }
    }
  }
}

helper "health_monitor" {
  can_do: ["health_checking", "performance_monitoring", "alert_generation"]
  
  remember {
    health_checks = {}
    performance_baselines = {}
    alert_history = []
    monitoring_enabled = true
  }

  receive {
    from "gx_runtime_production" as "agent_health" {
      type: "agent_status"
      bind: memory.agent_health
      on_receive: brain.update_agent_health
    }
    
    from "performance_monitor" as "performance_data" {
      type: "performance_metrics"
      bind: memory.performance_data
      on_receive: brain.analyze_performance
    }
  }

  brain {
    plan {
      if memory.agent_health {
        plan = {
          action: "check_agent_health",
          health: memory.agent_health
        }
      } else if memory.performance_data {
        plan = {
          action: "analyze_performance_health",
          data: memory.performance_data
        }
      } else {
        plan = {
          action: "run_health_checks",
          priority: "normal"
        }
      }
    }

    execute {
      if plan.action == "check_agent_health" {
        agent_name = plan.health.agent_name
        status = plan.health.status
        
        memory.health_checks[agent_name] = {
          status: status,
          last_check: get_timestamp(),
          error_count: plan.health.error_count || 0
        }
        
        if status == "failed" {
          generate_health_alert(agent_name, "Agent failed")
        }
      } else if plan.action == "analyze_performance_health" {
        analyze_performance_health(plan.data)
      } else if plan.action == "run_health_checks" {
        run_system_health_checks()
      }
    }

    remember {
      memory.agent_health = null
      memory.performance_data = null
    }

    communicate {
      if memory.alert_history.length > 0 {
        broadcast "health_alerts"
      }
    }
  }

  rule "detect_health_issues" {
    if count_failed_agents() > 5
    then {
      action: "trigger_health_alert",
      reason: "Multiple helper failures detected"
    }
  }

  recipe "update_agent_health" {
    needs: agent_health
    gives: void
    
    steps {
      execute {
        memory.agent_health = agent_health
      }
    }
  }

  recipe "analyze_performance" {
    needs: performance_data
    gives: void
    
    steps {
      execute {
        memory.performance_data = performance_data
      }
    }
  }
}

// Main production launcher entry point
helper "main" {
  can_do: ["system_bootstrap", "production_orchestration"]
  
  remember {
    launcher_status = "starting"
    core_systems = ["gx_production_launcher", "deployment_manager", "health_monitor"]
    startup_sequence = []
  }

  brain {
    plan {
      if memory.launcher_status == "starting" {
        plan = {
          action: "bootstrap_production_launcher",
          systems: memory.core_systems
        }
      } else {
        plan = {
          action: "monitor_launcher_health"
        }
      }
    }

    execute {
      if plan.action == "bootstrap_production_launcher" {
        memory.launcher_status = "initializing"
        
        // Start core production systems
        for each system_name in plan.systems {
          start_agent(system_name)
          memory.startup_sequence.push(system_name)
        }
        
        memory.launcher_status = "running"
        log("🚀 GX Production Launcher bootstrapped successfully")
      } else if plan.action == "monitor_launcher_health" {
        monitor_launcher_health()
      }
    }

    remember {
      memory.last_health_check = get_timestamp()
    }

    communicate {
      if memory.launcher_status == "running" {
        broadcast "production_launcher_ready"
      }
    }
  }

  rule "ensure_launcher_stability" {
    if memory.launcher_status == "running"
    then {
      action: "maintain_launcher_health",
      priority: "high"
    }
  }

  when "production_launcher_ready" {
    do {
      log("🎉 GX Production Launcher ready for production deployment!")
      log("📊 Core systems running: " + memory.startup_sequence.join(", "))
      log("🚀 Ready to launch applications with: gx run <application.gx>")
    }
  }
} 