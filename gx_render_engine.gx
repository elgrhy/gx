helper "gx_render_engine" {
  can_do: ["ui_rendering", "view_composition", "data_binding", "style_management", "brain_visualization"]
  
  remember {
    active_views = {}
    render_queue = []
    style_system = {
      themes: {
        dark: {
          background: "#1a1a1a",
          foreground: "#ffffff",
          primary: "#007acc",
          secondary: "#6a6a6a",
          accent: "#ff6b6b"
        },
        light: {
          background: "#ffffff",
          foreground: "#1a1a1a",
          primary: "#007acc",
          secondary: "#6a6a6a",
          accent: "#ff6b6b"
        }
      },
      current_theme: "dark"
    }
    data_bindings = {}
    brain_visualization = {
      enabled: true,
      show_memory: true,
      show_messages: true,
      show_performance: true
    }
  }

  receive {
    from "ui_controller" as "render_request" {
      type: "render_view"
      bind: memory.render_request
      on_receive: brain.render_view
    }
    
    from "brain_monitor" as "brain_state" {
      type: "brain_update"
      bind: memory.brain_state
      on_receive: brain.update_brain_visualization
    }
    
    from "style_manager" as "style_update" {
      type: "style_change"
      bind: memory.style_update
      on_receive: brain.update_styles
    }
  }

  brain {
    plan {
      if memory.render_request {
        plan = {
          action: "render_requested_view",
          request: memory.render_request
        }
      } else if memory.brain_state {
        plan = {
          action: "update_brain_display",
          state: memory.brain_state
        }
      } else if memory.render_queue.length > 0 {
        plan = {
          action: "process_render_queue",
          queue: memory.render_queue
        }
      }
    }
    
    execute {
      if plan.action == "render_requested_view" {
        view = create_view(plan.request)
        memory.active_views[view.id] = view
        render_view_to_screen(view)
      } else if plan.action == "update_brain_display" {
        update_brain_visualization(plan.state)
      } else if plan.action == "process_render_queue" {
        for each render_task in plan.queue {
          process_render_task(render_task)
        }
        memory.render_queue = []
      }
    }
    
    remember {
      memory.last_render_time = get_timestamp()
      memory.active_view_count = Object.keys(memory.active_views).length
    }
    
    communicate {
      if memory.active_view_count > 0 {
        broadcast "render_complete" {
          views_rendered: memory.active_view_count,
          render_time: memory.last_render_time
        }
      }
    }
  }

  recipe "create_view" {
    needs: render_request
    gives: view
    
    brain {
      plan {
        plan = {
          action: "build_view_structure",
          request: render_request
        }
      }
      
      execute {
        view = {
          id: generate_view_id(),
          type: render_request.type,
          data: render_request.data,
          style: apply_theme_styles(render_request.style),
          children: [],
          bindings: []
        }
        
        // Add data bindings
        if render_request.bindings {
          for each binding in render_request.bindings {
            view.bindings.push(create_data_binding(binding))
          }
        }
        
        // Create child views
        if render_request.children {
          for each child_request in render_request.children {
            child_view = create_view(child_request)
            view.children.push(child_view)
          }
        }
      }
    }
  }

  recipe "render_view_to_screen" {
    needs: view
    gives: rendered_output
    
    brain {
      plan {
        plan = {
          action: "render_view_hierarchy",
          view: view
        }
      }
      
      execute {
        rendered_output = ""
        
        // Render view based on type
        if view.type == "brain_visualization" {
          rendered_output = render_brain_visualization(view)
        } else if view.type == "code_editor" {
          rendered_output = render_code_editor(view)
        } else if view.type == "memory_display" {
          rendered_output = render_memory_display(view)
        } else if view.type == "message_flow" {
          rendered_output = render_message_flow(view)
        } else if view.type == "performance_metrics" {
          rendered_output = render_performance_metrics(view)
        } else {
          rendered_output = render_generic_view(view)
        }
        
        // Apply data bindings
        rendered_output = apply_data_bindings(rendered_output, view.bindings)
        
        // Output to screen
        display_on_screen(rendered_output)
      }
    }
  }

  recipe "render_brain_visualization" {
    needs: view
    gives: visualization_html
    
    brain {
      plan {
        plan = {
          action: "create_brain_diagram",
          view: view
        }
      }
      
      execute {
        visualization_html = `
          <div class="brain-visualization" style="background: ${memory.style_system.themes[memory.style_system.current_theme].background}; color: ${memory.style_system.themes[memory.style_system.current_theme].foreground};">
            <div class="brain-cycle">
              <div class="cycle-phase plan-phase">
                <h3>🧠 Plan</h3>
                <div class="phase-content">${view.data.plan || 'Analyzing...'}</div>
              </div>
              <div class="cycle-phase execute-phase">
                <h3>⚡ Execute</h3>
                <div class="phase-content">${view.data.execute || 'Executing...'}</div>
              </div>
              <div class="cycle-phase remember-phase">
                <h3>💾 Remember</h3>
                <div class="phase-content">${view.data.remember || 'Saving...'}</div>
              </div>
              <div class="cycle-phase communicate-phase">
                <h3>📡 Communicate</h3>
                <div class="phase-content">${view.data.communicate || 'Signaling...'}</div>
              </div>
            </div>
            ${memory.brain_visualization.show_memory ? render_memory_section(view.data.memory) : ''}
            ${memory.brain_visualization.show_messages ? render_messages_section(view.data.messages) : ''}
            ${memory.brain_visualization.show_performance ? render_performance_section(view.data.performance) : ''}
          </div>
        `
      }
    }
  }

  recipe "render_code_editor" {
    needs: view
    gives: editor_html
    
    brain {
      plan {
        plan = {
          action: "create_code_editor",
          view: view
        }
      }
      
      execute {
        editor_html = `
          <div class="code-editor" style="background: ${memory.style_system.themes[memory.style_system.current_theme].background}; color: ${memory.style_system.themes[memory.style_system.current_theme].foreground};">
            <div class="editor-header">
              <span class="file-name">${view.data.filename || 'untitled.gx'}</span>
              <div class="editor-controls">
                <button class="run-btn">▶ Run</button>
                <button class="debug-btn">🐛 Debug</button>
                <button class="brain-btn">🧠 Brain View</button>
              </div>
            </div>
            <div class="editor-content">
              <pre class="code-display">${view.data.code || ''}</pre>
            </div>
            <div class="editor-status">
              <span class="status-item">Lines: ${view.data.lineCount || 0}</span>
              <span class="status-item">Helpers: ${view.data.helperCount || 0}</span>
              <span class="status-item">Brain Cycles: ${view.data.brainCycles || 0}</span>
            </div>
          </div>
        `
      }
    }
  }

  recipe "render_memory_display" {
    needs: view
    gives: memory_html
    
    brain {
      plan {
        plan = {
          action: "create_memory_view",
          view: view
        }
      }
      
      execute {
        memory_html = `
          <div class="memory-display" style="background: ${memory.style_system.themes[memory.style_system.current_theme].background}; color: ${memory.style_system.themes[memory.style_system.current_theme].foreground};">
            <h3>💾 Memory State</h3>
            <div class="memory-content">
              ${render_memory_variables(view.data.variables)}
            </div>
            <div class="memory-stats">
              <span>Variables: ${Object.keys(view.data.variables || {}).length}</span>
              <span>Memory Used: ${view.data.memoryUsage || '0'} bytes</span>
            </div>
          </div>
        `
      }
    }
  }

  recipe "render_message_flow" {
    needs: view
    gives: message_html
    
    brain {
      plan {
        plan = {
          action: "create_message_diagram",
          view: view
        }
      }
      
      execute {
        message_html = `
          <div class="message-flow" style="background: ${memory.style_system.themes[memory.style_system.current_theme].background}; color: ${memory.style_system.themes[memory.style_system.current_theme].foreground};">
            <h3>📡 Message Flow</h3>
            <div class="message-diagram">
              ${render_message_connections(view.data.messages)}
            </div>
            <div class="message-stats">
              <span>Messages: ${view.data.messageCount || 0}</span>
              <span>Helpers: ${view.data.helperCount || 0}</span>
              <span>Channels: ${view.data.channelCount || 0}</span>
            </div>
          </div>
        `
      }
    }
  }

  recipe "render_performance_metrics" {
    needs: view
    gives: performance_html
    
    brain {
      plan {
        plan = {
          action: "create_performance_dashboard",
          view: view
        }
      }
      
      execute {
        performance_html = `
          <div class="performance-metrics" style="background: ${memory.style_system.themes[memory.style_system.current_theme].background}; color: ${memory.style_system.themes[memory.style_system.current_theme].foreground};">
            <h3>📊 Performance Metrics</h3>
            <div class="metrics-grid">
              <div class="metric-item">
                <span class="metric-label">Execution Time</span>
                <span class="metric-value">${view.data.executionTime || '0'}ms</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">Memory Usage</span>
                <span class="metric-value">${view.data.memoryUsage || '0'} bytes</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">Brain Cycles</span>
                <span class="metric-value">${view.data.brainCycles || '0'}</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">Messages/sec</span>
                <span class="metric-value">${view.data.messagesPerSecond || '0'}</span>
              </div>
            </div>
            <div class="performance-chart">
              ${render_performance_chart(view.data.history)}
            </div>
          </div>
        `
      }
    }
  }

  recipe "create_data_binding" {
    needs: binding_config
    gives: binding
    
    brain {
      plan {
        plan = {
          action: "setup_data_binding",
          config: binding_config
        }
      }
      
      execute {
        binding = {
          source: binding_config.source,
          target: binding_config.target,
          type: binding_config.type || "one_way",
          transform: binding_config.transform || null,
          update_interval: binding_config.update_interval || 1000
        }
        
        // Register binding
        memory.data_bindings[binding.target] = binding
      }
    }
  }

  recipe "apply_data_bindings" {
    needs: html_content, bindings
    gives: bound_html
    
    brain {
      plan {
        plan = {
          action: "apply_bindings",
          content: html_content,
          bindings: bindings
        }
      }
      
      execute {
        bound_html = html_content
        
        for each binding in bindings {
          data_value = get_data_value(binding.source)
          
          if binding.transform {
            data_value = binding.transform(data_value)
          }
          
          bound_html = bound_html.replace(binding.target, data_value)
        }
      }
    }
  }

  recipe "update_brain_visualization" {
    needs: brain_state
    gives: updated_visualization
    
    brain {
      plan {
        plan = {
          action: "update_brain_display",
          state: brain_state
        }
      }
      
      execute {
        // Update brain cycle visualization
        if memory.active_views.brain_visualization {
          view = memory.active_views.brain_visualization
          view.data = brain_state
          render_view_to_screen(view)
        }
        
        // Update performance metrics
        if memory.active_views.performance_metrics {
          view = memory.active_views.performance_metrics
          view.data.performance = brain_state.performance
          render_view_to_screen(view)
        }
      }
    }
  }

  objective "ensure_smooth_rendering" {
    when memory.active_view_count > 10
    then {
      action: "optimize_rendering_performance",
      target: memory.active_views
    }
  }

  message "render_error" {
    do {
      log("Rendering failed: " + memory.error_message)
      broadcast "render_failed" {
        error: memory.error_message,
        view: memory.render_request
      }
    }
  }
} 