helper "gx_runtime" {
  can_do: ["gx_execution", "helper_management", "brain_cycle_execution", "memory_management", "message_routing"]
  
  remember {
    status = "initializing"
    loaded_helpers = {}
    active_helpers = []
    memory_pool = {}
    message_queue = []
    execution_cycle = 0
    performance_metrics = {
      helpers_executed: 0,
      brain_cycles: 0,
      messages_processed: 0,
      memory_allocated: 0
    }
  }

  receive {
    from "file_system" as "gx_source" {
      type: "gx_file"
      bind: memory.source_file
      on_receive: brain.load_and_execute
    }
    
    from "helper_mesh" as "helper_message" {
      type: "message"
      bind: memory.incoming_message
      on_receive: brain.route_message
    }
    
    from "memory_manager" as "memory_request" {
      type: "allocation_request"
      bind: memory.memory_request
      on_receive: brain.allocate_memory
    }
  }

  brain {
    plan {
      if memory.status == "initializing" {
        plan = { action: "bootstrap_runtime" }
      } else if memory.source_file {
        plan = { action: "load_and_execute_file" }
      } else if memory.message_queue.length > 0 {
        plan = { action: "process_messages" }
      } else if memory.active_helpers.length > 0 {
        plan = { action: "execute_brain_cycles" }
      } else {
        plan = { action: "idle_monitoring" }
      }
    }

    execute {
      if plan.action == "bootstrap_runtime" {
        memory.status = "ready"
        memory.execution_cycle = 0
        
        // Initialize core subsystems
        initialize_memory_manager()
        initialize_message_router()
        initialize_helper_manager()
        
        log("🧠 GX Runtime initialized successfully")
      } else if plan.action == "load_and_execute_file" {
        try {
          // Parse GX file
          parsed_helpers = parse_gx_file(memory.source_file)
          
          // Load helpers into runtime
          for each helper in parsed_helpers {
            memory.loaded_helpers[helper.name] = helper
            memory.active_helpers.push(helper.name)
          }
          
          // Execute initial brain cycles
          execute_initial_brain_cycles(parsed_helpers)
          
          memory.performance_metrics.helpers_executed += parsed_helpers.length
          
        } catch error {
          log("❌ Error loading GX file: " + error)
        }
      } else if plan.action == "process_messages" {
        // Process queued messages
        for each message in memory.message_queue {
          route_message_to_helper(message)
          memory.performance_metrics.messages_processed += 1
        }
        
        memory.message_queue = []
      } else if plan.action == "execute_brain_cycles" {
        // Execute brain cycles for all active helpers
        for each helper_name in memory.active_helpers {
          helper = memory.loaded_helpers[helper_name]
          if helper && helper.brain {
            execute_brain_cycle(helper)
            memory.performance_metrics.brain_cycles += 1
          }
        }
        
        memory.execution_cycle += 1
      } else if plan.action == "idle_monitoring" {
        // Monitor system health
        monitor_system_health()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
    }

    communicate {
      if memory.status == "ready" {
        emit "runtime_ready"
      } else if memory.performance_metrics.brain_cycles > 1000 {
        emit "performance_warning"
      }
    }
  }

  recipe "parse_gx_file" {
    needs: file_path
    gives: parsed_helpers
    
    brain {
      plan {
        plan = { action: "parse_gx_source" }
      }
      
      execute {
        if plan.action == "parse_gx_source" {
          // Read file content
          file_content = read_file(file_path)
          
          // Parse helpers from content
          parsed_helpers = []
          
          // Split by helper blocks
          helper_blocks = split_by_helper_blocks(file_content)
          
          for each block in helper_blocks {
            helper = parse_helper_block(block)
            if helper {
              parsed_helpers.push(helper)
            }
          }
        }
      }
    }
  }

  recipe "parse_helper_block" {
    needs: block_content
    gives: helper
    
    brain {
      plan {
        plan = { action: "extract_helper_info" }
      }
      
      execute {
        if plan.action == "extract_helper_info" {
          helper = {
            name: extract_helper_name(block_content),
            capabilities: extract_capabilities(block_content),
            brain: extract_brain_section(block_content),
            memory: extract_memory_section(block_content),
            receive: extract_receive_section(block_content)
          }
        }
      }
    }
  }

  recipe "execute_brain_cycle" {
    needs: helper
    gives: result
    
    brain {
      plan {
        plan = { action: "execute_plan_execute_remember_communicate" }
      }
      
      execute {
        if plan.action == "execute_plan_execute_remember_communicate" {
          // Execute brain cycle: Plan → Execute → Remember → Communicate
          
          // 1. Plan phase
          plan_result = execute_plan_phase(helper)
          
          // 2. Execute phase
          execute_result = execute_execute_phase(helper, plan_result)
          
          // 3. Remember phase
          remember_result = execute_remember_phase(helper, execute_result)
          
          // 4. Communicate phase
          communicate_result = execute_communicate_phase(helper, remember_result)
          
          result = {
            plan: plan_result,
            execute: execute_result,
            remember: remember_result,
            communicate: communicate_result
          }
        }
      }
    }
  }

  recipe "execute_plan_phase" {
    needs: helper
    gives: plan_result
    
    brain {
      plan {
        plan = { action: "evaluate_plan_logic" }
      }
      
      execute {
        if plan.action == "evaluate_plan_logic" {
          if helper.brain && helper.brain.plan {
            // Execute plan logic
            plan_logic = helper.brain.plan
            plan_result = evaluate_plan_conditions(plan_logic, helper.memory)
          } else {
            plan_result = { action: "default_action" }
          }
        }
      }
    }
  }

  recipe "execute_execute_phase" {
    needs: helper, plan_result
    gives: execute_result
    
    brain {
      plan {
        plan = { action: "execute_actions" }
      }
      
      execute {
        if plan.action == "execute_actions" {
          if helper.brain && helper.brain.execute {
            execute_logic = helper.brain.execute
            
            // Execute the planned actions
            execute_result = execute_actions(execute_logic, plan_result, helper.memory)
          } else {
            execute_result = { status: "no_execute_logic" }
          }
        }
      }
    }
  }

  recipe "execute_remember_phase" {
    needs: helper, execute_result
    gives: remember_result
    
    brain {
      plan {
        plan = { action: "update_memory" }
      }
      
      execute {
        if plan.action == "update_memory" {
          if helper.brain && helper.brain.remember {
            remember_logic = helper.brain.remember
            
            // Update helper memory
            remember_result = update_helper_memory(remember_logic, execute_result, helper.memory)
          } else {
            remember_result = { status: "no_remember_logic" }
          }
        }
      }
    }
  }

  recipe "execute_communicate_phase" {
    needs: helper, remember_result
    gives: communicate_result
    
    brain {
      plan {
        plan = { action: "send_messages" }
      }
      
      execute {
        if plan.action == "send_messages" {
          if helper.brain && helper.brain.communicate {
            communicate_logic = helper.brain.communicate
            
            // Send messages to other helpers
            communicate_result = send_helper_messages(communicate_logic, remember_result)
          } else {
            communicate_result = { status: "no_communicate_logic" }
          }
        }
      }
    }
  }

  recipe "route_message_to_helper" {
    needs: message
    gives: routing_result
    
    brain {
      plan {
        plan = { action: "find_target_helper" }
      }
      
      execute {
        if plan.action == "find_target_helper" {
          target_helper = find_helper_by_name(message.target)
          
          if target_helper {
            // Route message to helper
            deliver_message_to_helper(target_helper, message)
            routing_result = { status: "delivered" }
          } else {
            routing_result = { status: "helper_not_found" }
          }
        }
      }
    }
  }

  recipe "initialize_memory_manager" {
    needs: none
    gives: memory_manager
    
    brain {
      plan {
        plan = { action: "setup_memory_pool" }
      }
      
      execute {
        if plan.action == "setup_memory_pool" {
          memory_manager = {
            pool: {},
            allocated: 0,
            max_memory: 1024 * 1024 * 1024, // 1GB
            status: "ready"
          }
        }
      }
    }
  }

  recipe "initialize_message_router" {
    needs: none
    gives: message_router
    
    brain {
      plan {
        plan = { action: "setup_message_queue" }
      }
      
      execute {
        if plan.action == "setup_message_queue" {
          message_router = {
            queue: [],
            routes: {},
            status: "ready"
          }
        }
      }
    }
  }

  recipe "initialize_helper_manager" {
    needs: none
    gives: helper_manager
    
    brain {
      plan {
        plan = { action: "setup_helper_registry" }
      }
      
      execute {
        if plan.action == "setup_helper_registry" {
          helper_manager = {
            registry: {},
            active: [],
            status: "ready"
          }
        }
      }
    }
  }

  objective "maintain_runtime_stability" {
    when memory.performance_metrics.brain_cycles > 10000
    then {
      action: "performance_optimization"
      reason: "High brain cycle count detected"
    }
  }

  objective "ensure_memory_efficiency" {
    when memory.performance_metrics.memory_allocated > 512 * 1024 * 1024
    then {
      action: "garbage_collection"
      reason: "Memory usage exceeded threshold"
    }
  }

  message "runtime_ready" {
    do {
      log("🧠 GX Runtime is ready for execution")
      emit "runtime_initialized"
    }
  }

  message "performance_warning" {
    do {
      log("⚠️ Performance warning: High brain cycle count")
      optimize_runtime_performance()
    }
  }
} 