helper "gx_runtime" {
  capabilities: ["mental_execution", "agent_orchestration", "memory_management", "signal_dispatch"]
  
  memory {
    running_agents = {}
    agent_memory = {}
    signal_queue = []
    execution_cycle = 0
    runtime_status = "initializing"
  }

  receive {
    channel "ast_load" {
      source: "gx_parser"
      type: "ast_data"
      bind: memory.ast_nodes
      on_receive: brain.load_agents_from_ast
    }
    
    channel "agent_signal" {
      source: "agent_mesh"
      type: "message"
      bind: memory.incoming_signals
      on_receive: brain.process_signal
    }
    
    channel "memory_update" {
      source: "any_agent"
      type: "memory_change"
      bind: memory.memory_updates
      on_receive: brain.sync_memory
    }
  }

  brain {
    plan {
      if memory.runtime_status == "initializing" {
        plan = {
          action: "initialize_runtime",
          priority: "critical"
        }
      } else if memory.ast_nodes {
        plan = {
          action: "load_and_start_agents",
          priority: "high"
        }
      } else if memory.signal_queue.length > 0 {
        plan = {
          action: "process_signals",
          priority: "normal"
        }
      } else {
        plan = {
          action: "execute_mental_cycles",
          priority: "normal"
        }
      }
    }

    execute {
      if plan.action == "initialize_runtime" {
        memory.runtime_status = "ready"
        log("GX Runtime initialized")
      } else if plan.action == "load_and_start_agents" {
        load_agents_from_ast(memory.ast_nodes)
        start_all_agents()
      } else if plan.action == "process_signals" {
        process_signal_queue()
      } else if plan.action == "execute_mental_cycles" {
        execute_mental_cycle_for_all_agents()
      }
    }

    remember {
      memory.last_execution_cycle = memory.execution_cycle
      memory.execution_cycle += 1
    }

    communicate {
      if memory.running_agents.length > 0 {
        log("Runtime executing " + count(memory.running_agents) + " agents")
      }
      if memory.signal_queue.length > 0 {
        log("Signal queue has " + count(memory.signal_queue) + " pending signals")
      }
    }
  }

  objective "maintain_agent_health" {
    when any helper in memory.running_agents has status == "failed"
    then {
      action: "restart_failed_agent",
      helper: failed_agent
    }
  }

  message "runtime_ready" {
    do {
      emit "system_ready"
    }
  }

  message "agent_failed" {
    do {
      log("Agent failure detected - attempting recovery")
      restart_agent(failed_agent_id)
    }
  }

  recipe "load_agents_from_ast" {
    receive: ast_nodes
    output: loaded_agents
    
    brain {
      plan {
        agents_to_load = ast_nodes.agents
        loaded_agents = []
      }
      
      execute {
        for each agent_name, agent_config in agents_to_load {
          agent_instance = {
            id: generate_uuid(),
            name: agent_name,
            config: agent_config,
            status: "loading",
            memory: initialize_agent_memory(agent_config.memory),
            mental_state: {
              plan: agent_config.brain.plan || [],
              execute: agent_config.brain.execute || [],
              remember: agent_config.brain.remember || [],
              communicate: agent_config.brain.communicate || []
            },
            goals: agent_config.goals || [],
            signals: agent_config.signals || [],
            capabilities: agent_config.capabilities || []
          }
          
          memory.running_agents[agent_name] = agent_instance
          memory.agent_memory[agent_name] = agent_instance.memory
          loaded_agents.push(agent_instance)
        }
      }
      
      remember {
        memory.loaded_agents_count = count(loaded_agents)
      }
      
      communicate {
        log("Loaded " + count(loaded_agents) + " agents from AST")
      }
    }
  }

  recipe "start_all_agents" {
    brain {
      plan {
        agents_to_start = memory.running_agents
      }
      
      execute {
        for each agent_name, helper in agents_to_start {
          helper.status = "running"
          execute_mental_cycle(helper)
        }
      }
      
      remember {
        memory.runtime_status = "running"
      }
      
      communicate {
        log("Started " + count(agents_to_start) + " agents")
        emit "runtime_ready"
      }
    }
  }

  recipe "execute_mental_cycle" {
    receive: helper
    output: execution_result
    
    brain {
      plan {
        mental_blocks = ["plan", "execute", "remember", "communicate"]
        execution_result = {
          success: true,
          errors: [],
          output: null
        }
      }
      
      execute {
        for each block in mental_blocks {
          if helper.mental_state[block] {
            try {
              block_result = execute_mental_block(helper, block)
              if not block_result.success {
                execution_result.success = false
                execution_result.errors.push(block_result.error)
              }
            } catch error {
              execution_result.success = false
              execution_result.errors.push("Error in " + block + ": " + error)
            }
          }
        }
      }
      
      remember {
        helper.last_execution = get_timestamp()
        helper.execution_count += 1
      }
      
      communicate {
        if not execution_result.success {
          helper.status = "failed"
          emit "agent_failed"
        }
      }
    }
  }

  recipe "execute_mental_block" {
    receive: helper, block_name
    output: block_result
    
    brain {
      plan {
        block_code = helper.mental_state[block_name]
        agent_memory = memory.agent_memory[helper.name]
      }
      
      execute {
        block_result = {
          success: true,
          output: null,
          error: null
        }
        
        try {
          if block_name == "plan" {
            block_result.output = execute_think_block(helper, block_code, agent_memory)
          } else if block_name == "execute" {
            block_result.output = execute_act_block(helper, block_code, agent_memory)
          } else if block_name == "remember" {
            block_result.output = execute_save_block(helper, block_code, agent_memory)
          } else if block_name == "communicate" {
            block_result.output = execute_reflect_block(helper, block_code, agent_memory)
          }
        } catch error {
          block_result.success = false
          block_result.error = error
        }
      }
      
      remember {
        helper.mental_state[block_name + "_last_execution"] = get_timestamp()
      }
      
      communicate {
        if not block_result.success {
          log("Mental block " + block_name + " failed for helper " + helper.name)
        }
      }
    }
  }

  recipe "execute_think_block" {
    receive: helper, think_code, agent_memory
    output: think_result
    
    brain {
      plan {
        think_result = {
          plan: null,
          analysis: null
        }
      }
      
      execute {
        if think_code contains "plan" {
          think_result.plan = evaluate_plan_logic(think_code, agent_memory)
        }
        if think_code contains "analyze" {
          think_result.analysis = analyze_data(think_code, agent_memory)
        }
      }
      
      remember {
        agent_memory.last_think_result = think_result
      }
      
      communicate {
        log("Think block executed for helper " + helper.name)
      }
    }
  }

  recipe "execute_act_block" {
    receive: helper, act_code, agent_memory
    output: act_result
    
    brain {
      plan {
        act_result = {
          actions_taken: [],
          assignments: []
        }
      }
      
      execute {
        if act_code contains "assign.helper" {
          target_agent = extract_agent_name(act_code)
          act_result.assignments.push(target_agent)
          assign_task_to_agent(target_agent, act_code)
        }
        
        if act_code contains "execute" {
          action = extract_action(act_code)
          act_result.actions_taken.push(action)
          execute_action(action, agent_memory)
        }
      }
      
      remember {
        agent_memory.last_act_result = act_result
      }
      
      communicate {
        log("Act block executed for helper " + helper.name + " with " + count(act_result.actions_taken) + " actions")
      }
    }
  }

  recipe "execute_save_block" {
    receive: helper, save_code, agent_memory
    output: save_result
    
    brain {
      plan {
        save_result = {
          saved_variables: [],
          memory_updates: []
        }
      }
      
      execute {
        memory_updates = parse_memory_updates(save_code)
        for each update in memory_updates {
          agent_memory[update.variable] = update.value
          save_result.memory_updates.push(update)
        }
      }
      
      remember {
        agent_memory.last_save_timestamp = get_timestamp()
      }
      
      communicate {
        log("Save block executed for helper " + helper.name + " with " + count(save_result.memory_updates) + " updates")
      }
    }
  }

  recipe "execute_reflect_block" {
    receive: helper, reflect_code, agent_memory
    output: reflect_result
    
    brain {
      plan {
        reflect_result = {
          signals_emitted: [],
          logs_written: []
        }
      }
      
      execute {
        if reflect_code contains "emit" {
          signal_name = extract_signal_name(reflect_code)
          reflect_result.signals_emitted.push(signal_name)
          emit_signal(signal_name, helper.name)
        }
        
        if reflect_code contains "log" {
          log_message = extract_log_message(reflect_code)
          reflect_result.logs_written.push(log_message)
          log(log_message)
        }
      }
      
      remember {
        agent_memory.last_reflect_result = reflect_result
      }
      
      communicate {
        log("Reflect block executed for helper " + helper.name)
      }
    }
  }

  recipe "process_signal_queue" {
    brain {
      plan {
        pending_signals = memory.signal_queue
      }
      
      execute {
        for each message in pending_signals {
          target_agents = find_agents_responding_to_signal(message.name)
          for each helper in target_agents {
            execute_signal_handler(helper, message)
          }
        }
        memory.signal_queue = []
      }
      
      remember {
        memory.signals_processed += count(pending_signals)
      }
      
      communicate {
        log("Processed " + count(pending_signals) + " signals")
      }
    }
  }

  recipe "emit_signal" {
    receive: signal_name, source_agent
    output: signal_id
    
    brain {
      plan {
        message = {
          id: generate_uuid(),
          name: signal_name,
          source: source_agent,
          timestamp: get_timestamp(),
          data: {}
        }
      }
      
      execute {
        memory.signal_queue.push(message)
        signal_id = message.id
      }
      
      remember {
        memory.total_signals_emitted += 1
      }
      
      communicate {
        log("Signal emitted: " + signal_name + " from " + source_agent)
      }
    }
  }
} 