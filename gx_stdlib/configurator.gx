agent "configurator" {
  capabilities: ["dependency_resolution", "environment_setup", "package_management", "version_control"]
  
  memory {
    dependencies = {}
    installed_packages = []
    environment_vars = {}
    config_files = {}
    resolution_errors = []
  }

  input {
    channel "config_request" {
      source: "gx_kernel"
      type: "setup_request"
      bind: memory.setup_request
      on_receive: mental.setup_environment
    }
    
    channel "dependency_request" {
      source: "any_agent"
      type: "dependency_needed"
      bind: memory.dependency_request
      on_receive: mental.resolve_dependency
    }
    
    channel "env_update" {
      source: "file_system"
      type: "env_file_change"
      bind: memory.env_changes
      on_receive: mental.update_environment
    }
  }

  mental {
    think {
      if memory.setup_request {
        plan = {
          action: "setup_environment",
          request: memory.setup_request,
          priority: "high"
        }
      } else if memory.dependency_request {
        plan = {
          action: "resolve_dependency",
          dependency: memory.dependency_request,
          priority: "normal"
        }
      } else if memory.env_changes {
        plan = {
          action: "update_environment",
          changes: memory.env_changes,
          priority: "normal"
        }
      } else {
        plan = {
          action: "idle",
          priority: "low"
        }
      }
    }

    act {
      if plan.action == "setup_environment" {
        setup_initial_environment()
        load_environment_variables()
        validate_dependencies()
      } else if plan.action == "resolve_dependency" {
        resolve_and_install_dependency(plan.dependency)
      } else if plan.action == "update_environment" {
        apply_environment_changes(plan.changes)
      }
    }

    save {
      memory.last_config_action = plan.action
      memory.last_config_timestamp = get_timestamp()
    }

    reflect {
      if memory.resolution_errors.length > 0 {
        emit "config_error"
      } else if plan.action == "setup_environment" {
        emit "environment_ready"
      }
    }
  }

  goal "ensure_dependency_compatibility" {
    when memory.resolution_errors.length > 0
    then {
      action: "resolve_conflicts",
      dependencies: memory.resolution_errors
    }
  }

  signal "environment_ready" {
    do {
      log("GX environment configured successfully")
      assign.agent("installer").install_core_packages()
    }
  }

  signal "config_error" {
    do {
      log("Configuration error detected: " + memory.resolution_errors)
      emit "setup_failed"
    }
  }

  function "setup_initial_environment" {
    mental {
      think {
        required_dirs = [
          "gx_stdlib",
          "examples", 
          "temp",
          "logs",
          "cache"
        ]
        
        required_files = [
          ".env",
          "gx.config",
          "package.json"
        ]
      }
      
      act {
        for each dir in required_dirs {
          create_directory(dir)
        }
        
        for each file in required_files {
          if not file_exists(file) {
            create_default_file(file)
          }
        }
      }
      
      save {
        memory.environment_initialized = true
      }
      
      reflect {
        log("Initial environment setup complete")
      }
    }
  }

  function "load_environment_variables" {
    mental {
      think {
        env_file = read_file(".env")
        env_vars = parse_env_file(env_file)
      }
      
      act {
        for each key, value in env_vars {
          memory.environment_vars[key] = value
          set_environment_variable(key, value)
        }
      }
      
      save {
        memory.env_loaded = true
      }
      
      reflect {
        log("Loaded " + count(memory.environment_vars) + " environment variables")
      }
    }
  }

  function "validate_dependencies" {
    mental {
      think {
        required_deps = [
          "gxchart",
          "gxui", 
          "gxnet",
          "gxdb"
        ]
        
        missing_deps = []
      }
      
      act {
        for each dep in required_deps {
          if not package_installed(dep) {
            missing_deps.push(dep)
          }
        }
        
        if missing_deps.length > 0 {
          memory.resolution_errors.push("Missing dependencies: " + missing_deps)
        }
      }
      
      save {
        memory.dependencies_validated = true
        memory.missing_dependencies = missing_deps
      }
      
      reflect {
        if missing_deps.length > 0 {
          log("Missing dependencies detected: " + missing_deps)
        } else {
          log("All dependencies validated successfully")
        }
      }
    }
  }

  function "resolve_and_install_dependency" {
    input: dependency_request
    output: installation_result
    
    mental {
      think {
        dep_name = dependency_request.name
        dep_version = dependency_request.version || "latest"
        dep_source = dependency_request.source || "gx_registry"
      }
      
      act {
        try {
          if dep_source == "gx_registry" {
            package_info = fetch_package_info(dep_name, dep_version)
            download_package(package_info.download_url)
            install_package(dep_name, package_info)
          } else if dep_source == "npm" {
            npm_install(dep_name, dep_version)
          } else if dep_source == "pip" {
            pip_install(dep_name, dep_version)
          }
          
          installation_result = {
            success: true,
            package: dep_name,
            version: package_info.version
          }
          
          memory.installed_packages.push({
            name: dep_name,
            version: package_info.version,
            source: dep_source,
            installed_at: get_timestamp()
          })
        } catch error {
          installation_result = {
            success: false,
            error: error,
            package: dep_name
          }
          
          memory.resolution_errors.push("Failed to install " + dep_name + ": " + error)
        }
      }
      
      save {
        memory.last_installation = installation_result
      }
      
      reflect {
        if installation_result.success {
          log("Successfully installed " + dep_name + " v" + package_info.version)
        } else {
          log("Failed to install " + dep_name + ": " + error)
        }
      }
    }
  }

  function "apply_environment_changes" {
    input: changes
    output: applied_changes
    
    mental {
      think {
        applied_changes = []
      }
      
      act {
        for each change in changes {
          if change.type == "env_var" {
            memory.environment_vars[change.key] = change.value
            set_environment_variable(change.key, change.value)
            applied_changes.push(change)
          } else if change.type == "config_file" {
            update_config_file(change.file, change.updates)
            applied_changes.push(change)
          }
        }
      }
      
      save {
        memory.last_env_update = get_timestamp()
      }
      
      reflect {
        log("Applied " + count(applied_changes) + " environment changes")
      }
    }
  }

  function "create_default_file" {
    input: filename
    output: created
    
    mental {
      think {
        default_contents = get_default_file_contents(filename)
      }
      
      act {
        write_file(filename, default_contents)
        created = true
      }
      
      reflect {
        log("Created default file: " + filename)
      }
    }
  }

  function "get_default_file_contents" {
    input: filename
    output: contents
    
    mental {
      think {
        if filename == ".env" {
          contents = """
# GX Environment Configuration
GX_VERSION=0.1.0
GX_ENV=development
GX_DEBUG=true
GX_LOG_LEVEL=info

# API Keys (replace with your actual keys)
OPENWEATHERMAP_API_KEY=your_api_key_here
SENDGRID_API_KEY=your_sendgrid_key_here

# Database Configuration
GX_DB_HOST=localhost
GX_DB_PORT=5432
GX_DB_NAME=gx_app
GX_DB_USER=gx_user
GX_DB_PASSWORD=gx_password

# Network Configuration
GX_HOST=localhost
GX_PORT=3000
GX_CORS_ORIGIN=http://localhost:3000
"""
        } else if filename == "gx.config" {
          contents = """
{
  "version": "0.1.0",
  "name": "gx_application",
  "description": "GX Cognitive Application",
  "main": "main.gx",
  "agents": [
    "gx_kernel",
    "gx_parser", 
    "gx_runtime"
  ],
  "dependencies": {
    "gxchart": "^1.0.0",
    "gxui": "^1.0.0",
    "gxnet": "^1.0.0",
    "gxdb": "^1.0.0"
  },
  "scripts": {
    "start": "gx run main.gx",
    "dev": "gx run --dev main.gx",
    "build": "gx build main.gx",
    "test": "gx test"
  }
}
"""
        } else if filename == "package.json" {
          contents = """
{
  "name": "gx-application",
  "version": "0.1.0",
  "description": "GX Cognitive Application",
  "main": "main.gx",
  "scripts": {
    "start": "gx run main.gx",
    "dev": "gx run --dev main.gx",
    "build": "gx build main.gx",
    "test": "gx test"
  },
  "dependencies": {
    "gxchart": "^1.0.0",
    "gxui": "^1.0.0",
    "gxnet": "^1.0.0",
    "gxdb": "^1.0.0"
  },
  "devDependencies": {
    "gx-test": "^1.0.0"
  }
}
"""
        }
      }
      
      act {
        return contents
      }
    }
  }
} 