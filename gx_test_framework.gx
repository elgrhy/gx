helper "gx_test_framework" {
  can_do: ["test_execution", "test_discovery", "test_reporting", "test_assertions", "test_coverage"]
  
  remember {
    test_suites = {}
    test_results = {}
    test_coverage = {}
    assertion_library = {
      assert: assert_equals,
      assert_equals: assert_equals,
      assert_not_equals: assert_not_equals,
      assert_true: assert_true,
      assert_false: assert_false,
      assert_null: assert_null,
      assert_not_null: assert_not_null,
      assert_type: assert_type,
      assert_throws: assert_throws,
      assert_contains: assert_contains,
      assert_length: assert_length,
      assert_greater_than: assert_greater_than,
      assert_less_than: assert_less_than,
      assert_approximately: assert_approximately
    }
    
    test_config = {
      parallel_execution: true,
      max_parallel_tests: 10,
      timeout_per_test: 30000,  // 30 seconds
      enable_coverage: true,
      coverage_threshold: 80,
      fail_fast: false,
      verbose_output: true
    }
    
    test_metrics = {
      total_tests: 0,
      passed_tests: 0,
      failed_tests: 0,
      skipped_tests: 0,
      total_duration: 0,
      average_duration: 0
    }
  }

  receive {
    from "test_runner" as "test_execution_request" {
      type: "run_tests"
      bind: memory.test_request
      on_receive: brain.execute_tests
    }
    
    from "test_discovery" as "test_discovery_request" {
      type: "discover_tests"
      bind: memory.discovery_request
      on_receive: brain.discover_tests
    }
    
    from "coverage_analyzer" as "coverage_request" {
      type: "analyze_coverage"
      bind: memory.coverage_request
      on_receive: brain.analyze_coverage
    }
  }

  brain {
    plan {
      if memory.test_request {
        plan = { action: "execute_test_suite", request: memory.test_request }
      } else if memory.discovery_request {
        plan = { action: "discover_test_files", request: memory.discovery_request }
      } else if memory.coverage_request {
        plan = { action: "analyze_test_coverage", request: memory.coverage_request }
      } else {
        plan = { action: "idle_test_monitoring" }
      }
    }

    execute {
      if plan.action == "execute_test_suite" {
        try {
          request = plan.request
          test_files = request.test_files || []
          test_pattern = request.pattern || "**/*.test.gx"
          
          // Discover tests if not provided
          if test_files.length == 0 {
            test_files = discover_test_files(test_pattern)
          }
          
          // Execute tests
          test_results = execute_test_files(test_files, request.options || {})
          
          // Generate test report
          test_report = generate_test_report(test_results)
          
          // Analyze coverage if enabled
          if memory.test_config.enable_coverage {
            coverage_data = analyze_test_coverage(test_results)
            test_report.coverage = coverage_data
          }
          
          memory.test_execution_result = {
            success: test_results.failed_tests == 0,
            test_results: test_results,
            report: test_report,
            duration: test_results.total_duration
          }
          
        } catch execution_error {
          memory.test_execution_result = {
            success: false,
            error: "Test execution failed: " + execution_error,
            test_results: null
          }
        }
      } else if plan.action == "discover_test_files" {
        try {
          request = plan.request
          pattern = request.pattern || "**/*.test.gx"
          directory = request.directory || "."
          
          discovered_tests = discover_test_files(pattern, directory)
          
          memory.discovery_result = {
            pattern: pattern,
            directory: directory,
            discovered_tests: discovered_tests,
            total_count: discovered_tests.length
          }
          
        } catch discovery_error {
          memory.discovery_result = {
            error: "Test discovery failed: " + discovery_error,
            discovered_tests: []
          }
        }
      } else if plan.action == "analyze_test_coverage" {
        try {
          request = plan.request
          test_results = request.test_results
          
          coverage_data = analyze_test_coverage(test_results)
          
          memory.coverage_result = {
            coverage_percentage: coverage_data.overall_coverage,
            line_coverage: coverage_data.line_coverage,
            function_coverage: coverage_data.function_coverage,
            branch_coverage: coverage_data.branch_coverage,
            uncovered_lines: coverage_data.uncovered_lines,
            meets_threshold: coverage_data.overall_coverage >= memory.test_config.coverage_threshold
          }
          
        } catch coverage_error {
          memory.coverage_result = {
            error: "Coverage analysis failed: " + coverage_error
          }
        }
      } else if plan.action == "idle_test_monitoring" {
        // Update test metrics
        update_test_metrics()
        
        // Clean up old test results
        cleanup_old_test_results()
        
        // Analyze test performance
        analyze_test_performance()
      }
    }

    remember {
      memory.last_action = plan.action
      memory.last_timestamp = get_timestamp()
      
      // Update test metrics
      if memory.test_execution_result && memory.test_execution_result.success {
        memory.test_metrics.total_tests += memory.test_execution_result.test_results.total_tests
        memory.test_metrics.passed_tests += memory.test_execution_result.test_results.passed_tests
        memory.test_metrics.failed_tests += memory.test_execution_result.test_results.failed_tests
        memory.test_metrics.total_duration += memory.test_execution_result.duration
      }
    }

    communicate {
      if memory.test_execution_result {
        if memory.test_execution_result.success {
          emit "test_execution_success" {
            total_tests: memory.test_execution_result.test_results.total_tests,
            passed_tests: memory.test_execution_result.test_results.passed_tests,
            duration: memory.test_execution_result.duration,
            coverage: memory.test_execution_result.report.coverage
          }
        } else {
          emit "test_execution_failed" {
            failed_tests: memory.test_execution_result.test_results.failed_tests,
            error: memory.test_execution_result.error
          }
        }
      }
      
      if memory.discovery_result {
        emit "test_discovery_complete" {
          pattern: memory.discovery_result.pattern,
          discovered_count: memory.discovery_result.total_count
        }
      }
      
      if memory.coverage_result {
        emit "coverage_analysis_complete" {
          coverage_percentage: memory.coverage_result.coverage_percentage,
          meets_threshold: memory.coverage_result.meets_threshold
        }
      }
    }
  }

  recipe "execute_test_files" {
    needs: test_files, options
    gives: test_results
    
    brain {
      plan {
        plan = { action: "run_test_files" }
      }
      
      execute {
        if plan.action == "run_test_files" {
          test_results = {
            total_tests: 0,
            passed_tests: 0,
            failed_tests: 0,
            skipped_tests: 0,
            total_duration: 0,
            test_suites: {},
            errors: []
          }
          
          start_time = get_timestamp()
          
          // Execute tests in parallel if enabled
          if memory.test_config.parallel_execution {
            parallel_results = execute_tests_parallel(test_files, options)
            test_results = merge_test_results(parallel_results)
          } else {
            // Execute tests sequentially
            for each test_file in test_files {
              suite_result = execute_test_suite(test_file, options)
              test_results.test_suites[test_file] = suite_result
              test_results.total_tests += suite_result.total_tests
              test_results.passed_tests += suite_result.passed_tests
              test_results.failed_tests += suite_result.failed_tests
              test_results.skipped_tests += suite_result.skipped_tests
            }
          }
          
          test_results.total_duration = get_timestamp() - start_time
        }
      }
    }
  }

  recipe "execute_test_suite" {
    needs: test_file, options
    gives: suite_result
    
    brain {
      plan {
        plan = { action: "run_test_suite" }
      }
      
      execute {
        if plan.action == "run_test_suite" {
          suite_result = {
            file: test_file,
            total_tests: 0,
            passed_tests: 0,
            failed_tests: 0,
            skipped_tests: 0,
            duration: 0,
            tests: [],
            setup_duration: 0,
            teardown_duration: 0
          }
          
          try {
            // Load test file
            test_content = load_test_file(test_file)
            
            // Parse test suites
            test_suites = parse_test_suites(test_content)
            
            // Execute each test suite
            for each suite in test_suites {
              suite_start_time = get_timestamp()
              
              // Run setup if exists
              if suite.setup {
                setup_result = execute_setup(suite.setup)
                suite_result.setup_duration += get_timestamp() - suite_start_time
              }
              
              // Execute tests in suite
              for each test in suite.tests {
                test_result = execute_single_test(test, suite.context)
                suite_result.tests.push(test_result)
                suite_result.total_tests += 1
                
                if test_result.status == "passed" {
                  suite_result.passed_tests += 1
                } else if test_result.status == "failed" {
                  suite_result.failed_tests += 1
                } else if test_result.status == "skipped" {
                  suite_result.skipped_tests += 1
                }
              }
              
              // Run teardown if exists
              if suite.teardown {
                teardown_start = get_timestamp()
                execute_teardown(suite.teardown)
                suite_result.teardown_duration += get_timestamp() - teardown_start
              }
              
              suite_result.duration += get_timestamp() - suite_start_time
            }
            
          } catch suite_error {
            suite_result.error = "Test suite execution failed: " + suite_error
            suite_result.failed_tests = suite_result.total_tests
          }
        }
      }
    }
  }

  recipe "execute_single_test" {
    needs: test, context
    gives: test_result
    
    brain {
      plan {
        plan = { action: "run_single_test" }
      }
      
      execute {
        if plan.action == "run_single_test" {
          test_result = {
            name: test.name,
            description: test.description,
            status: "pending",
            duration: 0,
            error: null,
            assertions: [],
            coverage: null
          }
          
          try {
            start_time = get_timestamp()
            
            // Execute test function
            test_function = test.function
            test_result.status = "running"
            
            // Execute test with timeout
            execution_result = execute_with_timeout(test_function, context, memory.test_config.timeout_per_test)
            
            test_result.duration = get_timestamp() - start_time
            
            if execution_result.success {
              test_result.status = "passed"
              test_result.assertions = execution_result.assertions
            } else {
              test_result.status = "failed"
              test_result.error = execution_result.error
            }
            
          } catch test_error {
            test_result.status = "failed"
            test_result.error = "Test execution error: " + test_error
            test_result.duration = get_timestamp() - start_time
          }
        }
      }
    }
  }

  recipe "parse_test_suites" {
    needs: test_content
    gives: test_suites
    
    brain {
      plan {
        plan = { action: "parse_test_content" }
      }
      
      execute {
        if plan.action == "parse_test_content" {
          test_suites = []
          
          // Parse test_suite blocks
          suite_blocks = extract_test_suite_blocks(test_content)
          
          for each block in suite_blocks {
            suite = {
              name: extract_suite_name(block),
              description: extract_suite_description(block),
              setup: extract_setup_function(block),
              teardown: extract_teardown_function(block),
              tests: extract_tests_from_suite(block),
              context: {}
            }
            
            test_suites.push(suite)
          }
        }
      }
    }
  }

  recipe "extract_tests_from_suite" {
    needs: suite_block
    gives: tests
    
    brain {
      plan {
        plan = { action: "extract_test_functions" }
      }
      
      execute {
        if plan.action == "extract_test_functions" {
          tests = []
          
          // Find test blocks
          test_blocks = find_test_blocks(suite_block)
          
          for each block in test_blocks {
            test = {
              name: extract_test_name(block),
              description: extract_test_description(block),
              function: extract_test_function(block),
              timeout: extract_test_timeout(block),
              skip: extract_test_skip_condition(block)
            }
            
            tests.push(test)
          }
        }
      }
    }
  }

  recipe "execute_with_timeout" {
    needs: test_function, context, timeout
    gives: execution_result
    
    brain {
      plan {
        plan = { action: "execute_with_timeout" }
      }
      
      execute {
        if plan.action == "execute_with_timeout" {
          execution_result = {
            success: false,
            error: null,
            assertions: []
          }
          
          try {
            // Set up assertion tracking
            assertion_results = []
            
            // Create assertion wrapper
            assertion_wrapper = create_assertion_wrapper(assertion_results)
            
            // Execute test with context and assertions
            test_context = {
              ...context,
              assert: assertion_wrapper.assert,
              assert_equals: assertion_wrapper.assert_equals,
              assert_true: assertion_wrapper.assert_true,
              assert_false: assertion_wrapper.assert_false,
              assert_null: assertion_wrapper.assert_null,
              assert_not_null: assertion_wrapper.assert_not_null,
              assert_type: assertion_wrapper.assert_type,
              assert_throws: assertion_wrapper.assert_throws,
              assert_contains: assertion_wrapper.assert_contains,
              assert_length: assertion_wrapper.assert_length,
              assert_greater_than: assertion_wrapper.assert_greater_than,
              assert_less_than: assertion_wrapper.assert_less_than,
              assert_approximately: assertion_wrapper.assert_approximately
            }
            
            // Execute test function
            test_function(test_context)
            
            execution_result.success = true
            execution_result.assertions = assertion_results
            
          } catch execution_error {
            execution_result.error = execution_error
          }
        }
      }
    }
  }

  recipe "create_assertion_wrapper" {
    needs: assertion_results
    gives: assertion_wrapper
    
    brain {
      plan {
        plan = { action: "create_assertion_functions" }
      }
      
      execute {
        if plan.action == "create_assertion_functions" {
          assertion_wrapper = {
            assert: function(condition, message) {
              assertion_results.push({
                type: "assert",
                condition: condition,
                message: message,
                passed: condition
              })
              if not condition {
                throw "Assertion failed: " + (message || "Condition is false")
              }
            },
            
            assert_equals: function(actual, expected, message) {
              passed = actual == expected
              assertion_results.push({
                type: "assert_equals",
                actual: actual,
                expected: expected,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected " + expected + " but got " + actual)
              }
            },
            
            assert_true: function(condition, message) {
              assertion_results.push({
                type: "assert_true",
                condition: condition,
                message: message,
                passed: condition
              })
              if not condition {
                throw "Assertion failed: " + (message || "Expected true but got false")
              }
            },
            
            assert_false: function(condition, message) {
              assertion_results.push({
                type: "assert_false",
                condition: condition,
                message: message,
                passed: not condition
              })
              if condition {
                throw "Assertion failed: " + (message || "Expected false but got true")
              }
            },
            
            assert_null: function(value, message) {
              passed = value == null
              assertion_results.push({
                type: "assert_null",
                value: value,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected null but got " + value)
              }
            },
            
            assert_not_null: function(value, message) {
              passed = value != null
              assertion_results.push({
                type: "assert_not_null",
                value: value,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected non-null value but got null")
              }
            },
            
            assert_type: function(value, expected_type, message) {
              actual_type = typeof value
              passed = actual_type == expected_type
              assertion_results.push({
                type: "assert_type",
                value: value,
                expected_type: expected_type,
                actual_type: actual_type,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected type " + expected_type + " but got " + actual_type)
              }
            },
            
            assert_throws: function(fn, expected_error, message) {
              try {
                fn()
                passed = false
              } catch error {
                passed = error.message.includes(expected_error)
              }
              
              assertion_results.push({
                type: "assert_throws",
                expected_error: expected_error,
                message: message,
                passed: passed
              })
              
              if not passed {
                throw "Assertion failed: " + (message || "Expected function to throw error containing '" + expected_error + "'")
              }
            },
            
            assert_contains: function(container, item, message) {
              passed = container.includes(item)
              assertion_results.push({
                type: "assert_contains",
                container: container,
                item: item,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected " + container + " to contain " + item)
              }
            },
            
            assert_length: function(array, expected_length, message) {
              actual_length = array.length
              passed = actual_length == expected_length
              assertion_results.push({
                type: "assert_length",
                array: array,
                expected_length: expected_length,
                actual_length: actual_length,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected length " + expected_length + " but got " + actual_length)
              }
            },
            
            assert_greater_than: function(actual, expected, message) {
              passed = actual > expected
              assertion_results.push({
                type: "assert_greater_than",
                actual: actual,
                expected: expected,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected " + actual + " to be greater than " + expected)
              }
            },
            
            assert_less_than: function(actual, expected, message) {
              passed = actual < expected
              assertion_results.push({
                type: "assert_less_than",
                actual: actual,
                expected: expected,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected " + actual + " to be less than " + expected)
              }
            },
            
            assert_approximately: function(actual, expected, tolerance, message) {
              difference = Math.abs(actual - expected)
              passed = difference <= tolerance
              assertion_results.push({
                type: "assert_approximately",
                actual: actual,
                expected: expected,
                tolerance: tolerance,
                difference: difference,
                message: message,
                passed: passed
              })
              if not passed {
                throw "Assertion failed: " + (message || "Expected " + actual + " to be approximately " + expected + " (±" + tolerance + ")")
              }
            }
          }
        }
      }
    }
  }

  recipe "generate_test_report" {
    needs: test_results
    gives: test_report
    
    brain {
      plan {
        plan = { action: "create_test_report" }
      }
      
      execute {
        if plan.action == "create_test_report" {
          test_report = {
            summary: {
              total_tests: test_results.total_tests,
              passed_tests: test_results.passed_tests,
              failed_tests: test_results.failed_tests,
              skipped_tests: test_results.skipped_tests,
              success_rate: (test_results.passed_tests / test_results.total_tests) * 100,
              total_duration: test_results.total_duration
            },
            suites: test_results.test_suites,
            errors: test_results.errors,
            timestamp: get_timestamp(),
            coverage: null
          }
        }
      }
    }
  }

  recipe "analyze_test_coverage" {
    needs: test_results
    gives: coverage_data
    
    brain {
      plan {
        plan = { action: "calculate_coverage" }
      }
      
      execute {
        if plan.action == "calculate_coverage" {
          coverage_data = {
            overall_coverage: 0,
            line_coverage: {},
            function_coverage: {},
            branch_coverage: {},
            uncovered_lines: []
          }
          
          // Calculate coverage for each test suite
          total_lines = 0
          covered_lines = 0
          
          for each suite_name in Object.keys(test_results.test_suites) {
            suite = test_results.test_suites[suite_name]
            
            // Analyze coverage for this suite
            suite_coverage = analyze_suite_coverage(suite)
            
            coverage_data.line_coverage[suite_name] = suite_coverage.line_coverage
            coverage_data.function_coverage[suite_name] = suite_coverage.function_coverage
            coverage_data.branch_coverage[suite_name] = suite_coverage.branch_coverage
            
            total_lines += suite_coverage.total_lines
            covered_lines += suite_coverage.covered_lines
          }
          
          // Calculate overall coverage
          if total_lines > 0 {
            coverage_data.overall_coverage = (covered_lines / total_lines) * 100
          }
          
          // Find uncovered lines
          coverage_data.uncovered_lines = find_uncovered_lines(coverage_data.line_coverage)
        }
      }
    }
  }

  recipe "update_test_metrics" {
    brain {
      plan {
        plan = { action: "calculate_test_metrics" }
      }
      
      execute {
        if plan.action == "calculate_test_metrics" {
          if memory.test_metrics.total_tests > 0 {
            memory.test_metrics.average_duration = memory.test_metrics.total_duration / memory.test_metrics.total_tests
          }
          
          memory.test_metrics.success_rate = (memory.test_metrics.passed_tests / memory.test_metrics.total_tests) * 100
        }
      }
    }
  }
} 