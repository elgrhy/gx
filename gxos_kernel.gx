helper "gxos_kernel" {
  can_do: ["process_management", "memory_management", "device_management", "system_calls", "scheduling"]
  
  remember {
    system_config = {
      kernel_version: "1.0.0",
      architecture: detect_architecture(),
      memory_size: get_total_memory(),
      cpu_count: get_cpu_count(),
      boot_time: get_timestamp()
    }
    process_table = {}
    memory_map = {
      kernel_space: { start: 0x0, end: 0x1000000, size: 0x1000000 },
      user_space: { start: 0x1000000, end: 0x7fffffff, size: 0x7effffff },
      device_space: { start: 0x80000000, end: 0xffffffff, size: 0x7fffffff }
    }
    device_drivers = {}
    system_calls = {
      // Process management
      SYS_FORK: 1,
      SYS_EXEC: 2,
      SYS_EXIT: 3,
      SYS_WAIT: 4,
      SYS_KILL: 5,
      
      // Memory management
      SYS_BRK: 6,
      SYS_MMAP: 7,
      SYS_MUNMAP: 8,
      
      // File system
      SYS_OPEN: 9,
      SYS_READ: 10,
      SYS_WRITE: 11,
      SYS_CLOSE: 12,
      SYS_LSEEK: 13,
      
      // Device management
      SYS_IOCTL: 14,
      SYS_DEVICE_OPEN: 15,
      SYS_DEVICE_CLOSE: 16,
      
      // Network
      SYS_SOCKET: 17,
      SYS_BIND: 18,
      SYS_CONNECT: 19,
      SYS_LISTEN: 20,
      SYS_ACCEPT: 21,
      
      // System information
      SYS_GETPID: 22,
      SYS_GETTIME: 23,
      SYS_GETMEMORY: 24
    }
    scheduler = {
      current_process: null,
      ready_queue: [],
      blocked_queue: [],
      time_slice: 100, // milliseconds
      quantum: 10
    }
  }

  receive {
    from "hardware" as "interrupt" {
      type: "hardware_interrupt"
      bind: memory.hardware_interrupt
      on_receive: brain.handle_interrupt
    }
    
    from "process" as "system_call" {
      type: "system_call_request"
      bind: memory.system_call
      on_receive: brain.handle_system_call
    }
    
    from "device" as "device_request" {
      type: "device_operation"
      bind: memory.device_request
      on_receive: brain.handle_device_request
    }
  }

  brain {
    plan {
      if memory.hardware_interrupt {
        plan = {
          action: "handle_hardware_interrupt",
          interrupt: memory.hardware_interrupt
        }
      } else if memory.system_call {
        plan = {
          action: "process_system_call",
          call: memory.system_call
        }
      } else if memory.device_request {
        plan = {
          action: "handle_device_request",
          request: memory.device_request
        }
      } else {
        plan = {
          action: "run_scheduler",
          interval: "continuous"
        }
      }
    }
    
    execute {
      if plan.action == "handle_hardware_interrupt" {
        handle_hardware_interrupt(plan.interrupt)
      } else if plan.action == "process_system_call" {
        result = process_system_call(plan.call)
        return_result_to_process(plan.call.process_id, result)
      } else if plan.action == "handle_device_request" {
        handle_device_request(plan.request)
      } else if plan.action == "run_scheduler" {
        run_process_scheduler()
      }
    }
    
    remember {
      memory.system_stats = {
        processes_running: Object.keys(memory.process_table).length,
        memory_used: calculate_memory_usage(),
        uptime: get_timestamp() - memory.system_config.boot_time
      }
    }
    
    communicate {
      if memory.system_stats.processes_running > 0 {
        broadcast "system_status" {
          processes: memory.system_stats.processes_running,
          memory: memory.system_stats.memory_used,
          uptime: memory.system_stats.uptime
        }
      }
    }
  }

  recipe "handle_hardware_interrupt" {
    needs: interrupt
    gives: handled
    
    brain {
      plan {
        plan = {
          action: "process_interrupt",
          interrupt: interrupt
        }
      }
      
      execute {
        if interrupt.type == "timer" {
          // Timer interrupt - trigger scheduler
          trigger_scheduler()
        } else if interrupt.type == "keyboard" {
          // Keyboard interrupt
          handle_keyboard_input(interrupt.data)
        } else if interrupt.type == "disk" {
          // Disk interrupt
          handle_disk_interrupt(interrupt.data)
        } else if interrupt.type == "network" {
          // Network interrupt
          handle_network_interrupt(interrupt.data)
        } else if interrupt.type == "device" {
          // Device interrupt
          handle_device_interrupt(interrupt.data)
        }
        
        handled = true
      }
    }
  }

  recipe "process_system_call" {
    needs: system_call
    gives: result
    
    brain {
      plan {
        plan = {
          action: "execute_system_call",
          call: system_call
        }
      }
      
      execute {
        call_number = system_call.number
        parameters = system_call.parameters
        process_id = system_call.process_id
        
        if call_number == memory.system_calls.SYS_FORK {
          result = sys_fork(process_id)
        } else if call_number == memory.system_calls.SYS_EXEC {
          result = sys_exec(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_EXIT {
          result = sys_exit(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_WAIT {
          result = sys_wait(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_KILL {
          result = sys_kill(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_BRK {
          result = sys_brk(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_MMAP {
          result = sys_mmap(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_MUNMAP {
          result = sys_munmap(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_OPEN {
          result = sys_open(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_READ {
          result = sys_read(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_WRITE {
          result = sys_write(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_CLOSE {
          result = sys_close(process_id, parameters)
        } else if call_number == memory.system_calls.SYS_GETPID {
          result = sys_getpid(process_id)
        } else if call_number == memory.system_calls.SYS_GETTIME {
          result = sys_gettime()
        } else if call_number == memory.system_calls.SYS_GETMEMORY {
          result = sys_getmemory(process_id)
        } else {
          result = { error: "Unknown system call", code: -1 }
        }
      }
    }
  }

  recipe "sys_fork" {
    needs: parent_pid
    gives: child_pid
    
    brain {
      plan {
        plan = {
          action: "create_child_process",
          parent: parent_pid
        }
      }
      
      execute {
        // Create new process by copying parent
        parent_process = memory.process_table[parent_pid]
        
        child_pid = generate_process_id()
        child_process = {
          pid: child_pid,
          parent_pid: parent_pid,
          state: "ready",
          memory_space: copy_memory_space(parent_process.memory_space),
          registers: copy_registers(parent_process.registers),
          file_descriptors: copy_file_descriptors(parent_process.file_descriptors),
          priority: parent_process.priority,
          created_at: get_timestamp()
        }
        
        memory.process_table[child_pid] = child_process
        memory.scheduler.ready_queue.push(child_pid)
        
        // Return child PID to parent, 0 to child
        if get_current_process_id() == parent_pid {
          child_pid = child_pid
        } else {
          child_pid = 0
        }
      }
    }
  }

  recipe "sys_exec" {
    needs: process_id, parameters
    gives: result
    
    brain {
      plan {
        plan = {
          action: "execute_program",
          process: process_id,
          params: parameters
        }
      }
      
      execute {
        filename = parameters.filename
        args = parameters.args
        
        // Load program from file system
        program_data = load_program_from_file(filename)
        
        if program_data {
          // Replace process memory with new program
          memory.process_table[process_id].memory_space = allocate_memory_for_program(program_data)
          memory.process_table[process_id].entry_point = program_data.entry_point
          
          // Set up command line arguments
          setup_command_line_args(process_id, args)
          
          result = { success: true, pid: process_id }
        } else {
          result = { error: "Program not found", code: -1 }
        }
      }
    }
  }

  recipe "sys_exit" {
    needs: process_id, parameters
    gives: result
    
    brain {
      plan {
        plan = {
          action: "terminate_process",
          process: process_id,
          exit_code: parameters.exit_code
        }
      }
      
      execute {
        // Clean up process resources
        cleanup_process_memory(process_id)
        cleanup_process_files(process_id)
        
        // Remove from process table
        delete memory.process_table[process_id]
        
        // Remove from scheduler queues
        remove_from_scheduler_queues(process_id)
        
        // Notify parent process if waiting
        notify_parent_process(process_id, parameters.exit_code)
        
        result = { success: true }
      }
    }
  }

  recipe "sys_brk" {
    needs: process_id, parameters
    gives: result
    
    brain {
      plan {
        plan = {
          action: "adjust_heap",
          process: process_id,
          new_break: parameters.new_break
        }
      }
      
      execute {
        process = memory.process_table[process_id]
        
        if parameters.new_break {
          // Set new break point
          if validate_memory_address(process_id, parameters.new_break) {
            process.heap_break = parameters.new_break
            result = { success: true, break: parameters.new_break }
          } else {
            result = { error: "Invalid memory address", code: -1 }
          }
        } else {
          // Return current break point
          result = { success: true, break: process.heap_break }
        }
      }
    }
  }

  recipe "sys_mmap" {
    needs: process_id, parameters
    gives: result
    
    brain {
      plan {
        plan = {
          action: "map_memory",
          process: process_id,
          params: parameters
        }
      }
      
      execute {
        address = parameters.address
        length = parameters.length
        prot = parameters.prot || "rw"
        flags = parameters.flags || "private"
        
        // Allocate memory mapping
        mapping = allocate_memory_mapping(process_id, address, length, prot, flags)
        
        if mapping {
          result = { success: true, address: mapping.address }
        } else {
          result = { error: "Memory mapping failed", code: -1 }
        }
      }
    }
  }

  recipe "run_process_scheduler" {
    needs: void
    gives: scheduled_process
    
    brain {
      plan {
        plan = {
          action: "schedule_next_process",
          algorithm: "round_robin"
        }
      }
      
      execute {
        if memory.scheduler.current_process {
          // Check if current process should yield
          if should_yield_cpu(memory.scheduler.current_process) {
            // Move current process to ready queue
            memory.scheduler.ready_queue.push(memory.scheduler.current_process)
            memory.scheduler.current_process = null
          }
        }
        
        // Select next process from ready queue
        if memory.scheduler.ready_queue.length > 0 {
          next_process = memory.scheduler.ready_queue.shift()
          memory.scheduler.current_process = next_process
          
          // Set process state to running
          memory.process_table[next_process].state = "running"
          memory.process_table[next_process].last_scheduled = get_timestamp()
          
          // Switch context to new process
          switch_to_process(next_process)
          
          scheduled_process = next_process
        } else {
          scheduled_process = null
        }
      }
    }
  }

  recipe "handle_device_request" {
    needs: device_request
    gives: result
    
    brain {
      plan {
        plan = {
          action: "process_device_request",
          request: device_request
        }
      }
      
      execute {
        device_id = device_request.device_id
        operation = device_request.operation
        data = device_request.data
        
        if memory.device_drivers[device_id] {
          driver = memory.device_drivers[device_id]
          result = driver.handle_operation(operation, data)
        } else {
          result = { error: "Device driver not found", code: -1 }
        }
      }
    }
  }

  recipe "allocate_memory_mapping" {
    needs: process_id, address, length, prot, flags
    gives: mapping
    
    brain {
      plan {
        plan = {
          action: "create_memory_mapping",
          process: process_id,
          address: address,
          length: length
        }
      }
      
      execute {
        process = memory.process_table[process_id]
        
        // Find available address range
        if address == 0 {
          address = find_available_address_range(process_id, length)
        }
        
        if address && validate_memory_range(process_id, address, length) {
          mapping = {
            address: address,
            length: length,
            protection: prot,
            flags: flags,
            created_at: get_timestamp()
          }
          
          // Add to process memory map
          if !process.memory_mappings {
            process.memory_mappings = []
          }
          process.memory_mappings.push(mapping)
          
          // Allocate physical memory
          allocate_physical_memory(address, length)
        } else {
          mapping = null
        }
      }
    }
  }

  recipe "switch_to_process" {
    needs: process_id
    gives: switched
    
    brain {
      plan {
        plan = {
          action: "context_switch",
          process: process_id
        }
      }
      
      execute {
        // Save current context
        if memory.scheduler.current_process {
          save_process_context(memory.scheduler.current_process)
        }
        
        // Load new process context
        load_process_context(process_id)
        
        // Update scheduler state
        memory.scheduler.current_process = process_id
        
        switched = true
      }
    }
  }

  objective "maintain_system_stability" {
    when memory.system_stats.processes_running > 1000
    then {
      action: "limit_process_creation",
      target: "system_protection"
    }
  }

  objective "optimize_memory_usage" {
    when memory.system_stats.memory_used > memory.system_config.memory_size * 0.8
    then {
      action: "trigger_memory_cleanup",
      target: "memory_optimization"
    }
  }

  message "system_crash" {
    do {
      log("System crash detected: " + memory.crash_reason)
      broadcast "system_crash" {
        reason: memory.crash_reason,
        timestamp: get_timestamp(),
        process_id: memory.crashed_process
      }
    }
  }
} 