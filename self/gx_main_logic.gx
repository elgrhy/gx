// GX self-interpreter entry point logic (no imports, no agent)
// Used by jsc_bootstrap.gx to generate the JS bootstrap entry point.

function gx_main() {
  target_file = __builtin_env("GX_FILE")
  if target_file == null {
    target_file = "self/test_self.gx"
  }
  if not file_exists(target_file) {
    log("Error: file not found: " + target_file)
  } else {
    src = read_file(target_file)
    tokens = tokenize(src)
    ast = parse(tokens)
    eval_program(ast)
  }
}

