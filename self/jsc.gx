// GX → JavaScript compiler entry point
// Usage: GX_FILE=hello.gx gx run self/jsc.gx
//   Prints the compiled JavaScript to stdout (use shell redirect to save it)

import "self/lexer.gx"
import "self/parser.gx"
import "self/js_codegen.gx"

agent "gx_jsc" {
  when started {
    target_file = env("GX_FILE")
    if target_file == null {
      target_file = "self/test_self.gx"
    }

    if not file_exists(target_file) {
      log("Error: file not found: " + target_file)
    } else {
      src = read_file(target_file)
      tokens = tokenize(src)
      ast = parse(tokens)
      js_body = codegen_program(ast)
      runtime = read_file("self/gx_runtime.js")
      log(runtime + "\n" + js_body)
    }
  }
}
