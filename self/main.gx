// GX Self-Hosted Interpreter
// Usage: GX_FILE=target.gx gx run self/main.gx
//
// Reads, lexes, parses, and evaluates a .gx file using the GX self-hosted pipeline.

import "self/lexer.gx"
import "self/parser.gx"
import "self/eval.gx"

agent "gx_self" {
  when started {
    target_file = env("GX_FILE")
    if target_file == null {
      target_file = "self/test_self.gx"
    }

    if not file_exists(target_file) {
      log("Error: file not found: " + target_file)
    } else {
      src = read_file(target_file)
      tokens = tokenize(src)
      ast = parse(tokens)
      eval_program(ast)
    }
  }
}
