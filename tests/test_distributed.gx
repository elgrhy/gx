helper "distributed_tester" {
  can_do: ["distributed_computation", "mesh_communication", "knowledge_sharing"]
  
  remember {
    test_results = []
    mesh_nodes = []
    messages_sent = 0
    messages_received = 0
    knowledge_shared = 0
  }

  brain {
    plan {
      if memory.mesh_nodes.length == 0 {
        plan = { action: "setup_mesh_network" }
      } else if memory.messages_sent == 0 {
        plan = { action: "test_mesh_communication" }
      } else if memory.knowledge_shared == 0 {
        plan = { action: "test_knowledge_sharing" }
      } else {
        plan = { action: "test_distributed_computation" }
      }
    }
    
    execute {
      if plan.action == "setup_mesh_network" {
        // Setup mesh network
        node1 = create_mesh_node("node1", "192.168.1.10")
        node2 = create_mesh_node("node2", "192.168.1.11")
        node3 = create_mesh_node("node3", "192.168.1.12")
        
        memory.mesh_nodes = [node1, node2, node3]
        
        // Connect nodes
        connect_mesh_nodes(node1, node2)
        connect_mesh_nodes(node2, node3)
        connect_mesh_nodes(node1, node3)
        
        memory.test_results.push("mesh_network_setup_success")
      } else if plan.action == "test_mesh_communication" {
        // Test mesh communication
        message = {
          type: "test_message",
          content: "Hello from distributed tester",
          timestamp: get_timestamp()
        }
        
        for each node in memory.mesh_nodes {
          send_mesh_message(node, message)
          memory.messages_sent += 1
        }
        
        memory.test_results.push("mesh_communication_success")
      } else if plan.action == "test_knowledge_sharing" {
        // Test knowledge sharing
        knowledge = {
          patterns: ["pattern1", "pattern2"],
          insights: ["insight1"],
          timestamp: get_timestamp()
        }
        
        share_knowledge_across_mesh(knowledge)
        memory.knowledge_shared += 1
        
        memory.test_results.push("knowledge_sharing_success")
      } else if plan.action == "test_distributed_computation" {
        // Test distributed computation
        computation_task = {
          type: "distributed_processing",
          data: [1, 2, 3, 4, 5],
          operation: "sum"
        }
        
        result = execute_distributed_computation(computation_task)
        
        if result && result.value == 15 {
          memory.test_results.push("distributed_computation_success")
        } else {
          memory.test_results.push("distributed_computation_failed")
        }
      }
    }
    
    remember {
      memory.last_test_time = get_timestamp()
    }
    
    communicate {
      if memory.test_results.length >= 4 {
        broadcast "distributed_testing_complete" {
          mesh_nodes: memory.mesh_nodes.length,
          messages_sent: memory.messages_sent,
          knowledge_shared: memory.knowledge_shared,
          test_results: memory.test_results
        }
      }
    }
  }
} 