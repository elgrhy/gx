helper "helper_tester" {
  can_do: ["testing", "helper_validation", "lifecycle_testing"]
  
  remember {
    test_results = []
    helper_count = 0
    created_helpers = []
    test_phase = "initialization"
  }

  brain {
    plan {
      if memory.test_phase == "initialization" {
        plan = { action: "test_helper_creation" }
      } else if memory.test_phase == "capabilities" {
        plan = { action: "test_helper_capabilities" }
      } else if memory.test_phase == "lifecycle" {
        plan = { action: "test_helper_lifecycle" }
      } else if memory.test_phase == "communication" {
        plan = { action: "test_helper_communication" }
      }
    }
    
    execute {
      if plan.action == "test_helper_creation" {
        // Test helper creation
        test_helper = create_test_helper("test_helper_1")
        if test_helper {
          memory.created_helpers.push(test_helper)
          memory.helper_count += 1
          memory.test_results.push("helper_creation_success")
        } else {
          memory.test_results.push("helper_creation_failed")
        }
        memory.test_phase = "capabilities"
      } else if plan.action == "test_helper_capabilities" {
        // Test helper capabilities
        for each helper in memory.created_helpers {
          capabilities = get_helper_capabilities(helper)
          if capabilities && capabilities.length > 0 {
            memory.test_results.push("capabilities_valid")
          } else {
            memory.test_results.push("capabilities_invalid")
          }
        }
        memory.test_phase = "lifecycle"
      } else if plan.action == "test_helper_lifecycle" {
        // Test helper lifecycle
        for each helper in memory.created_helpers {
          status = get_helper_status(helper)
          if status == "active" {
            memory.test_results.push("lifecycle_active")
          } else {
            memory.test_results.push("lifecycle_inactive")
          }
        }
        memory.test_phase = "communication"
      } else if plan.action == "test_helper_communication" {
        // Test helper communication
        for each helper in memory.created_helpers {
          message_sent = send_message_to_helper(helper, "test_message")
          if message_sent {
            memory.test_results.push("communication_success")
          } else {
            memory.test_results.push("communication_failed")
          }
        }
        memory.test_phase = "complete"
      }
    }
    
    remember {
      memory.last_test_time = get_timestamp()
    }
    
    communicate {
      if memory.test_phase == "complete" {
        broadcast "helper_testing_complete" {
          helper_count: memory.helper_count,
          test_results: memory.test_results
        }
      }
    }
  }

  recipe "create_test_helper" {
    needs: helper_name
    gives: helper
    
    brain {
      plan {
        plan = { action: "create_helper" }
      }
      
      execute {
        if plan.action == "create_helper" {
          helper = {
            name: helper_name,
            capabilities: ["testing", "validation"],
            status: "active",
            created_at: get_timestamp()
          }
        }
      }
    }
  }

  recipe "get_helper_capabilities" {
    needs: helper
    gives: capabilities
    
    brain {
      plan {
        plan = { action: "extract_capabilities" }
      }
      
      execute {
        if plan.action == "extract_capabilities" {
          capabilities = helper.capabilities || []
        }
      }
    }
  }

  recipe "get_helper_status" {
    needs: helper
    gives: status
    
    brain {
      plan {
        plan = { action: "check_status" }
      }
      
      execute {
        if plan.action == "check_status" {
          status = helper.status || "unknown"
        }
      }
    }
  }

  recipe "send_message_to_helper" {
    needs: helper, message
    gives: success
    
    brain {
      plan {
        plan = { action: "send_message" }
      }
      
      execute {
        if plan.action == "send_message" {
          if helper && helper.status == "active" {
            success = true
          } else {
            success = false
          }
        }
      }
    }
  }

  objective "validate_helper_testing" {
    when memory.helper_count >= 3
    then {
      action: "complete_helper_validation",
      helpers_tested: memory.helper_count
    }
  }

  message "helper_test_complete" {
    do {
      log("Helper testing completed successfully")
      log("Helpers created: " + memory.helper_count)
      log("Test results: " + memory.test_results)
    }
  }
} 