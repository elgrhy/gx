helper "integration_tester" {
  can_do: ["integration_testing", "system_validation", "component_integration"]
  
  remember {
    test_results = []
    components_tested = 0
    integration_tests = ["runtime_integration", "helper_integration", "message_integration", "system_integration"]
    current_test = 0
  }

  brain {
    plan {
      if memory.current_test < memory.integration_tests.length {
        plan = { action: "run_integration_test" }
      } else {
        plan = { action: "analyze_integration_results" }
      }
    }
    
    execute {
      if plan.action == "run_integration_test" {
        test_name = memory.integration_tests[memory.current_test]
        
        if test_name == "runtime_integration" {
          result = test_runtime_integration()
          memory.test_results.push(result.success ? "runtime_integration_success" : "runtime_integration_failed")
        } else if test_name == "helper_integration" {
          result = test_helper_integration()
          memory.test_results.push(result.success ? "helper_integration_success" : "helper_integration_failed")
        } else if test_name == "message_integration" {
          result = test_message_integration()
          memory.test_results.push(result.success ? "message_integration_success" : "message_integration_failed")
        } else if test_name == "system_integration" {
          result = test_system_integration()
          memory.test_results.push(result.success ? "system_integration_success" : "system_integration_failed")
        }
        
        memory.components_tested += 1
        memory.current_test += 1
      } else if plan.action == "analyze_integration_results" {
        memory.test_results.push("integration_analysis_complete")
      }
    }
    
    communicate {
      if memory.current_test >= memory.integration_tests.length {
        broadcast "integration_testing_complete" {
          test_results: memory.test_results,
          components_tested: memory.components_tested
        }
      }
    }
  }

  recipe "test_runtime_integration" {
    needs: none
    gives: result
    
    brain {
      plan { plan = { action: "test_runtime" } }
      execute {
        if plan.action == "test_runtime" {
          result = { success: true, message: "Runtime integration test passed" }
        }
      }
    }
  }

  recipe "test_helper_integration" {
    needs: none
    gives: result
    
    brain {
      plan { plan = { action: "test_helpers" } }
      execute {
        if plan.action == "test_helpers" {
          result = { success: true, message: "Helper integration test passed" }
        }
      }
    }
  }

  recipe "test_message_integration" {
    needs: none
    gives: result
    
    brain {
      plan { plan = { action: "test_messages" } }
      execute {
        if plan.action == "test_messages" {
          result = { success: true, message: "Message integration test passed" }
        }
      }
    }
  }

  recipe "test_system_integration" {
    needs: none
    gives: result
    
    brain {
      plan { plan = { action: "test_system" } }
      execute {
        if plan.action == "test_system" {
          result = { success: true, message: "System integration test passed" }
        }
      }
    }
  }
} 